<%- include('partials/head') %>

<%# جميع البيانات تُجلب من /api/dashboard وتُحقن لاحقاً بواسطة السكربت في أسفل الصفحة. %>

<div class="ops-root">

  <!-- ============ TOP STATUS BAR ============ -->
  <header class="ops-topbar">
    <div class="ops-tb-left">
      <span class="ops-live">
        <span class="ops-live-dot"></span>
        <span class="ops-live-text">مباشر</span>
      </span>
      <span class="ops-divider"></span>
      <span class="ops-sync">
        <svg viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M12 4V1L8 5l4 4V6c3.3 0 6 2.7 6 6 0 1-.3 2-.7 2.8l1.5 1.5C19.5 15 20 13.6 20 12c0-4.4-3.6-8-8-8zm0 14c-3.3 0-6-2.7-6-6 0-1 .3-2 .7-2.8L5.2 7.7C4.5 9 4 10.4 4 12c0 4.4 3.6 8 8 8v3l4-4-4-4v3z"/></svg>
        مزامنة:
        <b id="opsSyncAgo">قبل ٨ ث</b>
      </span>
    </div>

    <div class="ops-tb-center">
      <div class="ops-brand">
        <span class="ops-brand-mark">◉</span>
        <span class="ops-brand-name">نظام نقاط الأثر</span>
        <span class="ops-brand-tag">غرفة المتابعة</span>
      </div>
    </div>

    <div class="ops-tb-right">
      <span class="ops-greg" id="opsGreg">— / — / ——</span>
      <span class="ops-divider"></span>
      <span class="ops-clock">
        <svg viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 18a8 8 0 110-16 8 8 0 010 16zm.5-13H11v6l5 3 .8-1.3-4.3-2.5V7z"/></svg>
        <b id="opsClock">--:--:--</b>
      </span>
    </div>
  </header>

  <!-- ============ MAIN BENTO GRID ============ -->
  <main class="ops-bento">

    <!-- ────── LEFT BENTO COLUMN ────── -->
    <section class="ops-tile ops-amb" aria-label="السفراء">
      <div class="ops-tile-corner">A·01</div>
      <div class="ops-tile-head">
        <span class="ops-tile-icon">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-4.4 0-8 2.2-8 5v3h16v-3c0-2.8-3.6-5-8-5z"/></svg>
        </span>
        <span class="ops-tile-label">السفراء</span>
        <span class="ops-tile-trend up" id="dashAmbDelta">▲ 0</span>
      </div>
      <div class="ops-tile-value" id="dashAmbTotal" data-num="0">0</div>
      <div class="ops-mini-bars">
        <div class="ops-mini-bar">
          <span class="lbl">منسوبون</span>
          <span class="bar"><i id="dashAmbMembersBar" style="--w:0%"></i></span>
          <span class="val" id="dashAmbMembersVal">0</span>
        </div>
        <div class="ops-mini-bar">
          <span class="lbl">خارج الجمعية</span>
          <span class="bar"><i id="dashAmbExternalBar" style="--w:0%"></i></span>
          <span class="val" id="dashAmbExternalVal">0</span>
        </div>
      </div>
      <svg class="ops-sparkline" viewBox="0 0 120 30" preserveAspectRatio="none" aria-hidden="true">
        <polyline points="0,22 12,18 24,20 36,14 48,15 60,10 72,12 84,8 96,9 108,5 120,6"
                  fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </section>

    <section class="ops-tile ops-funds" aria-label="الصناديق">
      <div class="ops-tile-corner">F·02</div>
      <div class="ops-tile-head">
        <span class="ops-tile-icon">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 8h-3V6a2 2 0 00-2-2H9a2 2 0 00-2 2v2H4a1 1 0 00-1 1v9a3 3 0 003 3h12a3 3 0 003-3V9a1 1 0 00-1-1zM9 6h6v2H9V6z"/></svg>
        </span>
        <span class="ops-tile-label">الصناديق</span>
        <span class="ops-tile-trend up" id="dashFundsTrend">▲ 0</span>
      </div>
      <div class="ops-tile-value" id="dashFundsTotal" data-num="0">0</div>
      <div class="ops-tile-row">
        <div class="ops-pill ops-pill-live">
          <span class="ops-pill-dot"></span>
          نشطة <b id="dashFundsActive">0</b>
        </div>
        <div class="ops-pill">
          ✓ مكتملة <b id="dashFundsCompleted">0</b>
        </div>
      </div>
      <div class="ops-stack-bar" id="dashFundsStack" title="">
        <span class="seg seg-a" id="dashFundsActiveBar" style="--w:0%"></span>
        <span class="seg seg-b" id="dashFundsCompletedBar" style="--w:0%"></span>
      </div>
      <div class="ops-tile-foot">
        <span>الهدف <b id="dashFundsGoal">0</b></span>
        <b id="dashFundsPct">0%</b>
      </div>
    </section>

    <!-- ROTATING PANEL — Top Entities (مجمعات / دور) — صفحاته تُبنى ديناميكياً -->
    <section class="ops-tile ops-rotate ops-leaderboard" data-rotor="topEntities" aria-label="أفضل المجمعات والدور">
      <div class="ops-tile-corner">T·03</div>
      <div class="ops-tile-head ops-rotate-head">
        <span class="ops-tile-icon gold">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
        </span>
        <div class="ops-rotate-titles">
          <span class="ops-tile-label">أفضل المجمعات والدور</span>
          <span class="ops-rotate-sub" data-rotate-sub>—</span>
        </div>
        <div class="ops-rotate-dots" data-rotate-dots></div>
      </div>
      <div class="ops-rotate-stage ops-lb-stage" data-stage></div>
    </section>

    <!-- ────── CENTRAL HUB ────── -->
    <section class="ops-hub" aria-label="حملة ذو الحجة">
      <div class="ops-hub-corner">C·00</div>
      <div class="ops-hub-grid-bg" aria-hidden="true"></div>
      <div class="ops-hub-rings" aria-hidden="true">
        <span class="ring r1"></span>
        <span class="ring r2"></span>
        <span class="ring r3"></span>
      </div>

      <div class="ops-hub-orbit" aria-hidden="true">
        <svg viewBox="0 0 320 320">
          <defs>
            <linearGradient id="ringHubGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fbd76b"/>
              <stop offset=".55" stop-color="#b29079"/>
              <stop offset="1" stop-color="#6f4f3a"/>
            </linearGradient>
            <linearGradient id="trackGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="rgba(245,240,232,.08)"/>
              <stop offset="1" stop-color="rgba(245,240,232,.02)"/>
            </linearGradient>
          </defs>
          <circle cx="160" cy="160" r="148" fill="none" stroke="url(#trackGrad)" stroke-width="1.4" stroke-dasharray="2 4"/>
          <circle cx="160" cy="160" r="126" fill="none" stroke="rgba(245,240,232,.08)" stroke-width="1"/>
          <circle id="dashHubProgressRing" class="ops-progress-ring" cx="160" cy="160" r="126" fill="none"
                  stroke="url(#ringHubGrad)" stroke-width="3.6" stroke-linecap="round"
                  stroke-dasharray="791.68" stroke-dashoffset="791.68"
                  transform="rotate(-90 160 160)"/>
        </svg>
      </div>

      <div class="ops-hub-content">
        <div class="ops-hub-logo-wrap" aria-label="شعار نقاط الأثر">
          <img class="ops-hub-logo" src="/img/logo.png" alt="نقاط الأثر">
        </div>

        <div class="ops-hub-kicker">
          <span class="ops-hub-kicker-dot"></span>
          الحملة الحالية
        </div>

        <h1 class="ops-hub-title">
          <span class="ops-hub-crescent" aria-hidden="true">
            <svg viewBox="0 0 32 32"><path fill="currentColor" d="M22 4a12 12 0 100 24 10 10 0 010-24z"/></svg>
          </span>
          حملة ذو الحجة
        </h1>

        <div class="ops-hub-hijri" id="opsHijri">
          <span class="hd" id="opsHijriDay">١٠</span>
          <span class="hm" id="opsHijriMonth">ذو الحجة</span>
          <span class="hy" id="opsHijriYear">١٤٤٧ هـ</span>
        </div>

        <div class="ops-hub-progress-text">
          <span><b id="dashHubCurrentAmount">0</b> <small>من</small> <b id="dashHubGoalAmount">0</b> <small>ر.س</small></span>
          <b id="dashHubPct">0%</b>
        </div>

        <div class="ops-hub-update">
          <span class="ops-hub-update-dot"></span>
          <span class="ops-hub-update-label">آخر تحديث للبيانات</span>
          <b id="opsLastSyncBig">قبل ٨ ثوانٍ</b>
        </div>
      </div>

      <div class="ops-hub-ticker" aria-label="آخر الأنشطة">
        <div class="ops-hub-ticker-tag">● بث مباشر</div>
        <div class="ops-hub-ticker-track">
          <div class="ops-hub-ticker-loop" id="dashTickerLoop">
            <span class="tk-item">في انتظار البيانات…</span><span class="tk-sep">◆</span>
            <span class="tk-item">في انتظار البيانات…</span><span class="tk-sep">◆</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ────── RIGHT BENTO COLUMN ────── -->
    <section class="ops-tile ops-total" aria-label="إجمالي التبرعات">
      <div class="ops-tile-corner">D·04</div>
      <div class="ops-tile-head">
        <span class="ops-tile-icon">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
        </span>
        <span class="ops-tile-label">إجمالي التبرعات</span>
        <span class="ops-tile-trend up" id="dashTotalTrend">▲ 0٪</span>
      </div>
      <div class="ops-tile-value big">
        <span id="dashTotalAmount" data-num="0">0</span>
        <small>ر.س</small>
      </div>
      <div class="ops-tile-foot">
        <span>الهدف <b id="dashTotalGoal">0</b></span>
        <b id="dashTotalPct">0%</b>
      </div>
      <div class="ops-bar"><span id="dashTotalBar" style="--w:0%"></span></div>
      <div class="ops-tile-row tight">
        <div class="ops-pill ops-pill-soft">
          + <b id="dashTotalToday">0</b> اليوم
        </div>
        <div class="ops-pill ops-pill-soft">
          <span class="ops-pill-dot ok"></span>
          فعّال
        </div>
      </div>
    </section>

    <!-- ROTATING PANEL — أفضل ٢٠ سفيراً (مقسّمين على مجموعتين) — يمتد على صفّين -->
    <section class="ops-tile ops-rotate ops-leaderboard ops-leaderboard-tall" data-rotor="topAmbs" aria-label="أفضل ٢٠ سفيراً">
      <div class="ops-tile-corner">T·06</div>
      <div class="ops-tile-head ops-rotate-head">
        <span class="ops-tile-icon gold">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
        </span>
        <div class="ops-rotate-titles">
          <span class="ops-tile-label">أفضل ٢٠ سفيراً</span>
          <span class="ops-rotate-sub" data-rotate-sub>المراكز ١ — ١٠</span>
        </div>
        <div class="ops-rotate-dots" data-rotate-dots>
          <span class="dot active"></span>
          <span class="dot"></span>
        </div>
      </div>

      <div class="ops-rotate-stage ops-lb-stage">
        <!-- slide 1: ranks 1-10 -->
        <div class="ops-rotate-slide active ops-lb-slide" data-rotate-key="g1">
          <ol class="ops-lb-list ops-lb-list-amb" id="dashTopAmbsG1List">
            <li class="ops-lb-empty">لا توجد بيانات بعد…</li>
          </ol>
        </div>
        <!-- slide 2: ranks 11-20 -->
        <div class="ops-rotate-slide ops-lb-slide" data-rotate-key="g2">
          <ol class="ops-lb-list ops-lb-list-amb" id="dashTopAmbsG2List" start="11">
            <li class="ops-lb-empty">لا توجد بيانات بعد…</li>
          </ol>
        </div>
      </div>
    </section>

  </main>
</div>

<!-- ============ STYLES ============ -->
<style>
  /* اجعل هذه الصفحة تأخذ الشاشة كاملة */
  body:has(.ops-root) {
    background:
      radial-gradient(1200px 700px at 20% -10%, rgba(178, 144, 121, .12), transparent 60%),
      radial-gradient(1000px 600px at 110% 110%, rgba(212, 160, 23, .08), transparent 60%),
      linear-gradient(180deg, #15100c 0%, #1a1410 100%);
    overflow: hidden;
  }
  body:has(.ops-root) .container {
    max-width: 1440px;
    padding-inline: 14px;
    padding-block: 10px;
  }
  body:has(.ops-root) .site-footer,
  body:has(.ops-root) .wa-fab { display: none !important; }
  body:has(.ops-root).has-bottom-nav,
  body:has(.ops-root):has(.bottom-nav) { padding-bottom: 0; }

  /* المتغيرات الخاصة بشاشة العمليات */
  .ops-root {
    --o-bg: #15100c;
    --o-panel: linear-gradient(180deg, rgba(38, 28, 22, .92), rgba(28, 21, 16, .94));
    --o-panel-2: linear-gradient(180deg, rgba(46, 34, 26, .85), rgba(34, 25, 19, .9));
    --o-border: rgba(245, 240, 232, .08);
    --o-border-2: rgba(245, 240, 232, .14);
    --o-text: #f5f0e8;
    --o-text-2: rgba(245, 240, 232, .68);
    --o-mute: rgba(245, 240, 232, .42);
    --o-primary: #c89d7e;
    --o-primary-2: #b29079;
    --o-gold: #fbd76b;
    --o-gold-2: #d4a017;
    --o-rose: #e3a1b4;
    --o-ok: #4ade80;
    --o-ok-2: #16a34a;
    --o-danger: #f87171;
    --o-glow-primary: 0 0 22px rgba(200, 157, 126, .35);
    --o-glow-gold: 0 0 22px rgba(251, 215, 107, .35);
    --o-glow-ok: 0 0 18px rgba(74, 222, 128, .35);

    color: var(--o-text);
    font-family: "IBM Plex Sans Arabic", "Segoe UI", "Cairo", sans-serif;
    font-variant-numeric: tabular-nums;
    height: calc(100dvh - 20px);
    min-height: 640px;
    display: grid;
    grid-template-rows: 44px 1fr;
    gap: 10px;
  }

  /* ===================== TOP BAR ===================== */
  .ops-topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 16px;
    border: 1px solid var(--o-border);
    background: var(--o-panel);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 12.5px;
    color: var(--o-text-2);
    position: relative;
    overflow: hidden;
  }
  .ops-topbar::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(251, 215, 107, .45), transparent);
  }
  .ops-tb-left, .ops-tb-right {
    display: flex; align-items: center; gap: 14px;
  }
  .ops-tb-right { justify-content: flex-end; }
  .ops-tb-center { display: flex; justify-content: center; }

  .ops-live { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; color: var(--o-ok); }
  .ops-live-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--o-ok);
    box-shadow: 0 0 0 0 rgba(74, 222, 128, .6);
    animation: opsPulse 1.6s ease-out infinite;
  }
  @keyframes opsPulse {
    0%   { box-shadow: 0 0 0 0 rgba(74, 222, 128, .6); }
    70%  { box-shadow: 0 0 0 12px rgba(74, 222, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }
  .ops-divider {
    width: 1px; height: 16px;
    background: var(--o-border-2);
    display: inline-block;
  }
  .ops-sync { display: inline-flex; align-items: center; gap: 6px; }
  .ops-sync b { color: var(--o-gold); font-weight: 800; }
  .ops-clock { display: inline-flex; align-items: center; gap: 6px; color: var(--o-text); }
  .ops-clock b { color: var(--o-text); font-weight: 800; letter-spacing: .5px; font-size: 14px; }
  .ops-greg { color: var(--o-text-2); font-weight: 600; }
  .ops-brand { display: inline-flex; align-items: center; gap: 10px; }
  .ops-brand-mark { color: var(--o-gold); animation: opsBlink 2s ease-in-out infinite; }
  .ops-brand-name { font-weight: 800; color: var(--o-text); letter-spacing: .2px; }
  .ops-brand-tag {
    font-size: 10.5px; padding: 2px 10px; border-radius: 999px;
    background: rgba(251, 215, 107, .12); color: var(--o-gold);
    border: 1px solid rgba(251, 215, 107, .24);
    font-weight: 700;
  }
  @keyframes opsBlink {
    0%, 100% { opacity: 1; } 50% { opacity: .5; }
  }

  /* ===================== BENTO GRID ===================== */
  .ops-bento {
    display: grid;
    grid-template-columns: 1.05fr 1.55fr 1.05fr;
    grid-template-rows: 1fr 1fr 1fr;
    gap: 10px;
    min-height: 0;
  }
  .ops-bento > .ops-hub {
    grid-column: 2;
    grid-row: 1 / span 3;
  }
  /* عمود اليمين (في RTL يساوي الشمال البصري) */
  .ops-bento > .ops-amb       { grid-column: 1; grid-row: 1; }
  .ops-bento > .ops-funds     { grid-column: 1; grid-row: 2; }
  .ops-bento > [data-rotor="topEntities"]  { grid-column: 1; grid-row: 3; }
  /* عمود اليسار — قائمة السفراء تمتد على صفّين بدل بطاقة "الأنشطة الحية" المحذوفة */
  .ops-bento > .ops-total     { grid-column: 3; grid-row: 1; }
  .ops-bento > [data-rotor="topAmbs"] { grid-column: 3; grid-row: 2 / span 2; }

  /* ===================== TILE BASE ===================== */
  .ops-tile {
    position: relative;
    background: var(--o-panel);
    border: 1px solid var(--o-border);
    border-radius: 18px;
    padding: 14px 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
    isolation: isolate;
    transition: transform .35s var(--ease-out, cubic-bezier(.22,1,.36,1)),
                border-color .35s, box-shadow .35s;
  }
  .ops-tile::before {
    content: "";
    position: absolute; inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(200, 157, 126, .55), transparent);
    pointer-events: none;
  }
  .ops-tile::after {
    content: "";
    position: absolute;
    width: 240px; height: 240px;
    right: -90px; top: -90px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(200, 157, 126, .10), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .ops-tile:hover {
    transform: translateY(-2px);
    border-color: var(--o-border-2);
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, .8), var(--o-glow-primary);
  }
  .ops-tile-corner {
    position: absolute;
    top: 8px; left: 12px;
    font-size: 9.5px; letter-spacing: 1.4px;
    color: var(--o-mute);
    font-weight: 700;
    text-transform: uppercase;
  }
  .ops-tile-head {
    display: flex; align-items: center; gap: 10px;
  }
  .ops-tile-icon {
    width: 28px; height: 28px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 9px;
    background: rgba(200, 157, 126, .14);
    color: var(--o-primary);
    border: 1px solid rgba(200, 157, 126, .25);
  }
  .ops-tile-icon svg { width: 16px; height: 16px; }
  .ops-tile-icon.gold { background: rgba(251, 215, 107, .14); color: var(--o-gold); border-color: rgba(251, 215, 107, .25); }
  .ops-tile-icon.rose { background: rgba(227, 161, 180, .14); color: var(--o-rose); border-color: rgba(227, 161, 180, .25); }
  .ops-tile-icon.ok   { background: rgba(74, 222, 128, .14); color: var(--o-ok);   border-color: rgba(74, 222, 128, .25); }
  .ops-tile-label {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--o-text-2);
    flex: 1;
    letter-spacing: .2px;
  }
  .ops-tile-trend {
    font-size: 11px; font-weight: 800;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(245, 240, 232, .06);
    color: var(--o-text-2);
    display: inline-flex; align-items: center; gap: 5px;
  }
  .ops-tile-trend.up   { background: rgba(74, 222, 128, .12); color: var(--o-ok); }
  .ops-tile-trend.down { background: rgba(248, 113, 113, .12); color: var(--o-danger); }
  .ops-blink {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--o-ok); display: inline-block;
    animation: opsPulse 1.4s ease-out infinite;
  }
  .ops-tile-value {
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 800;
    color: var(--o-text);
    letter-spacing: -.5px;
    line-height: 1.05;
    text-align: left;
    direction: ltr;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 20px rgba(200, 157, 126, .25);
  }
  .ops-tile-value.big { font-size: clamp(26px, 2.8vw, 34px); }
  .ops-tile-value small { font-size: .42em; color: var(--o-text-2); margin-inline-start: 6px; font-weight: 700; }
  .ops-tile-foot {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 11.5px; color: var(--o-mute);
    font-weight: 600;
    margin-top: auto;
  }
  .ops-tile-foot b { color: var(--o-text); font-weight: 800; font-size: 13px; }

  /* ===================== MINI BARS ===================== */
  .ops-mini-bars { display: flex; flex-direction: column; gap: 6px; }
  .ops-mini-bar {
    display: grid;
    grid-template-columns: 92px 1fr 32px;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
  }
  .ops-mini-bar .lbl { color: var(--o-text-2); font-weight: 600; }
  .ops-mini-bar .val { color: var(--o-text); font-weight: 800; text-align: left; direction: ltr; }
  .ops-mini-bar .bar {
    height: 4px; border-radius: 999px;
    background: rgba(245, 240, 232, .06); overflow: hidden;
    position: relative;
  }
  .ops-mini-bar .bar i {
    display: block; height: 100%;
    width: var(--w, 0%);
    background: linear-gradient(90deg, var(--o-primary), var(--o-gold));
    border-radius: 999px;
    box-shadow: 0 0 8px rgba(200, 157, 126, .5);
    animation: opsBarGrow 1.2s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes opsBarGrow { from { width: 0%; } }

  /* ===================== PILLS ===================== */
  .ops-tile-row { display: flex; gap: 6px; flex-wrap: wrap; }
  .ops-tile-row.tight { gap: 6px; margin-top: 2px; }
  .ops-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(245, 240, 232, .06);
    border: 1px solid rgba(245, 240, 232, .08);
    color: var(--o-text-2);
    font-size: 11.5px; font-weight: 600;
  }
  .ops-pill b { color: var(--o-text); font-weight: 800; }
  .ops-pill-live { background: rgba(74, 222, 128, .08); border-color: rgba(74, 222, 128, .22); color: var(--o-ok); }
  .ops-pill-soft { background: rgba(200, 157, 126, .08); border-color: rgba(200, 157, 126, .2); color: var(--o-primary); }
  .ops-pill-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--o-ok); animation: opsPulse 1.6s ease-out infinite;
  }
  .ops-pill-dot.ok { background: var(--o-ok); }

  /* ===================== STACK BAR ===================== */
  .ops-stack-bar {
    display: flex; gap: 2px;
    height: 6px;
    border-radius: 999px;
    background: rgba(245, 240, 232, .06);
    overflow: hidden;
  }
  .ops-stack-bar .seg {
    height: 100%;
    border-radius: 999px;
    transform: scaleX(0); transform-origin: right;
    animation: opsSegGrow 1.1s cubic-bezier(.22,1,.36,1) forwards;
  }
  .ops-stack-bar .seg-a { background: linear-gradient(90deg, var(--o-ok), #4ade80); width: var(--w, 0%); }
  .ops-stack-bar .seg-b { background: linear-gradient(90deg, var(--o-gold-2), var(--o-gold)); width: var(--w, 0%); animation-delay: .15s; }
  @keyframes opsSegGrow { to { transform: scaleX(1); } }

  /* ===================== PROGRESS BAR ===================== */
  .ops-bar {
    height: 6px;
    border-radius: 999px;
    background: rgba(245, 240, 232, .06);
    overflow: hidden;
    position: relative;
  }
  .ops-bar span {
    display: block; height: 100%;
    width: var(--w, 0%);
    background: linear-gradient(90deg, var(--o-primary), var(--o-gold));
    border-radius: 999px;
    box-shadow: 0 0 12px rgba(200, 157, 126, .5);
    position: relative;
  }
  .ops-bar span::after {
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);
    transform: translateX(-100%);
    animation: opsShine 2.4s ease-in-out infinite;
  }
  @keyframes opsShine {
    0%   { transform: translateX(-100%); }
    60%  { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }

  /* ===================== SPARKLINE ===================== */
  .ops-sparkline {
    height: 28px; width: 100%;
    color: var(--o-primary);
    margin-top: auto;
    opacity: .8;
    filter: drop-shadow(0 0 6px rgba(200, 157, 126, .35));
  }
  .ops-sparkline polyline {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: opsSparkDraw 1.4s ease-out forwards .35s;
  }
  @keyframes opsSparkDraw { to { stroke-dashoffset: 0; } }

  /* ===================== LIVE GRID (الأنشطة الحية) ===================== */
  .ops-live-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 4px;
  }
  .ops-live-cell {
    padding: 8px 10px;
    background: rgba(245, 240, 232, .04);
    border: 1px solid var(--o-border);
    border-radius: 12px;
    text-align: center;
  }
  .ops-live-cell .lv {
    font-size: 22px; font-weight: 800; color: var(--o-text);
    direction: ltr; font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .ops-live-cell .lb {
    font-size: 11px; color: var(--o-text-2); margin-top: 4px;
    font-weight: 600;
  }

  /* ===================== ROTATING TILES ===================== */
  .ops-rotate { padding: 0; }
  .ops-rotate-head {
    padding: 14px 16px 6px;
  }
  .ops-rotate-titles { display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .ops-rotate-sub {
    font-size: 10.5px;
    color: var(--o-gold);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .ops-rotate-dots {
    display: inline-flex;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 76px;
  }
  .ops-rotate-dots .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(245, 240, 232, .15);
    transition: all .3s;
  }
  .ops-rotate-dots .dot.active {
    background: var(--o-gold);
    box-shadow: 0 0 8px var(--o-gold);
    transform: scaleX(2.4);
    border-radius: 999px;
  }
  .ops-rotate-stage {
    position: relative;
    flex: 1;
    overflow: hidden;
    padding: 4px 16px 14px;
  }
  .ops-rotate-slide {
    position: absolute; inset: 4px 16px 14px;
    display: flex; flex-direction: column;
    align-items: center;
    gap: 4px;
    opacity: 0;
    transform: translateY(14px) scale(.96);
    transition: opacity .55s var(--ease-out, cubic-bezier(.22,1,.36,1)),
                transform .55s var(--ease-out, cubic-bezier(.22,1,.36,1));
    pointer-events: none;
  }
  .ops-rotate-slide.active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .ops-medal {
    width: 56px; height: 56px;
    filter: drop-shadow(0 6px 16px rgba(251, 215, 107, .4));
    animation: opsMedalSpin 6s ease-in-out infinite;
  }
  @keyframes opsMedalSpin {
    0%, 100% { transform: rotate(-4deg) scale(1); }
    50%      { transform: rotate(4deg) scale(1.04); }
  }
  .ops-rotate-name {
    font-size: 17px; font-weight: 800;
    color: var(--o-text);
    text-align: center;
    line-height: 1.2;
    margin-top: 2px;
  }
  .ops-rotate-entity {
    font-size: 11.5px;
    color: var(--o-text-2);
    text-align: center;
    font-weight: 600;
  }
  .ops-rotate-amount {
    font-size: 22px; font-weight: 800;
    color: var(--o-gold);
    direction: ltr;
    font-variant-numeric: tabular-nums;
    margin-top: 2px;
    text-shadow: 0 0 18px rgba(251, 215, 107, .4);
  }
  .ops-rotate-amount small {
    font-size: .5em; color: var(--o-text-2); margin-inline-start: 4px; font-weight: 700;
  }
  .ops-rotate-meta {
    display: flex; gap: 12px;
    font-size: 10.5px;
    color: var(--o-mute);
    font-weight: 700;
    margin-top: 2px;
  }

  /* ===================== LEADERBOARD (قوائم الترتيب) ===================== */
  .ops-leaderboard .ops-lb-stage { padding: 4px 12px 12px; }
  .ops-leaderboard .ops-lb-slide {
    inset: 4px 12px 12px;
    display: block;
    overflow: hidden;
  }
  .ops-lb-list {
    list-style: none;
    margin: 0; padding: 0;
    counter-reset: lb;
    display: flex; flex-direction: column;
    gap: 4px;
    height: 100%;
  }
  .ops-lb-list-amb { gap: 3px; }
  .ops-lb-list > li {
    counter-increment: lb;
    display: grid;
    grid-template-columns: 24px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 10px;
    background: rgba(245, 240, 232, .03);
    border: 1px solid var(--o-border);
    font-size: 12px;
    min-height: 0;
  }
  .ops-lb-list > li.ops-lb-empty {
    grid-template-columns: 1fr;
    color: var(--o-mute);
    text-align: center;
    font-weight: 600;
    padding: 14px;
  }
  .ops-lb-list > li::before {
    content: counter(lb);
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px;
    border-radius: 7px;
    background: rgba(200, 157, 126, .12);
    color: var(--o-primary);
    font-weight: 800;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    direction: ltr;
  }
  .ops-lb-list > li:nth-child(1)::before {
    background: linear-gradient(135deg, #fbd76b, #b07a18);
    color: #2a1d10;
    box-shadow: 0 0 12px rgba(251, 215, 107, .45);
  }
  .ops-lb-list > li:nth-child(2)::before {
    background: linear-gradient(135deg, #e6e6e6, #9a9a9a);
    color: #1a1410;
  }
  .ops-lb-list > li:nth-child(3)::before {
    background: linear-gradient(135deg, #d29670, #8a5230);
    color: #fff;
  }
  .ops-lb-name {
    display: flex; flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .ops-lb-name b {
    color: var(--o-text);
    font-weight: 800;
    font-size: 12.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ops-lb-name span {
    color: var(--o-text-2);
    font-size: 10.5px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ops-lb-amount {
    direction: ltr;
    font-variant-numeric: tabular-nums;
    color: var(--o-gold);
    font-weight: 800;
    font-size: 13px;
    text-align: left;
    white-space: nowrap;
  }
  .ops-lb-amount small {
    font-size: 9.5px;
    color: var(--o-text-2);
    margin-inline-start: 3px;
    font-weight: 700;
  }
  .ops-leaderboard-tall .ops-lb-list > li {
    padding: 7px 12px;
    font-size: 12.5px;
  }

  /* ===================== CENTRAL HUB ===================== */
  .ops-hub {
    position: relative;
    background:
      radial-gradient(80% 60% at 50% 40%, rgba(178, 144, 121, .12), transparent 60%),
      linear-gradient(180deg, rgba(38, 28, 22, .92), rgba(28, 21, 16, .96));
    border: 1px solid var(--o-border-2);
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    isolation: isolate;
    box-shadow:
      inset 0 1px 0 rgba(245, 240, 232, .04),
      0 30px 80px -40px rgba(0, 0, 0, .9);
  }
  .ops-hub-corner {
    position: absolute; top: 12px; left: 16px;
    font-size: 10px; letter-spacing: 1.6px;
    color: var(--o-mute);
    font-weight: 700;
    z-index: 2;
  }
  .ops-hub-grid-bg {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(245, 240, 232, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 240, 232, .035) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(closest-side at 50% 50%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(closest-side at 50% 50%, #000 30%, transparent 80%);
    z-index: 0;
  }
  .ops-hub-rings {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    z-index: 0;
  }
  .ops-hub-rings .ring {
    position: absolute;
    border: 1px solid rgba(245, 240, 232, .07);
    border-radius: 50%;
    animation: opsRingPulse 5s ease-out infinite;
  }
  .ops-hub-rings .r1 { width: 280px; height: 280px; }
  .ops-hub-rings .r2 { width: 380px; height: 380px; animation-delay: 1.2s; }
  .ops-hub-rings .r3 { width: 480px; height: 480px; animation-delay: 2.4s; }
  @keyframes opsRingPulse {
    0%   { opacity: .25; transform: scale(.95); }
    50%  { opacity: .55; }
    100% { opacity: .15; transform: scale(1.05); }
  }
  .ops-hub-orbit {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(50%, -50%);
    width: 340px; height: 340px;
    z-index: 0;
  }
  .ops-hub-orbit svg { width: 100%; height: 100%; }
  .ops-progress-ring {
    filter: drop-shadow(0 0 8px rgba(251, 215, 107, .35));
  }

  .ops-hub-content {
    position: relative; z-index: 2;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 26px 18px 16px;
    flex: 1;
    gap: 10px;
  }
  .ops-hub-logo-wrap {
    width: clamp(76px, 8.4vw, 112px);
    height: clamp(76px, 8.4vw, 112px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 38%, rgba(245, 240, 232, .14), rgba(245, 240, 232, .05) 62%, rgba(15, 11, 8, .1));
    border: 1px solid rgba(245, 240, 232, .16);
    box-shadow:
      0 0 0 5px rgba(251, 215, 107, .06),
      0 18px 40px -24px rgba(251, 215, 107, .75);
    overflow: hidden;
  }
  .ops-hub-logo {
    width: 78%;
    height: 78%;
    object-fit: contain;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, .34));
  }
  .ops-hub-kicker {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 14px;
    border-radius: 999px;
    background: rgba(251, 215, 107, .12);
    border: 1px solid rgba(251, 215, 107, .28);
    color: var(--o-gold);
    font-size: 11.5px; font-weight: 800;
    letter-spacing: .5px;
  }
  .ops-hub-kicker-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--o-gold); animation: opsBlink 1.6s ease-in-out infinite;
  }
  .ops-hub-title {
    margin: 4px 0 0;
    font-size: clamp(32px, 4.4vw, 52px);
    font-weight: 800;
    color: var(--o-text);
    letter-spacing: -.5px;
    line-height: 1.05;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-shadow:
      0 0 40px rgba(251, 215, 107, .35),
      0 0 80px rgba(200, 157, 126, .25);
  }
  .ops-hub-crescent {
    color: var(--o-gold);
    display: inline-flex;
    filter: drop-shadow(0 0 12px rgba(251, 215, 107, .6));
    animation: opsCrescentFloat 4s ease-in-out infinite;
  }
  .ops-hub-crescent svg { width: 36px; height: 36px; }
  @keyframes opsCrescentFloat {
    0%, 100% { transform: translateY(0) rotate(-8deg); }
    50%      { transform: translateY(-6px) rotate(8deg); }
  }
  .ops-hub-hijri {
    display: inline-flex; align-items: baseline; gap: 10px;
    margin-top: 8px;
    padding: 10px 22px;
    border-radius: 16px;
    background: rgba(245, 240, 232, .04);
    border: 1px solid var(--o-border);
  }
  .ops-hub-hijri .hd {
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 800;
    color: var(--o-gold);
    line-height: 1;
    text-shadow: 0 0 18px rgba(251, 215, 107, .45);
  }
  .ops-hub-hijri .hm {
    font-size: clamp(18px, 2.4vw, 24px);
    font-weight: 800;
    color: var(--o-text);
  }
  .ops-hub-hijri .hy {
    font-size: clamp(13px, 1.6vw, 16px);
    font-weight: 700;
    color: var(--o-text-2);
  }
  .ops-hub-progress-text {
    display: flex; gap: 16px; align-items: baseline;
    margin-top: 8px;
    font-size: 13.5px; color: var(--o-text-2);
    direction: ltr;
    font-variant-numeric: tabular-nums;
  }
  .ops-hub-progress-text > span { font-weight: 700; color: var(--o-text); }
  .ops-hub-progress-text small { color: var(--o-text-2); margin: 0 4px; font-size: .8em; }
  .ops-hub-progress-text b {
    font-size: 22px; font-weight: 800; color: var(--o-gold);
    text-shadow: 0 0 16px rgba(251, 215, 107, .4);
  }
  .ops-hub-update {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(74, 222, 128, .08);
    border: 1px solid rgba(74, 222, 128, .25);
    color: var(--o-ok);
    font-size: 12px; font-weight: 700;
    margin-top: 6px;
  }
  .ops-hub-update-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--o-ok);
    box-shadow: 0 0 0 0 rgba(74, 222, 128, .6);
    animation: opsPulse 1.4s ease-out infinite;
  }
  .ops-hub-update-label { color: var(--o-text-2); font-weight: 600; }
  .ops-hub-update b { color: var(--o-ok); font-weight: 800; }

  /* ===================== TICKER (شريط البث المباشر داخل الـ hub) ===================== */
  .ops-hub-ticker {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(15, 11, 8, .55);
    border-top: 1px solid var(--o-border);
    z-index: 2;
  }
  .ops-hub-ticker-tag {
    font-size: 10.5px; font-weight: 800;
    color: var(--o-danger);
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(248, 113, 113, .12);
    border: 1px solid rgba(248, 113, 113, .3);
    letter-spacing: .5px;
    white-space: nowrap;
  }
  .ops-hub-ticker-track {
    position: relative; overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    height: 22px;
  }
  .ops-hub-ticker-loop {
    display: inline-flex; gap: 14px;
    white-space: nowrap;
    animation: opsTicker 36s linear infinite;
    font-size: 12px;
    color: var(--o-text-2);
    font-weight: 600;
    line-height: 22px;
  }
  .ops-hub-ticker-loop:hover { animation-play-state: paused; }
  .tk-item { color: var(--o-text); }
  .tk-sep { color: var(--o-gold); opacity: .5; }
  @keyframes opsTicker {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ===================== ENTER ANIMATION ===================== */
  @keyframes opsFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .ops-root .ops-tile,
  .ops-root .ops-hub,
  .ops-root .ops-topbar {
    animation: opsFadeIn .6s cubic-bezier(.22,1,.36,1) both;
  }
  .ops-root .ops-topbar { animation-delay: .02s; }
  .ops-root .ops-amb     { animation-delay: .08s; }
  .ops-root .ops-funds   { animation-delay: .16s; }
  .ops-root .ops-rotate[data-rotor="topEntities"]  { animation-delay: .24s; }
  .ops-root .ops-hub     { animation-delay: .12s; }
  .ops-root .ops-total    { animation-delay: .12s; }
  .ops-root .ops-rotate[data-rotor="topAmbs"] { animation-delay: .28s; }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 1080px) {
    .ops-bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr 1.4fr 1fr 1fr;
    }
    .ops-bento > .ops-hub     { grid-column: 1 / span 2; grid-row: 3; }
    .ops-bento > .ops-amb     { grid-column: 1; grid-row: 1; }
    .ops-bento > .ops-funds   { grid-column: 2; grid-row: 1; }
    .ops-bento > .ops-total    { grid-column: 1; grid-row: 2; }
    .ops-bento > [data-rotor="topEntities"]  { grid-column: 2; grid-row: 2; }
    .ops-bento > [data-rotor="topAmbs"]      { grid-column: 1 / span 2; grid-row: 4; }
    .ops-root { height: auto; min-height: 100dvh; }
    body:has(.ops-root) { overflow: auto; }
  }
  @media (max-width: 720px) {
    .ops-topbar { font-size: 11px; padding: 0 10px; }
    .ops-tb-center .ops-brand-tag { display: none; }
    .ops-bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto auto auto;
      gap: 8px;
    }
    .ops-bento > .ops-hub { grid-column: 1 / -1; grid-row: 1; min-height: 360px; }
    .ops-bento > .ops-amb     { grid-row: 2; }
    .ops-bento > .ops-funds   { grid-row: 2; }
    .ops-bento > .ops-total                  { grid-column: 1 / -1; grid-row: 3; }
    .ops-bento > [data-rotor="topEntities"]  { grid-column: 1 / -1; grid-row: 4; }
    .ops-bento > [data-rotor="topAmbs"]      { grid-column: 1 / -1; grid-row: 5; min-height: 480px; }
    .ops-hub-title { font-size: 28px; }
    .ops-hub-hijri .hd { font-size: 28px; }
    .ops-hub-hijri .hm { font-size: 18px; }
    .ops-tile { padding: 12px; gap: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ops-root *,
    .ops-root *::before,
    .ops-root *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
</style>

<!-- ============ SCRIPT ============ -->
<script>
(function () {
  const root = document.querySelector('.ops-root');
  if (!root) return;

  const arabicDigits = ['٠','١','٢','٣','٤','٥','٦','٧','٨','٩'];
  const toArabic = (n) => String(n).replace(/[0-9]/g, d => arabicDigits[+d]);
  const fmtNum = (n) => Math.round(Number(n) || 0).toLocaleString('en-US');
  const pctOf = (a, b) => (b > 0 ? Math.min(100, Math.round((a / b) * 100)) : 0);

  // ===== Count-up مرن (يأخذ هدفاً جديداً ويتحرك من القيمة الحالية) =====
  const animTokens = new WeakMap();
  function setNumber(el, target, opts) {
    if (!el) return;
    const t = Math.max(0, Math.round(Number(target) || 0));
    const startVal = Number(String(el.textContent || '0').replace(/[^\d.-]/g, '')) || 0;
    if (opts && opts.instant) { el.textContent = fmtNum(t); return; }
    if (t === startVal) { el.textContent = fmtNum(t); return; }
    const duration = 900;
    const startTime = performance.now();
    const ease = (k) => 1 - Math.pow(1 - k, 4);
    const token = Symbol('countup');
    animTokens.set(el, token);
    (function tick(now) {
      if (animTokens.get(el) !== token) return;
      const p = Math.min(1, (now - startTime) / duration);
      const v = startVal + (t - startVal) * ease(p);
      el.textContent = fmtNum(v);
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = fmtNum(t);
    })(startTime);
  }
  function setText(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }
  function setBarWidth(id, pct) {
    const el = document.getElementById(id);
    if (el) el.style.setProperty('--w', pct + '%');
  }

  // ===== ساعة النظام =====
  const clockEl = document.getElementById('opsClock');
  function tickClock() {
    const d = new Date();
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    const ss = String(d.getSeconds()).padStart(2, '0');
    if (clockEl) clockEl.textContent = toArabic(`${hh}:${mm}:${ss}`);
  }
  tickClock();
  setInterval(tickClock, 1000);

  // ===== التاريخ الميلادي + الهجري =====
  try {
    const now = new Date();
    const gregEl = document.getElementById('opsGreg');
    if (gregEl) {
      const g = new Intl.DateTimeFormat('ar-EG-u-nu-arab', {
        day: 'numeric', month: 'long', year: 'numeric'
      }).format(now);
      gregEl.textContent = g + ' م';
    }
    const hijriFmt = new Intl.DateTimeFormat('ar-SA-u-ca-islamic-umalqura-nu-arab', {
      day: 'numeric', month: 'long', year: 'numeric'
    });
    const parts = hijriFmt.formatToParts(now);
    const get = (t) => (parts.find(p => p.type === t) || {}).value || '';
    const dayEl = document.getElementById('opsHijriDay');
    const monthEl = document.getElementById('opsHijriMonth');
    const yearEl = document.getElementById('opsHijriYear');
    if (dayEl)   dayEl.textContent   = get('day');
    if (monthEl) monthEl.textContent = get('month');
    if (yearEl)  yearEl.textContent  = get('year') + ' هـ';
  } catch (e) {}

  // ===== مؤقّت آخر مزامنة — يحسب من lastSyncAt الحقيقي =====
  let lastSyncAt = null;
  const syncAgoEl = document.getElementById('opsSyncAgo');
  const syncBigEl = document.getElementById('opsLastSyncBig');
  function fmtAgoShort(s) {
    if (s < 60)   return 'قبل ' + toArabic(s) + ' ث';
    if (s < 3600) return 'قبل ' + toArabic(Math.floor(s / 60)) + ' د';
    if (s < 86400) return 'قبل ' + toArabic(Math.floor(s / 3600)) + ' س';
    return 'قبل ' + toArabic(Math.floor(s / 86400)) + ' يوم';
  }
  function fmtAgoLong(s) {
    if (s < 60) return 'قبل ' + toArabic(s) + ' ثانية';
    if (s < 3600) {
      const m = Math.floor(s / 60);
      const sec = s % 60;
      return 'قبل ' + toArabic(m) + ' د و ' + toArabic(sec) + ' ث';
    }
    if (s < 86400) {
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      return 'قبل ' + toArabic(h) + ' س و ' + toArabic(m) + ' د';
    }
    return 'قبل ' + toArabic(Math.floor(s / 86400)) + ' يوم';
  }
  function tickSync() {
    if (!lastSyncAt) {
      if (syncAgoEl) syncAgoEl.textContent = '—';
      if (syncBigEl) syncBigEl.textContent = 'لم تتم المزامنة بعد';
      return;
    }
    const s = Math.max(0, Math.floor((Date.now() - lastSyncAt) / 1000));
    if (syncAgoEl) syncAgoEl.textContent = fmtAgoShort(s);
    if (syncBigEl) syncBigEl.textContent = fmtAgoLong(s);
  }
  tickSync();
  setInterval(tickSync, 1000);

  // ===== الشرائح الدوّارة (لكل بطاقة عنوانان فرعيان) =====
  const ROTOR_SUB_LABELS = {
    topEntities: { boys: 'المجمعات', girls: 'الدور النسائية' },
    topAmbs:     { g1:   'المراكز ١ — ١٠', g2: 'المراكز ١١ — ٢٠' },
  };
  function setupRotator(panel) {
    const slides = Array.from(panel.querySelectorAll('.ops-rotate-slide'));
    const dots   = Array.from(panel.querySelectorAll('.ops-rotate-dots .dot'));
    const subEl  = panel.querySelector('[data-rotate-sub]');
    if (panel._opsRotateTimer) clearInterval(panel._opsRotateTimer);
    const rotor = panel.dataset.rotor;
    const labelMap = (ROTOR_SUB_LABELS[rotor]) || {};
    let idx = 0;
    function show(i) {
      if (!slides.length) return;
      slides.forEach((s, k) => s.classList.toggle('active', k === i));
      dots.forEach((d, k) => d.classList.toggle('active', k === i));
      const key = slides[i].dataset.rotateKey;
      const label = slides[i].dataset.rotateLabel || labelMap[key];
      if (subEl && label) subEl.textContent = label;
    }
    show(0);
    if (slides.length < 2) return;
    panel._opsRotateTimer = setInterval(() => {
      idx = (idx + 1) % slides.length;
      show(idx);
    }, 7000);
  }
  root.querySelectorAll('.ops-rotate').forEach(setupRotator);

  // ===== الشريط الدوّار للأنشطة =====
  function renderTicker(items) {
    const loop = document.getElementById('dashTickerLoop');
    if (!loop) return;
    const list = (items && items.length) ? items : ['—'];
    const seq = list.concat(list); // مكرّر مرتين حتى يبدو متواصلاً
    loop.innerHTML = seq.map((t) => {
      const safe = String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      return `<span class="tk-item">${safe}</span><span class="tk-sep">◆</span>`;
    }).join('');
  }

  // ===== رسم قائمة الجهات =====
  const esc = (v) => String(v == null ? '' : v)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  function renderEntityRows(rows) {
    if (!rows || !rows.length) return '<li class="ops-lb-empty">لا توجد بيانات بعد…</li>';
    return rows.map((r) => `
      <li>
        <span class="ops-lb-name">
          <b>${esc(r.name)}</b>
          <span>${fmtNum(r.ambassadors || 0)} سفيراً · ${fmtNum(r.funds || 0)} صندوقاً</span>
        </span>
        <span class="ops-lb-amount">${fmtNum(r.amount || 0)} <small>ر.س</small></span>
      </li>
    `).join('');
  }

  function renderEntityLeaderboard(boys, girls) {
    const panel = root.querySelector('[data-rotor="topEntities"]');
    if (!panel) return;
    const stage = panel.querySelector('[data-stage]');
    const dots = panel.querySelector('[data-rotate-dots]');
    if (!stage || !dots) return;

    const pageSize = 4;
    const slides = [];
    [
      { key: 'boys', label: 'المجمعات', rows: boys || [] },
      { key: 'girls', label: 'الدور النسائية', rows: girls || [] },
    ].forEach((group) => {
      const rows = group.rows.length ? group.rows : [];
      const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
      for (let page = 0; page < totalPages; page += 1) {
        const start = page * pageSize;
        const pageRows = rows.slice(start, start + pageSize);
        const from = pageRows.length ? start + 1 : 0;
        const to = start + pageRows.length;
        const label = pageRows.length
          ? `${group.label} ${toArabic(from)} — ${toArabic(to)}`
          : group.label;
        slides.push(`
          <div class="ops-rotate-slide ops-lb-slide" data-rotate-key="${group.key}-${page + 1}" data-rotate-label="${esc(label)}">
            <ol class="ops-lb-list" style="counter-reset: lb ${start}">
              ${renderEntityRows(pageRows)}
            </ol>
          </div>
        `);
      }
    });

    stage.innerHTML = slides.join('');
    dots.innerHTML = slides.map((_, i) => `<span class="dot${i === 0 ? ' active' : ''}"></span>`).join('');
    setupRotator(panel);
  }

  // ===== رسم قائمة السفراء (مع رقم البداية لتسلسل العدّاد) =====
  function renderAmbList(elId, rows, startCounter) {
    const el = document.getElementById(elId);
    if (!el) return;
    if (startCounter) el.style.counterReset = 'lb ' + (startCounter - 1);
    if (!rows || !rows.length) {
      el.innerHTML = '<li class="ops-lb-empty">لا توجد بيانات بعد…</li>';
      return;
    }
    el.innerHTML = rows.map((r) => `
      <li>
        <span class="ops-lb-name">
          <b>${esc(r.name)}</b>
          <span>${esc(r.entity || '—')} · ${fmtNum(r.funds || 0)} صندوقاً</span>
        </span>
        <span class="ops-lb-amount">${fmtNum(r.amount || 0)} <small>ر.س</small></span>
      </li>
    `).join('');
  }

  // ===== تطبيق البيانات على الواجهة =====
  const HUB_RING_LEN = 791.68;
  function applyDashboard(d) {
    const s = (d && d.stats) || {};

    // ===== السفراء =====
    setNumber(document.getElementById('dashAmbTotal'), s.ambassadorsTotal || 0);
    setText('dashAmbDelta', '▲ ' + toArabic(s.ambassadorsDelta7d || 0));
    const memPct = pctOf(s.ambassadorsMembers || 0, s.ambassadorsTotal || 0);
    const extPct = pctOf(s.ambassadorsExternal || 0, s.ambassadorsTotal || 0);
    const mBar = document.getElementById('dashAmbMembersBar');
    const eBar = document.getElementById('dashAmbExternalBar');
    if (mBar) mBar.style.setProperty('--w', memPct + '%');
    if (eBar) eBar.style.setProperty('--w', extPct + '%');
    setText('dashAmbMembersVal', fmtNum(s.ambassadorsMembers || 0));
    setText('dashAmbExternalVal', fmtNum(s.ambassadorsExternal || 0));

    // ===== الصناديق =====
    setNumber(document.getElementById('dashFundsTotal'), s.fundsTotal || 0);
    setText('dashFundsActive', fmtNum(s.fundsActive || 0));
    setText('dashFundsCompleted', fmtNum(s.fundsCompleted || 0));
    const activePct = pctOf(s.fundsActive || 0, s.fundsTotal || 0);
    const completedPct = pctOf(s.fundsCompleted || 0, s.fundsTotal || 0);
    setBarWidth('dashFundsActiveBar', activePct);
    setBarWidth('dashFundsCompletedBar', completedPct);
    const stack = document.getElementById('dashFundsStack');
    if (stack) stack.title = activePct + '% نشطة · ' + completedPct + '% مكتملة';
    setText('dashFundsGoal', fmtNum(s.fundsGoal || 0));
    const fundsPct = pctOf(s.fundsTotal || 0, s.fundsGoal || 0);
    setText('dashFundsPct', fundsPct + '%');
    setText('dashFundsTrend', '▲ ' + toArabic(s.fundsActive || 0));

    // ===== الهَب — حلقة التقدّم وإجمالي التبرعات =====
    const donationsPct = pctOf(s.totalDonations || 0, s.donationsGoal || 0);
    const ring = document.getElementById('dashHubProgressRing');
    if (ring) ring.setAttribute('stroke-dashoffset', HUB_RING_LEN - (HUB_RING_LEN * donationsPct / 100));
    setNumber(document.getElementById('dashHubCurrentAmount'), s.totalDonations || 0);
    setNumber(document.getElementById('dashHubGoalAmount'), s.donationsGoal || 0);
    setText('dashHubPct', donationsPct + '%');

    // ===== إجمالي التبرعات (البطاقة اليمنى) =====
    setNumber(document.getElementById('dashTotalAmount'), s.totalDonations || 0);
    setText('dashTotalGoal', fmtNum(s.donationsGoal || 0));
    setText('dashTotalPct', donationsPct + '%');
    setBarWidth('dashTotalBar', donationsPct);
    setNumber(document.getElementById('dashTotalToday'), s.donationsToday || 0);
    setText('dashTotalTrend', '▲ ' + toArabic(donationsPct) + '٪');

    // ===== قوائم الترتيب =====
    renderEntityLeaderboard(d && d.topEntitiesBoys, d && d.topEntitiesGirls);
    const ambs = (d && d.topAmbassadors) || [];
    renderAmbList('dashTopAmbsG1List', ambs.slice(0, 10), 1);
    renderAmbList('dashTopAmbsG2List', ambs.slice(10, 20), 11);

    // ===== شريط الأنشطة =====
    renderTicker(d && d.liveFeed);

    // ===== توقيت آخر مزامنة =====
    if (d && d.lastSyncAt) {
      const parsed = Date.parse(d.lastSyncAt);
      if (!Number.isNaN(parsed)) lastSyncAt = parsed;
    } else if (d && d.generatedAt) {
      const parsed = Date.parse(d.generatedAt);
      if (!Number.isNaN(parsed)) lastSyncAt = parsed;
    }
    tickSync();
  }

  // ===== جلب البيانات + تحديث دوري =====
  async function loadDashboard() {
    try {
      const r = await fetch('/api/dashboard', { cache: 'no-store' });
      if (!r.ok) throw new Error('http ' + r.status);
      const data = await r.json();
      applyDashboard(data);
      if (syncAgoEl) {
        syncAgoEl.style.color = 'var(--o-ok)';
        setTimeout(() => { syncAgoEl.style.color = ''; }, 900);
      }
    } catch (e) {
      console.error('[dashboard] load failed:', e);
    }
  }
  loadDashboard();
  setInterval(loadDashboard, 30000);
})();
</script>

