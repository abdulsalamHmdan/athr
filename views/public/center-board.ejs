<%- include('../partials/head') %>
<%- include('../partials/loader', { loaderType: 'centers' }) %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

<div data-content style="display:none;" class="board-page">

  <!-- خلفية سادة بسيطة -->
  <div class="bb-bg" aria-hidden="true"></div>

  <!-- ====================== HERO ====================== -->
  <section class="hero-card glass">
    <div class="hero-top">
      <a href="/centers/<%= entityId %>" class="chip chip-back" title="رجوع">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path fill="currentColor" d="M14 6l-6 6 6 6 1.41-1.41L10.83 12l4.58-4.59z"/>
        </svg>
        <span>رجوع</span>
      </a>
      <div class="chip chip-honor">
        <svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M5 16l2.5-6.5L4 7l5-.5L12 2l3 4.5 5 .5-3.5 2.5L19 16l-7-3.5L5 16z"/></svg>
        <span>لوحة الشرف</span>
      </div>
      <div class="chip chip-live" id="liveTag">
        <span class="live-dot"></span>
        <span>تحديث مباشر</span>
      </div>
      <div class="chip tier-chip" id="heroTier" style="display:none;">
        <span class="tier-ico" id="heroTierIcon"></span>
        <span id="heroTierLabel">—</span>
      </div>
    </div>

    <div class="hero-main">
      <div class="hero-left">
        <div class="hero-greet" id="heroGreet">&nbsp;</div>
        <h1 class="hero-title" id="centerName"><%= entityNameAr %></h1>
        <div class="hero-sub" id="centerKind">&nbsp;</div>

        <div class="hero-impact" id="heroImpact" style="display:none;">
          <span class="impact-ico">
            <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 21s-7-4.35-7-10a5 5 0 019-3 5 5 0 019 3c0 5.65-7 10-7 10z"/></svg>
          </span>
          <span id="heroImpactText"></span>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-trophy" id="heroTrophy" aria-hidden="true">
          <div class="trophy-glow"></div>
          <svg viewBox="0 0 64 64" width="100%" height="100%">
            <defs>
              <linearGradient id="gTrophy" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#fbbf24"/>
                <stop offset=".55" stop-color="#d4a017"/>
                <stop offset="1" stop-color="#92560c"/>
              </linearGradient>
              <linearGradient id="gTrophyBase" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#92560c"/>
                <stop offset="1" stop-color="#6b3f06"/>
              </linearGradient>
            </defs>
            <path d="M14 14h-3a4 4 0 00-4 4v4a8 8 0 008 8h2" fill="none" stroke="url(#gTrophy)" stroke-width="3" stroke-linecap="round"/>
            <path d="M50 14h3a4 4 0 014 4v4a8 8 0 01-8 8h-2" fill="none" stroke="url(#gTrophy)" stroke-width="3" stroke-linecap="round"/>
            <path d="M14 8h36v14a18 18 0 01-36 0V8z" fill="url(#gTrophy)"/>
            <path d="M19 11h6v9a9 9 0 01-6-8.5z" fill="rgba(255,255,255,.35)"/>
            <rect x="28" y="36" width="8" height="8" fill="url(#gTrophyBase)"/>
            <path d="M18 52h28l-2 6H20l-2-6z" fill="url(#gTrophyBase)"/>
            <ellipse cx="32" cy="52" rx="14" ry="2.5" fill="url(#gTrophyBase)"/>
            <path d="M32 13l1.5 3 3.3.5-2.4 2.3.6 3.3L32 20.5 28.9 22l.6-3.3L27 16.5l3.3-.5L32 13z" fill="#fff" opacity=".85"/>
          </svg>
          <span class="trophy-spark trophy-spark-1"></span>
          <span class="trophy-spark trophy-spark-2"></span>
          <span class="trophy-spark trophy-spark-3"></span>
        </div>
      </div>
    </div>

    <div class="hero-stats">
      <div class="stat-card" style="--c1:#16a34a;--c2:#22c55e;">
        <div class="stat-ico">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M16 11a4 4 0 10-4-4 4 4 0 004 4zm-8 0a4 4 0 10-4-4 4 4 0 004 4zm0 2c-2.7 0-8 1.3-8 4v3h10v-3c0-1 .3-1.9.8-2.7C9.6 13.4 8.6 13 8 13zm8 0c-.3 0-.7 0-1.2.1A5.7 5.7 0 0116 17v3h8v-3c0-2.7-5.3-4-8-4z"/></svg>
        </div>
        <div class="stat-body">
          <div class="stat-val" id="sAmb">0</div>
          <div class="stat-lbl">عدد السفراء</div>
        </div>
      </div>
      <div class="stat-card" style="--c1:#7c3aed;--c2:#a855f7;">
        <div class="stat-ico">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 8h-3V6a2 2 0 00-2-2H9a2 2 0 00-2 2v2H4a1 1 0 00-1 1v9a3 3 0 003 3h12a3 3 0 003-3V9a1 1 0 00-1-1zM9 6h6v2H9V6z"/></svg>
        </div>
        <div class="stat-body">
          <div class="stat-val" id="sFunds">0</div>
          <div class="stat-lbl">عدد الصناديق</div>
        </div>
      </div>
      <div class="stat-card" style="--c1:#d97706;--c2:#fbbf24;">
        <div class="stat-ico">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
        </div>
        <div class="stat-body">
          <div class="stat-val" id="sTotal">0</div>
          <div class="stat-lbl">إجمالي التبرعات</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================== ACHIEVEMENTS ====================== -->
  <section class="ach-card glass" id="achWrap" style="display:none;">
    <div class="ach-head">
      <span class="ach-head-ico">
        <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 2l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 15.3 6.8 18l1-5.8L3.6 8.1l5.8-.8L12 2z"/></svg>
      </span>
      <span>إنجازات الجهة</span>
      <span class="ach-thread"></span>
    </div>
    <div class="ach-row" id="achRow"></div>
  </section>

  <!-- ====================== RANK + PODIUMS ====================== -->
  <section class="sec">
    <div class="sec-head">
      <span class="sec-ico sec-ico-gold">
        <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M5 3h14l-1 6a6 6 0 01-5 5.92V18h3v2H8v-2h3v-3.08A6 6 0 016 9L5 3z"/></svg>
      </span>
      <h2>الترتيب ولوحة الشرف</h2>
      <span class="sec-spark">
        <svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M12 2l1.5 5.5L19 9l-5.5 1.5L12 16l-1.5-5.5L5 9l5.5-1.5L12 2z"/></svg>
      </span>
    </div>

    <div class="honor-row">
      <div class="rank-card glass" id="rankCard">
        <div class="rank-card-bg"></div>
        <div class="rank-head">
          <div class="rank-head-l">ترتيب جهتك بين</div>
          <div class="rank-head-kind" id="rankKindLabel">—</div>
        </div>

        <div class="rank-ring-wrap">
          <svg class="rank-ring" viewBox="0 0 120 120">
            <defs>
              <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fbbf24"/>
                <stop offset="50%" stop-color="#d4a017"/>
                <stop offset="100%" stop-color="#16a34a"/>
              </linearGradient>
            </defs>
            <circle cx="60" cy="60" r="50" fill="none" stroke="#eef0f4" stroke-width="9"/>
            <circle id="ringFg" cx="60" cy="60" r="50" fill="none"
                    stroke="url(#ringGrad)" stroke-width="9" stroke-linecap="round"
                    stroke-dasharray="314.159" stroke-dashoffset="314.159"
                    transform="rotate(-90 60 60)"/>
          </svg>
          <div class="rank-ring-center">
            <div class="rank-num" id="rankPos">—</div>
            <div class="rank-sub"><span>من</span> <b id="rankTot">—</b></div>
          </div>
          <span class="rank-crown" id="rankCrown" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M3 19h18v2H3v-2zm0-9l4 3 5-7 5 7 4-3v8H3v-8z"/></svg>
          </span>
        </div>

        <div class="rank-pct">
          <span class="rank-pct-v" id="rankPct">—</span>
          <span class="rank-pct-l">تفوّق على باقي الجهات</span>
        </div>

        <div class="rank-hint" id="rankHint">&nbsp;</div>

        <div class="rank-milestone" id="rankMilestone" style="display:none;">
          <svg viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M4 4h2v16H4V4zm4 0h12l-2 4 2 4H8V4z"/></svg>
          <span id="rankMilestoneText"></span>
        </div>
      </div>

      <div class="honor-card glass">
        <div class="honor-head">
          <span class="honor-ico honor-ico-gold">
            <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 2l9 5v2H3V7l9-5zm-7 9h2v8H5v-8zm4 0h2v8H9v-8zm4 0h2v8h-2v-8zm4 0h2v8h-2v-8zM3 20h18v2H3v-2z"/></svg>
          </span>
          <h3>أفضل 3 جهات</h3>
          <span class="honor-sub" id="topCentersKind">—</span>
        </div>
        <div class="podium" id="podiumCenters"></div>
      </div>

      <div class="honor-card glass">
        <div class="honor-head">
          <span class="honor-ico honor-ico-green">
            <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-4.4 0-8 2.2-8 5v3h16v-3c0-2.8-3.6-5-8-5z"/></svg>
          </span>
          <h3>أفضل 3 سفراء</h3>
          <span class="honor-sub" id="topAmbsKind">—</span>
        </div>
        <div class="podium" id="podiumAmbs"></div>
      </div>
    </div>
  </section>

  <!-- ====================== AMBASSADORS ====================== -->
  <section class="sec">
    <div class="sec-head">
      <span class="sec-ico sec-ico-green">
        <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-4.4 0-8 2.2-8 5v3h16v-3c0-2.8-3.6-5-8-5z"/></svg>
      </span>
      <h2>العشرة الأوائل</h2>
      <span class="sec-pill" id="ambCountPill">0</span>
    </div>

    <div class="amb-grid" id="ambGrid"></div>
    <div class="amb-more" id="ambMore" style="display:none;"></div>
    <div class="amb-empty" id="ambEmpty" style="display:none;">لا يوجد سفراء مسجّلون في هذه الجهة بعد.</div>
  </section>

  <!-- ====================== FOOTER ====================== -->
  <section class="footer-card glass">
    <div class="bf-quote" id="bfQuote">&nbsp;</div>
    <div class="bf-actions">
      <button type="button" class="bf-btn" id="btnShare">
        <svg viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M18 16a3 3 0 00-2.3 1.1L9 14V13l6.7-3.1A3 3 0 1015 8l-6.7 3.1a3 3 0 100 5.8L15 20a3 3 0 103-4z"/></svg>
        مشاركة اللوحة
      </button>
      <button type="button" class="bf-btn bf-btn-ghost" id="btnPrint">
        <svg viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M19 8h-1V4H6v4H5a3 3 0 00-3 3v6h4v3h12v-3h4v-6a3 3 0 00-3-3zM8 6h8v2H8V6zm8 13H8v-4h8v4zm4-7a1 1 0 11-1-1 1 1 0 011 1z"/></svg>
        طباعة كشهادة
      </button>
      <div class="bf-updated" id="bfUpdated">—</div>
    </div>
  </section>

  <div class="bf-toast" id="bfToast"></div>
</div>

<style>
  :root {
    --c-bg: #f5f7fb;
    --c-card: #ffffff;
    --c-border: #e3e8ef;
    --c-border-soft: #eef1f6;
    --c-text: #0f172a;
    --c-text-2: #475569;
    --c-mute: #64748b;
    --c-primary: #16a34a;
    --c-primary-2: #22c55e;
    --c-primary-soft: #e8f7ee;
    --c-gold: #d4a017;
    --c-gold-2: #fbbf24;
    --c-gold-soft: #fef3c7;
    --c-silver: #94a3b8;
    --c-silver-2: #cbd5e1;
    --c-silver-soft: #f1f5f9;
    --c-bronze: #b6612c;
    --c-bronze-2: #d97a45;
    --c-bronze-soft: #fde6d6;
    --c-purple: #7c3aed;
    --c-purple-soft: #f3e8ff;
    --c-blue: #2563eb;
    --c-blue-soft: #dbeafe;
    --c-rose: #ec4899;
    --c-amber: #f59e0b;

    --r-lg: 22px;
    --r-md: 16px;
    --r-sm: 12px;
    --shadow-1: 0 1px 2px rgba(15,23,42,.04), 0 4px 12px rgba(15,23,42,.05);
    --shadow-2: 0 6px 20px rgba(15,23,42,.06), 0 18px 40px rgba(15,23,42,.05);
    --shadow-glow-gold: 0 10px 30px -10px rgba(212,160,23,.55);
    --shadow-glow-green: 0 10px 30px -10px rgba(22,163,74,.45);
  }

  body:has(.board-page){ font-family: 'Cairo', system-ui, -apple-system, 'Segoe UI', Tahoma, sans-serif; }
  body:has(.board-page) .container{ max-width: 1320px; }
  .board-page{
    padding-bottom: 22px;
    position: relative;
    font-family: 'Cairo', system-ui, sans-serif;
    color: var(--c-text);
  }
  .board-page *{ box-sizing: border-box; }

  /* ====================== BACKGROUND ====================== */
  .bb-bg{
    position: fixed; inset: 0;
    background: var(--c-bg);
    pointer-events: none;
    z-index: 0;
  }

  /* ====================== CARD BASE ====================== */
  .glass{
    background: #ffffff;
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-1);
    position: relative;
    z-index: 1;
  }

  .board-page > section{
    opacity: 0; transform: translateY(10px);
    animation: secIn .6s cubic-bezier(.2,.7,.2,1) forwards;
  }
  .board-page > section:nth-of-type(1){ animation-delay: .02s; }
  .board-page > section:nth-of-type(2){ animation-delay: .08s; }
  .board-page > section:nth-of-type(3){ animation-delay: .14s; }
  .board-page > section:nth-of-type(4){ animation-delay: .20s; }
  .board-page > section:nth-of-type(5){ animation-delay: .26s; }
  @keyframes secIn{ to{ opacity: 1; transform: translateY(0); } }

  /* ====================== CHIPS ====================== */
  .chip{
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px; font-weight: 700;
    background: rgba(255,255,255,.6);
    border: 1px solid rgba(15,23,42,.08);
    color: var(--c-text);
    text-decoration: none;
    transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .chip:hover{ background: #fff; }
  .chip-back:hover{ transform: translateX(2px); }
  .chip-honor{
    background: linear-gradient(135deg, var(--c-primary-soft), #fff);
    color: var(--c-primary);
    border-color: rgba(22,163,74,.25);
    font-weight: 800;
  }
  .chip-live{ color: var(--c-mute); }
  .live-dot{
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--c-primary);
    box-shadow: 0 0 0 0 rgba(22,163,74,.55);
    animation: livePulse 1.8s ease-out infinite;
  }
  @keyframes livePulse{
    0%   { box-shadow: 0 0 0 0   rgba(22,163,74,.5); }
    100% { box-shadow: 0 0 0 12px rgba(22,163,74,0); }
  }
  .chip-live.is-paused{
    background: #fef3f2;
    border-color: rgba(220,38,38,.25);
    color: #b91c1c;
  }
  .chip-live.is-paused .live-dot{
    background: #dc2626;
    animation: none;
    box-shadow: 0 0 0 3px rgba(220,38,38,.15);
  }

  .tier-chip{
    color: #fff;
    border: 1px solid transparent;
    background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold));
    box-shadow: var(--shadow-glow-gold);
    font-weight: 800;
    animation: tierGlow 2.6s ease-in-out infinite;
  }
  @keyframes tierGlow{
    0%,100%{ filter: brightness(1); }
    50%   { filter: brightness(1.15); }
  }
  .tier-chip .tier-ico{
    width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,.25); border-radius: 50%;
  }
  .tier-chip .tier-ico svg{ width: 11px; height: 11px; }
  .tier-chip.tier-diamond{ background: linear-gradient(135deg, #a78bfa, #6366f1); box-shadow: 0 10px 30px -10px rgba(99,102,241,.55); }
  .tier-chip.tier-gold   { background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold)); }
  .tier-chip.tier-silver { background: linear-gradient(135deg, var(--c-silver-2), var(--c-silver)); box-shadow: 0 10px 30px -10px rgba(148,163,184,.5); }
  .tier-chip.tier-bronze { background: linear-gradient(135deg, var(--c-bronze-2), var(--c-bronze)); box-shadow: 0 10px 30px -10px rgba(182,97,44,.45); }
  .tier-chip.tier-grow   { background: linear-gradient(135deg, var(--c-primary-2), var(--c-primary)); box-shadow: var(--shadow-glow-green); }

  /* ====================== HERO ====================== */
  .hero-card{
    border-radius: var(--r-lg);
    padding: 18px 22px 18px;
    margin: 4px 0 14px;
    overflow: hidden;
  }
  .hero-top{
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .hero-main{
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: center;
    margin-bottom: 16px;
  }
  .hero-left{ min-width: 0; }
  .hero-greet{
    display: inline-block;
    font-size: 12px; font-weight: 700;
    color: var(--c-primary);
    background: var(--c-primary-soft);
    border: 1px solid rgba(22,163,74,.22);
    padding: 4px 11px;
    border-radius: 999px;
    margin-bottom: 8px;
  }
  .hero-title{
    margin: 0;
    font-size: clamp(24px, 3.2vw, 38px);
    font-weight: 900;
    line-height: 1.1;
    color: var(--c-text);
    letter-spacing: -.2px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    background: linear-gradient(135deg, #0f172a 30%, #334155);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub{
    color: var(--c-text-2);
    font-size: 13.5px; font-weight: 600;
    margin-top: 4px;
  }
  .hero-impact{
    margin-top: 12px;
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(135deg, #fff, var(--c-gold-soft));
    border: 1px solid rgba(212,160,23,.28);
    border-radius: 12px;
    padding: 8px 14px 8px 10px;
    font-size: 12.5px; font-weight: 700;
    color: var(--c-text);
    max-width: 100%;
    box-shadow: 0 4px 12px -4px rgba(212,160,23,.2);
  }
  .impact-ico{
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--c-amber); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    animation: heartBeat 1.8s ease-in-out infinite;
  }
  @keyframes heartBeat{
    0%,100%{ transform: scale(1); }
    25%   { transform: scale(1.12); }
    50%   { transform: scale(.95); }
    75%   { transform: scale(1.08); }
  }

  .hero-right{ display: flex; align-items: center; justify-content: flex-end; }
  .hero-trophy{
    position: relative;
    width: 130px; height: 130px;
    display: flex; align-items: center; justify-content: center;
    animation: trophyFloat 4s ease-in-out infinite;
  }
  @keyframes trophyFloat{
    0%,100%{ transform: translateY(0) rotate(-2deg); }
    50%   { transform: translateY(-8px) rotate(2deg); }
  }
  .trophy-glow{
    position: absolute; inset: 10px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(251,191,36,.5), transparent 70%);
    filter: blur(20px);
    animation: trophyGlow 3s ease-in-out infinite;
  }
  @keyframes trophyGlow{
    0%,100%{ opacity: .6; transform: scale(1); }
    50%   { opacity: 1;  transform: scale(1.15); }
  }
  .trophy-spark{
    position: absolute;
    width: 6px; height: 6px; border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px 2px rgba(255,255,255,.9);
    animation: sparkPing 2s ease-in-out infinite;
  }
  .trophy-spark-1{ top: 8%;  right: 18%; animation-delay: .2s; }
  .trophy-spark-2{ top: 30%; left: 8%;   animation-delay: .9s; width: 4px; height: 4px; }
  .trophy-spark-3{ top: 55%; right: 6%;  animation-delay: 1.4s; width: 5px; height: 5px; }
  @keyframes sparkPing{
    0%,100%{ transform: scale(.4); opacity: .2; }
    50%   { transform: scale(1.4); opacity: 1; }
  }

  /* HERO STATS */
  .hero-stats{
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .stat-card{
    position: relative;
    background: linear-gradient(135deg, #fff, color-mix(in srgb, var(--c1) 8%, #fff));
    border: 1px solid rgba(15,23,42,.06);
    border-radius: var(--r-md);
    padding: 12px 14px;
    display: flex; align-items: center; gap: 12px;
    overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .stat-card::before{
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(135deg, transparent, color-mix(in srgb, var(--c2) 8%, transparent));
    opacity: .5;
    pointer-events: none;
  }
  .stat-card::after{
    content: "";
    position: absolute;
    inset: auto -20px -30px auto;
    width: 110px; height: 110px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--c1) 22%, transparent), transparent 70%);
    transition: transform .35s ease;
  }
  .stat-card:hover{
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--c1) 30%, transparent);
    box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--c1) 35%, transparent);
  }
  .stat-card:hover::after{ transform: scale(1.25); }
  .stat-ico{
    width: 44px; height: 44px; border-radius: 12px;
    background: linear-gradient(135deg, var(--c1), var(--c2));
    color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--c1) 45%, transparent);
    position: relative; z-index: 1;
  }
  .stat-ico svg{ width: 22px; height: 22px; }
  .stat-body{ position: relative; z-index: 1; min-width: 0; }
  .stat-val{
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 900; line-height: 1;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }
  .stat-lbl{
    font-size: 11.5px; color: var(--c-mute); font-weight: 600;
    margin-top: 4px;
  }

  /* ====================== ACHIEVEMENTS STRIP ====================== */
  .ach-card{
    margin: 10px 0 4px;
    border-radius: var(--r-md);
    padding: 12px 16px 14px;
    position: relative;
    overflow: hidden;
  }
  .ach-card::after{
    content: "";
    position: absolute;
    inset: 0 0 auto 0; height: 3px;
    background: linear-gradient(90deg, var(--c-gold), var(--c-primary), var(--c-purple), var(--c-rose), var(--c-gold));
    background-size: 200% 100%;
    animation: rainbowFlow 6s linear infinite;
  }
  @keyframes rainbowFlow{
    0%   { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }
  .ach-head{
    display: flex; align-items: center; gap: 8px;
    margin-bottom: 10px;
    font-size: 13px; font-weight: 800; color: var(--c-text);
  }
  .ach-head-ico{
    width: 22px; height: 22px; border-radius: 7px;
    background: var(--c-gold-soft); color: var(--c-gold);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ach-thread{ flex: 1; height: 1px; background: linear-gradient(90deg, var(--c-border), transparent); }
  .ach-row{ display: flex; gap: 8px; flex-wrap: wrap; }
  .ach-chip{
    display: inline-flex; align-items: center; gap: 7px;
    padding: 6px 13px 6px 7px;
    border-radius: 999px;
    font-size: 12px; font-weight: 800;
    background: #fff;
    border: 1px solid var(--c-border);
    color: var(--c-text);
    animation: chipIn .5s cubic-bezier(.2,.7,.2,1) backwards;
  }
  .ach-chip:nth-child(1){ animation-delay: .05s; }
  .ach-chip:nth-child(2){ animation-delay: .12s; }
  .ach-chip:nth-child(3){ animation-delay: .18s; }
  .ach-chip:nth-child(4){ animation-delay: .24s; }
  .ach-chip:nth-child(5){ animation-delay: .30s; }
  .ach-chip:nth-child(6){ animation-delay: .36s; }
  @keyframes chipIn{
    from{ opacity: 0; transform: translateY(8px) scale(.94); }
    to  { opacity: 1; transform: translateY(0)   scale(1); }
  }
  .ach-ico{
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--c-gold-soft); color: var(--c-gold);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ach-ico svg{ width: 14px; height: 14px; }
  .ach-chip.is-green  .ach-ico{ background: var(--c-primary-soft); color: var(--c-primary); }
  .ach-chip.is-purple .ach-ico{ background: var(--c-purple-soft);  color: var(--c-purple); }
  .ach-chip.is-blue   .ach-ico{ background: var(--c-blue-soft);    color: var(--c-blue); }
  .ach-chip.is-amber  .ach-ico{ background: #fff1f1;                color: #dc2626; }
  .ach-chip.is-crown{
    background: linear-gradient(135deg, var(--c-gold-soft), #fff);
    border-color: rgba(212,160,23,.35);
    color: #6b4d00;
    box-shadow: 0 4px 12px -4px rgba(212,160,23,.4);
  }
  .ach-chip.is-crown .ach-ico{ background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold)); color: #fff; }

  /* ====================== SECTION HEAD ====================== */
  .sec{ margin-top: 16px; position: relative; z-index: 1; }
  .sec-head{
    display: flex; align-items: center; gap: 9px;
    margin: 0 4px 10px;
  }
  .sec-head h2{
    margin: 0; font-size: 16px; font-weight: 800; color: var(--c-text);
  }
  .sec-ico{
    width: 30px; height: 30px; border-radius: 9px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .sec-ico-gold{ background: var(--c-gold-soft); color: var(--c-gold); }
  .sec-ico-green{ background: var(--c-primary-soft); color: var(--c-primary); }
  .sec-pill{
    background: #fff; border: 1px solid var(--c-border);
    color: var(--c-mute); border-radius: 999px;
    padding: 3px 11px; font-size: 12px; font-weight: 700;
  }
  .sec-spark{
    margin-inline-start: auto;
    color: var(--c-gold);
    animation: sparkSpin 4s linear infinite;
  }
  @keyframes sparkSpin{
    0%  { transform: rotate(0deg)   scale(1);  opacity: .65; }
    50% { transform: rotate(180deg) scale(1.2); opacity: 1; }
    100%{ transform: rotate(360deg) scale(1);  opacity: .65; }
  }

  /* ====================== RANK + HONOR ROW ====================== */
  .honor-row{
    display: grid; gap: 12px;
    grid-template-columns: 1fr 1.3fr 1.3fr;
  }

  .rank-card{
    border-radius: var(--r-md);
    padding: 18px 16px 16px;
    overflow: hidden;
    position: relative;
    text-align: center;
    transition: box-shadow .3s ease, transform .3s ease;
  }
  .rank-card-bg{
    position: absolute; inset: 0;
    background:
      radial-gradient(360px 200px at 50% -10%, rgba(212,160,23,.18), transparent 70%),
      radial-gradient(280px 200px at 50% 110%, rgba(22,163,74,.15), transparent 70%);
    pointer-events: none;
  }
  .rank-card.is-champion{
    box-shadow: 0 16px 40px -12px rgba(212,160,23,.4), var(--shadow-2);
    border-color: rgba(212,160,23,.35);
  }
  .rank-card.is-champion .rank-card-bg{
    background:
      radial-gradient(460px 280px at 50% -10%, rgba(212,160,23,.32), transparent 70%),
      radial-gradient(280px 200px at 50% 110%, rgba(212,160,23,.18), transparent 70%);
  }
  .rank-head{ position: relative; z-index: 1; }
  .rank-head-l{ font-size: 12px; color: var(--c-mute); font-weight: 700; }
  .rank-head-kind{
    font-size: 14px; font-weight: 800; color: var(--c-text);
    margin-top: 2px;
  }

  .rank-ring-wrap{
    position: relative; width: 200px; height: 200px;
    margin: 12px auto 6px;
    z-index: 1;
  }
  .rank-ring{ width: 100%; height: 100%; }
  #ringFg{ transition: stroke-dashoffset 1.4s cubic-bezier(.4, .8, .2, 1); }
  .rank-ring-center{
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    pointer-events: none;
  }
  .rank-num{
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 900; line-height: 1;
    background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold) 55%, #92560c);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    font-variant-numeric: tabular-nums;
    letter-spacing: -1px;
    filter: drop-shadow(0 2px 4px rgba(212,160,23,.25));
  }
  .rank-sub{
    margin-top: 4px;
    font-size: 12px; color: var(--c-mute); font-weight: 700;
  }
  .rank-sub b{ color: var(--c-text); font-size: 14px; font-variant-numeric: tabular-nums; }

  .rank-crown{
    position: absolute; top: -10px; left: 50%;
    transform: translateX(-50%);
    width: 38px; height: 38px; border-radius: 50%;
    background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold));
    color: #fff;
    display: none;
    align-items: center; justify-content: center;
    box-shadow: 0 6px 20px -4px rgba(212,160,23,.55), 0 0 0 4px rgba(255,255,255,.6);
    animation: crownBob 2.4s ease-in-out infinite;
  }
  @keyframes crownBob{
    0%,100%{ transform: translate(-50%, 0) rotate(-4deg); }
    50%   { transform: translate(-50%, -5px) rotate(4deg); }
  }
  .rank-card.is-champion .rank-crown{ display: inline-flex; }

  .rank-pct{
    margin-top: 4px;
    display: inline-flex; align-items: baseline; gap: 6px;
    position: relative; z-index: 1;
  }
  .rank-pct-v{
    font-size: 18px; font-weight: 900;
    color: var(--c-primary);
    font-variant-numeric: tabular-nums;
  }
  .rank-pct-l{ font-size: 11.5px; color: var(--c-mute); font-weight: 700; }
  .rank-hint{
    margin-top: 8px;
    font-size: 12px; font-weight: 700; color: var(--c-text-2);
    min-height: 18px;
    position: relative; z-index: 1;
  }
  .rank-milestone{
    margin-top: 10px;
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,.7);
    border: 1px dashed rgba(22,163,74,.35);
    color: var(--c-primary);
    padding: 5px 11px;
    border-radius: 10px;
    font-size: 11.5px; font-weight: 800;
    position: relative; z-index: 1;
  }

  /* ====================== HONOR / PODIUM ====================== */
  .honor-card{
    border-radius: var(--r-md);
    padding: 14px 12px 16px;
    min-width: 0;
    transition: box-shadow .25s ease, transform .25s ease;
  }
  .honor-card:hover{ transform: translateY(-2px); box-shadow: 0 12px 30px -10px rgba(15,23,42,.12); }
  .honor-head{
    display: flex; align-items: center; gap: 7px;
    margin: 0 4px 20px;
  }
  .honor-head h3{
    margin: 0; font-size: 14px; font-weight: 800; color: var(--c-text);
  }
  .honor-ico{
    width: 26px; height: 26px; border-radius: 8px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .honor-ico-gold{ background: var(--c-gold-soft); color: var(--c-gold); }
  .honor-ico-green{ background: var(--c-primary-soft); color: var(--c-primary); }
  .honor-sub{
    margin-inline-start: auto;
    font-size: 11px; color: var(--c-mute); font-weight: 700;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    max-width: 50%;
  }

  .podium{
    display: grid; gap: 8px;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: end;
  }
  .podium-empty{
    grid-column: 1 / -1; text-align: center;
    color: var(--c-mute);
    background: rgba(255,255,255,.5);
    border: 1px dashed var(--c-border);
    border-radius: 12px; padding: 16px; font-size: 12px;
  }
  .podium-item{
    position: relative;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 16px 8px 12px;
    text-align: center;
    min-width: 0;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    animation: podiumIn .55s ease both;
  }
  .podium-item.rank-1{ animation-delay: .18s; }
  .podium-item.rank-2{ animation-delay: .06s; }
  .podium-item.rank-3{ animation-delay: .28s; }
  @keyframes podiumIn{
    from{ opacity: 0; transform: translateY(12px) scale(.96); }
    to  { opacity: 1; transform: translateY(0)    scale(1); }
  }
  .podium-item:hover{ transform: translateY(-4px); box-shadow: var(--shadow-2); }
  .podium-item.is-current{
    border-color: rgba(22,163,74,.6);
    background: linear-gradient(180deg, #fff, var(--c-primary-soft));
    box-shadow: 0 10px 26px -10px rgba(22,163,74,.4);
  }

  .podium-medal{
    position: absolute;
    top: -18px; left: 50%; transform: translateX(-50%);
    width: 36px; height: 36px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold));
    box-shadow: 0 6px 18px -4px rgba(212,160,23,.5), 0 0 0 3px #fff;
  }
  .podium-item.rank-2 .podium-medal{ background: linear-gradient(135deg, var(--c-silver-2), var(--c-silver)); box-shadow: 0 6px 18px -4px rgba(148,163,184,.55), 0 0 0 3px #fff; }
  .podium-item.rank-3 .podium-medal{ background: linear-gradient(135deg, var(--c-bronze-2), var(--c-bronze)); box-shadow: 0 6px 18px -4px rgba(182,97,44,.5), 0 0 0 3px #fff; }

  .podium-item.rank-1{
    order: 2;
    transform: translateY(-10px);
    border-color: rgba(212,160,23,.45);
    background: linear-gradient(180deg, #fff, var(--c-gold-soft));
    box-shadow: 0 14px 32px -10px rgba(212,160,23,.4);
  }
  .podium-item.rank-2{
    order: 1;
    border-color: rgba(148,163,184,.4);
    background: linear-gradient(180deg, #fff, var(--c-silver-soft));
  }
  .podium-item.rank-3{
    order: 3;
    border-color: rgba(182,97,44,.4);
    background: linear-gradient(180deg, #fff, var(--c-bronze-soft));
  }

  /* تاج للمركز الأول */
  .podium-item.rank-1::before{
    content: "";
    position: absolute;
    top: -42px; left: 50%; transform: translateX(-50%);
    width: 30px; height: 22px;
    background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold));
    clip-path: polygon(0 100%, 0 40%, 25% 70%, 50% 0, 75% 70%, 100% 40%, 100% 100%);
    filter: drop-shadow(0 4px 6px rgba(212,160,23,.5));
    animation: crownBob 2.4s ease-in-out infinite;
  }

  .podium-name{
    margin-top: 18px;
    font-size: 12.5px; font-weight: 800; color: var(--c-text);
    line-height: 1.3;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    min-height: 32px;
    padding: 0 4px;
  }
  .podium-sub{
    font-size: 10.5px; color: var(--c-mute); margin-top: 3px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding: 0 4px;
  }
  .podium-pills{
    margin-top: 10px;
    display: flex; gap: 4px; justify-content: center; flex-wrap: wrap;
  }
  .podium-pill{
    background: rgba(255,255,255,.7);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 2px 9px;
    font-size: 10.5px; font-weight: 800;
    color: var(--c-text);
  }
  .podium-pill b{ color: var(--c-primary); font-variant-numeric: tabular-nums; }
  .is-you-tag{
    position: absolute;
    top: -10px; inset-inline-end: -6px;
    background: var(--c-primary); color: #fff;
    font-size: 9.5px; font-weight: 800;
    padding: 2px 9px;
    border-radius: 999px;
    box-shadow: 0 4px 10px -2px rgba(22,163,74,.5);
    animation: tagPop .5s ease;
  }
  @keyframes tagPop{
    from{ transform: scale(.5); opacity: 0; }
    to{   transform: scale(1);  opacity: 1; }
  }

  /* ====================== AMBASSADORS GRID ====================== */
  .amb-grid{
    display: grid; gap: 10px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .amb-card{
    position: relative;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 14px 10px 12px;
    text-align: center;
    overflow: hidden;
    min-width: 0;
    transition: transform .2s ease, border-color .2s ease, box-shadow .25s ease;
    animation: cardIn .45s cubic-bezier(.2,.7,.2,1) both;
  }
  .amb-card:nth-child(1){ animation-delay: .02s; }
  .amb-card:nth-child(2){ animation-delay: .06s; }
  .amb-card:nth-child(3){ animation-delay: .10s; }
  .amb-card:nth-child(4){ animation-delay: .14s; }
  .amb-card:nth-child(5){ animation-delay: .18s; }
  .amb-card:nth-child(6){ animation-delay: .22s; }
  .amb-card:nth-child(7){ animation-delay: .26s; }
  .amb-card:nth-child(8){ animation-delay: .30s; }
  .amb-card:nth-child(9){ animation-delay: .34s; }
  .amb-card:nth-child(10){ animation-delay: .38s; }
  @keyframes cardIn{
    from{ opacity: 0; transform: translateY(10px); }
    to  { opacity: 1; transform: translateY(0); }
  }
  .amb-card:hover{
    transform: translateY(-3px);
    border-color: rgba(22,163,74,.3);
    box-shadow: 0 12px 28px -10px rgba(15,23,42,.14);
  }
  .amb-card.top-1{
    background: linear-gradient(180deg, #fff, var(--c-gold-soft));
    border-color: rgba(212,160,23,.45);
    box-shadow: 0 10px 26px -10px rgba(212,160,23,.35);
  }
  .amb-card.top-2{
    background: linear-gradient(180deg, #fff, var(--c-silver-soft));
    border-color: rgba(148,163,184,.4);
  }
  .amb-card.top-3{
    background: linear-gradient(180deg, #fff, var(--c-bronze-soft));
    border-color: rgba(182,97,44,.4);
  }
  .amb-card.top-1::after{
    content: "";
    position: absolute; top: -60px; right: -60px;
    width: 140px; height: 140px;
    background: radial-gradient(circle, rgba(212,160,23,.3), transparent 70%);
    border-radius: 50%;
    animation: rankPulse 3s ease-in-out infinite;
  }
  @keyframes rankPulse{
    0%,100%{ transform: scale(1);   opacity: .8; }
    50%   { transform: scale(1.12); opacity: 1; }
  }

  .amb-rank-chip{
    position: absolute;
    top: 10px; inset-inline-start: 10px;
    width: 26px; height: 26px; border-radius: 8px;
    background: #f1f5f9; color: var(--c-text);
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 12px;
    font-variant-numeric: tabular-nums;
    z-index: 2;
  }
  .amb-card.top-1 .amb-rank-chip{ background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold)); color: #fff; }
  .amb-card.top-2 .amb-rank-chip{ background: linear-gradient(135deg, var(--c-silver-2), var(--c-silver)); color: #fff; }
  .amb-card.top-3 .amb-rank-chip{ background: linear-gradient(135deg, var(--c-bronze-2), var(--c-bronze)); color: #fff; }

  .amb-avatar{
    position: relative;
    width: 56px; height: 56px; border-radius: 50%;
    margin: 0 auto 10px;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    font-size: 17px; font-weight: 800;
    background: linear-gradient(135deg, var(--av1, #6366f1), var(--av2, #a855f7));
    box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--av1, #6366f1) 50%, transparent), 0 0 0 3px #fff;
    z-index: 1;
  }
  .amb-card.top-1 .amb-avatar{
    --av1: var(--c-gold-2);
    --av2: var(--c-gold);
    box-shadow: 0 8px 18px -4px rgba(212,160,23,.55), 0 0 0 3px #fff;
  }
  .amb-card.top-2 .amb-avatar{
    --av1: var(--c-silver-2);
    --av2: var(--c-silver);
  }
  .amb-card.top-3 .amb-avatar{
    --av1: var(--c-bronze-2);
    --av2: var(--c-bronze);
  }
  .amb-card.top-1 .amb-avatar::before{
    content: "";
    position: absolute; top: -22px; left: 50%; transform: translateX(-50%);
    width: 22px; height: 16px;
    background: linear-gradient(135deg, var(--c-gold-2), var(--c-gold));
    clip-path: polygon(0 100%, 0 40%, 25% 70%, 50% 0, 75% 70%, 100% 40%, 100% 100%);
    filter: drop-shadow(0 3px 4px rgba(212,160,23,.5));
  }

  .amb-name{
    font-size: 13px; font-weight: 800;
    color: var(--c-text);
    line-height: 1.3;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    min-height: 34px;
    padding: 0 4px;
    position: relative; z-index: 1;
  }
  .amb-meta{
    margin-top: 8px;
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,.7);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 11px; font-weight: 800;
    color: var(--c-text-2);
    position: relative; z-index: 1;
  }
  .amb-meta b{ color: var(--c-primary); font-variant-numeric: tabular-nums; font-size: 12px; }
