<script defer src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
<script src="/js/app.js"></script>
<script>
const ENTITY_ID = <%- JSON.stringify(entityId) %>;
const REFRESH_MS = 60 * 1000;

// تحكّم لحظي من لوحة الأدمن
let BOARD_INITIAL_VERSION = null;   // أول نسخة شوفناها — أي تغيّر يعني "أعد التحميل"
let refreshTimer = null;            // مؤقت التحديث التلقائي
let isPaused = false;

const esc = (v) => String(v == null ? '' : v)
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;');

function fmt(n){ return App.formatNumber(n || 0); }
function fmtAmount(n){
  const v = Number(n) || 0;
  if (v >= 1_000_000) return (v / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'م';
  if (v >= 1_000) return (v / 1_000).toFixed(1).replace(/\.0$/, '') + 'ك';
  return fmt(v);
}

function animateCount(el, target, opts){
  if (!el) return;
  const o = opts || {};
  const duration = o.duration || 1100;
  const isAmount = !!o.amount;
  const t0 = performance.now();
  const tick = (now) => {
    const t = Math.min(1, (now - t0) / duration);
    const eased = 1 - Math.pow(1 - t, 3);
    const v = target * eased;
    el.textContent = isAmount ? fmtAmount(v) : fmt(Math.round(v));
    if (t < 1) requestAnimationFrame(tick);
    else el.textContent = isAmount ? fmtAmount(target) : fmt(target);
  };
  requestAnimationFrame(tick);
}

function greetingText(){
  const h = new Date().getHours();
  if (h >= 5 && h < 12) return 'صباح العطاء ☀️';
  if (h >= 12 && h < 17) return 'نهار مثمر 🌿';
  if (h >= 17 && h < 21) return 'مساء النور ✨';
  return 'ليلة مباركة 🌙';
}

function tierFor(position, total){
  if (!position || !total) return null;
  if (position === 1) return { cls: 'tier-diamond', label: 'قائد الفئة', icon: 'crown' };
  if (position <= 3)  return { cls: 'tier-gold',    label: 'منصة التتويج', icon: 'trophy' };
  const pct = ((total - position + 1) / total) * 100;
  if (position <= 10 || pct >= 90) return { cls: 'tier-gold',   label: 'ضمن المتقدمين', icon: 'star' };
  if (pct >= 75) return { cls: 'tier-silver', label: 'النخبة الفضية', icon: 'star' };
  if (pct >= 50) return { cls: 'tier-bronze', label: 'في النصف الأعلى', icon: 'up' };
  return { cls: 'tier-grow', label: 'في طريق النمو', icon: 'spark' };
}
function tierIconSvg(name){
  const map = {
    crown:  '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M3 19h18v2H3v-2zm0-9l4 3 5-7 5 7 4-3v8H3v-8z"/></svg>',
    trophy: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M5 3h14l-1 6a6 6 0 01-5 5.92V18h3v2H8v-2h3v-3.08A6 6 0 016 9L5 3z"/></svg>',
    star:   '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3 6.3 6.9 1L17 14l1.2 7L12 17.8 5.8 21 7 14l-4.9-4.7 6.9-1z"/></svg>',
    up:     '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M3 17l6-6 4 4 7-7v6h2V4h-8v2h4l-5 5-4-4-8 8z"/></svg>',
    spark:  '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l1.5 5.5L19 9l-5.5 1.5L12 16l-1.5-5.5L5 9l5.5-1.5L12 2z"/></svg>'
  };
  return map[name] || map.star;
}

function buildAchievements(c, rk){
  const list = [];
  const amb = Number(c.ambassadorsCount) || 0;
  const fnd = Number(c.fundsCount) || 0;
  const ttl = Number(c.totalDonations) || 0;

  if (amb >= 1){
    let label = amb >= 50 ? '٥٠+ سفير' : amb >= 25 ? '٢٥+ سفير' : amb >= 10 ? '١٠+ سفراء' : amb >= 5 ? '٥+ سفراء' : 'سفراؤنا الأوائل';
    list.push({ cls: 'is-green', icon: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M16 11a4 4 0 10-4-4 4 4 0 004 4zm-8 0a4 4 0 10-4-4 4 4 0 004 4zm0 2c-2.7 0-8 1.3-8 4v3h10v-3c0-1 .3-1.9.8-2.7C9.6 13.4 8.6 13 8 13zm8 0c-.3 0-.7 0-1.2.1A5.7 5.7 0 0116 17v3h8v-3c0-2.7-5.3-4-8-4z"/></svg>', label });
  }
  if (fnd >= 1){
    let label = fnd >= 200 ? '٢٠٠+ صندوق' : fnd >= 100 ? '١٠٠+ صندوق' : fnd >= 50 ? '٥٠+ صندوق' : fnd >= 20 ? '٢٠+ صندوق' : 'انطلاق الصناديق';
    list.push({ cls: 'is-purple', icon: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 8h-3V6a2 2 0 00-2-2H9a2 2 0 00-2 2v2H4a1 1 0 00-1 1v9a3 3 0 003 3h12a3 3 0 003-3V9a1 1 0 00-1-1zM9 6h6v2H9V6z"/></svg>', label });
  }
  if (ttl >= 1){
    list.push({ cls: '', icon: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>', label: 'إجمالي ' + fmtAmount(ttl) });
  }
  const pos = Number(rk.position) || 0;
  const tot = Number(rk.total) || 0;
  if (pos === 1){
    list.push({ cls: 'is-crown', icon: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M3 19h18v2H3v-2zm0-9l4 3 5-7 5 7 4-3v8H3v-8z"/></svg>', label: 'الأولى على الفئة' });
  } else if (pos > 0 && pos <= 3){
    list.push({ cls: 'is-amber', icon: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M5 3h14l-1 6a6 6 0 01-5 5.92V18h3v2H8v-2h3v-3.08A6 6 0 016 9L5 3z"/></svg>', label: 'ضمن أفضل 3' });
  } else if (pos > 0 && pos <= 10){
    list.push({ cls: 'is-blue', icon: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3 6.3 6.9 1L17 14l1.2 7L12 17.8 5.8 21 7 14l-4.9-4.7 6.9-1z"/></svg>', label: 'ضمن أفضل 10' });
  }
  if (tot > 0 && pos > 0){
    const pct = Math.round(((tot - pos + 1) / tot) * 100);
    if (pct >= 90 && pos > 3) list.push({ cls: '', icon: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M3 17l6-6 4 4 7-7v6h2V4h-8v2h4l-5 5-4-4-8 8z"/></svg>', label: 'تفوّق ' + pct + '%' });
  }
  return list;
}
function renderAchievements(c, rk){
  const wrap = document.getElementById('achWrap');
  const row = document.getElementById('achRow');
  const items = buildAchievements(c, rk);
  if (!items.length){ wrap.style.display = 'none'; return; }
  wrap.style.display = '';
  row.innerHTML = items.map(it => `
    <span class="ach-chip ${it.cls}">
      <span class="ach-ico">${it.icon}</span>
      <span>${esc(it.label)}</span>
    </span>
  `).join('');
}

function initialsOf(name){
  if (!name) return '؟';
  const parts = String(name).trim().split(/\s+/).filter(Boolean).slice(0, 2);
  return parts.map(p => p[0] || '').join('') || '؟';
}
const AV_PALETTE = [
  ['#6366f1', '#a855f7'],
  ['#0ea5e9', '#06b6d4'],
  ['#10b981', '#14b8a6'],
  ['#f59e0b', '#ef4444'],
  ['#ec4899', '#f43f5e'],
  ['#8b5cf6', '#6366f1'],
  ['#f97316', '#f59e0b'],
  ['#14b8a6', '#0ea5e9']
];
function avatarColors(name){
  const s = String(name || '');
  let h = 0;
  for (let i = 0; i < s.length; i++){
    h = ((h << 5) - h) + s.charCodeAt(i);
    h |= 0;
  }
  return AV_PALETTE[Math.abs(h) % AV_PALETTE.length];
}

function podiumItem(entry, kind){
  const cls = `podium-item rank-${entry.rank}`;
  const isMe = entry.isCurrent || entry.isCurrentEntity;
  const youTag = isMe ? `<span class="is-you-tag">جهتنا</span>` : '';
  if (kind === 'center'){
    return `
      <div class="${cls}${isMe ? ' is-current' : ''}">
        ${youTag}
        <div class="podium-medal">${entry.rank}</div>
        <div class="podium-name">${esc(entry.name)}</div>
        <div class="podium-pills">
          <span class="podium-pill">سفراء <b>${fmt(entry.ambassadorsCount)}</b></span>
          <span class="podium-pill">صناديق <b>${fmt(entry.fundsCount)}</b></span>
        </div>
      </div>`;
  }
  return `
    <div class="${cls}${isMe ? ' is-current' : ''}">
      ${youTag}
      <div class="podium-medal">${entry.rank}</div>
      <div class="podium-name">${esc(entry.name || 'سفير')}</div>
      <div class="podium-sub">${esc(entry.entityName || '')}</div>
      <div class="podium-pills">
        <span class="podium-pill">صناديق <b>${fmt(entry.fundsCount)}</b></span>
      </div>
    </div>`;
}
function renderPodium(elId, list, kind){
  const el = document.getElementById(elId);
  if (!list || !list.length){
    el.innerHTML = `<div class="podium-empty">لا توجد بيانات كافية للعرض بعد.</div>`;
    return;
  }
  el.innerHTML = list.map(item => podiumItem(item, kind)).join('');
}

function rankHintText(pos, total){
  if (!pos || !total) return '';
  if (pos === 1) return '🏆 الجهة الأولى — استمروا في القمة!';
  if (pos <= 3) return '✨ ضمن أفضل 3 جهات — خطوة واحدة للقمة!';
  if (pos <= 10) return '⭐ ضمن أفضل 10 جهات — أداء متميز.';
  const half = Math.ceil(total / 2);
  if (pos <= half) return '📈 ضمن النصف الأعلى — يمكن الصعود أكثر.';
  return '🌱 هناك مساحة كبيرة للنمو — لنرتقِ معًا!';
}
function nextMilestoneText(pos, total){
  if (!pos || !total) return '';
  if (pos === 1) return 'في الصدارة — حافظوا على الإنجاز';
  if (pos <= 3)  return 'خطوة واحدة فقط للوصول للمركز الأول';
  if (pos <= 10) return `${pos - 3} ${pos - 3 === 1 ? 'مرتبة' : 'مراتب'} للوصول لمنصة التتويج`;
  const half = Math.ceil(total / 2);
  if (pos <= half) return `${pos - 10} مرتبة للوصول لأفضل 10`;
  return `${pos - half} مرتبة لتجاوز النصف`;
}

function impactText(c){
  const fnd = Number(c.fundsCount) || 0;
  const ttl = Number(c.totalDonations) || 0;
  const amb = Number(c.ambassadorsCount) || 0;
  if (ttl >= 1) return `بفضل الله ثم بجهودكم تم تيسير ${fmtAmount(ttl)} ريال عبر ${fmt(fnd)} ${fnd === 1 ? 'صندوق' : 'صندوقاً'}`;
  if (fnd >= 1) return `${fmt(fnd)} ${fnd === 1 ? 'صندوق' : 'صندوقاً'} ينتظر دعمكم لإحداث الأثر`;
  if (amb >= 1) return `${fmt(amb)} ${amb === 1 ? 'سفير' : 'سفراء'} على أهبة الاستعداد للعطاء`;
  return 'كل خطوة جديدة هي بداية أثر... لنبدأ معًا';
}

const AMB_LIMIT = 10;
function renderAmbassadors(list){
  const grid = document.getElementById('ambGrid');
  const empty = document.getElementById('ambEmpty');
  const more = document.getElementById('ambMore');
  const total = (list || []).length;
  document.getElementById('ambCountPill').textContent = fmt(total);
  if (!total){
    grid.innerHTML = '';
    more.style.display = 'none';
    empty.style.display = '';
    return;
  }
  empty.style.display = 'none';
  const shown = list.slice(0, AMB_LIMIT);
  grid.innerHTML = shown.map((a, i) => {
    const topCls = i === 0 ? 'top-1' : i === 1 ? 'top-2' : i === 2 ? 'top-3' : '';
    const [c1, c2] = avatarColors(a.name);
    const avStyle = !topCls ? `style="--av1:${c1};--av2:${c2};"` : '';
    return `
      <div class="amb-card ${topCls}">
        <div class="amb-rank-chip">${i + 1}</div>
        <div class="amb-avatar" ${avStyle}>${esc(initialsOf(a.name))}</div>
        <div class="amb-name">${esc(a.name || '-')}</div>
        <div class="amb-meta">
          <span class="amb-meta-ico">
            <svg viewBox="0 0 24 24" width="11" height="11"><path fill="currentColor" d="M20 8h-3V6a2 2 0 00-2-2H9a2 2 0 00-2 2v2H4a1 1 0 00-1 1v9a3 3 0 003 3h12a3 3 0 003-3V9a1 1 0 00-1-1zM9 6h6v2H9V6z"/></svg>
          </span>
          <span>صناديق <b>${fmt(a.fundsCount)}</b></span>
        </div>
      </div>`;
  }).join('');
  if (total > AMB_LIMIT){
    more.textContent = `+ ${fmt(total - AMB_LIMIT)} سفير آخرين`;
    more.style.display = '';
  } else {
    more.style.display = 'none';
  }
}

function applyTier(tier){
  const el = document.getElementById('heroTier');
  if (!el) return;
  if (!tier){ el.style.display = 'none'; return; }
  el.style.display = '';
  el.className = 'chip tier-chip ' + tier.cls;
  document.getElementById('heroTierIcon').innerHTML = tierIconSvg(tier.icon);
  document.getElementById('heroTierLabel').textContent = tier.label;
}

const RING_C = 2 * Math.PI * 50;
function setRingProgress(pct){
  const ring = document.getElementById('ringFg');
  if (!ring) return;
  const offset = RING_C * (1 - Math.max(0, Math.min(100, pct)) / 100);
  ring.style.strokeDasharray = RING_C;
  ring.style.strokeDashoffset = offset;
}

let didFireConfetti = false;
function fireConfetti(){
  if (didFireConfetti) return;
  if (typeof confetti !== 'function'){
    setTimeout(fireConfetti, 600);
    return;
  }
  didFireConfetti = true;
  const colors = ['#d4a017', '#fbbf24', '#16a34a', '#22c55e', '#7c3aed', '#ec4899', '#2563eb'];
  confetti({ particleCount: 90, spread: 70, startVelocity: 35, origin: { y: .35 }, colors });
  setTimeout(() => confetti({ particleCount: 60, spread: 100, origin: { x: 0.15, y: .5 }, colors }), 250);
  setTimeout(() => confetti({ particleCount: 60, spread: 100, origin: { x: 0.85, y: .5 }, colors }), 450);
}

const QUOTES = [
  '"إن الله يحب إذا عمل أحدكم عملاً أن يُتقنه" — كل صندوقٍ تعملونه أثرٌ يُكتب لكم.',
  'سفراؤكم هم نبض هذه الجهة... شكرًا لكل جهدٍ لا يُرى لكن أثره يُرى.',
  'كل تبرعٍ يصل بفضل الله ثم بسعيكم — فاثبتوا فإن الأثر يبدأ بخطوة.',
  'الجهة المتميزة لا تُقاس بحجمها بل بعمق أثرها في حياة الناس.',
  'قوافل الخير لا تتوقف ما دام هناك يدٌ تبذل وعقلٌ يخطط — فلكم منا التحية.',
  'لكل سفير: جهدك اليوم أملٌ لمحتاجٍ غدًا. واصل، فالطريق مضيء.',
  'المركز الأول هدف، لكن الأثر الحقيقي هو ما يبقى بعد أن تُطوى الأرقام.'
];
function rotateQuote(){
  const el = document.getElementById('bfQuote');
  if (!el) return;
  let i = Math.floor(Math.random() * QUOTES.length);
  el.style.opacity = '0';
  setTimeout(() => { el.textContent = QUOTES[i]; el.style.opacity = '1'; }, 200);
  setInterval(() => {
    i = (i + 1) % QUOTES.length;
    el.style.opacity = '0';
    setTimeout(() => { el.textContent = QUOTES[i]; el.style.opacity = '1'; }, 260);
  }, 8000);
}

let toastTimer;
function toast(msg){
  const t = document.getElementById('bfToast');
  if (!t) return;
  t.textContent = msg;
  t.classList.add('is-show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('is-show'), 2200);
}
function shareBoard(){
  const url = window.location.href;
  const title = document.getElementById('centerName').textContent || 'لوحة الشرف';
  const text = `لوحة شرف ${title}`;
  if (navigator.share){
    navigator.share({ title, text, url }).catch(() => {});
  } else if (navigator.clipboard){
    navigator.clipboard.writeText(url).then(
      () => toast('تم نسخ رابط اللوحة'),
      () => toast('تعذّر النسخ — انسخ الرابط يدويًا')
    );
  } else {
    toast('انسخ الرابط من شريط العنوان');
  }
}
function fmtRelativeTime(d){
  const diff = Math.max(0, (Date.now() - d.getTime()) / 1000);
  if (diff < 10) return 'قبل لحظات';
  if (diff < 60) return `قبل ${Math.round(diff)} ثانية`;
  if (diff < 3600) return `قبل ${Math.round(diff / 60)} دقيقة`;
  return `قبل ${Math.round(diff / 3600)} ساعة`;
}
let lastUpdatedAt = null;
function updateLastUpdatedLabel(){
  const el = document.getElementById('bfUpdated');
  if (!el || !lastUpdatedAt) return;
  el.textContent = 'آخر تحديث: ' + fmtRelativeTime(lastUpdatedAt);
}

function applyControl(control){
  if (!control || typeof control !== 'object') return;

  // أول مرة نشوف فيها النسخة — نخزّنها كمرجع
  if (BOARD_INITIAL_VERSION === null && control.version != null){
    BOARD_INITIAL_VERSION = control.version;
  }
  // الأدمن دفع نسخة جديدة → إعادة تحميل
  if (BOARD_INITIAL_VERSION !== null && control.version != null && control.version !== BOARD_INITIAL_VERSION){
    try { window.location.reload(); } catch(e){ window.location.href = window.location.href; }
    return;
  }
  // تغيير حالة الإيقاف
  if (control.paused && !isPaused){
    isPaused = true;
    if (refreshTimer){ clearInterval(refreshTimer); refreshTimer = null; }
    document.body.classList.add('bb-paused');
    setLiveBadge(false);
  } else if (!control.paused && isPaused){
    isPaused = false;
    document.body.classList.remove('bb-paused');
    setLiveBadge(true);
    startAutoRefresh();
  }
}

function setLiveBadge(isLive){
  const live = document.getElementById('liveTag');
  if (!live) return;
  if (isLive){
    live.classList.remove('is-paused');
    const label = live.querySelector('span:not(.live-dot)');
    if (label) label.textContent = 'تحديث مباشر';
  } else {
    live.classList.add('is-paused');
    const label = live.querySelector('span:not(.live-dot)');
    if (label) label.textContent = 'التحديث متوقف';
  }
}

function startAutoRefresh(){
  if (refreshTimer || isPaused) return;
  refreshTimer = setInterval(() => loadBoard(false), REFRESH_MS);
}

async function pollControlOnly(){
  // فحص خفيف للحالة عند الإيقاف — حتى لو معطّل التحديث الكامل، نقدر نلتقط أمر "استئناف" أو "أعد التحميل"
  try{
    const r = await fetch('/api/public/board-control', { cache: 'no-store' });
    if (!r.ok) return;
    const s = await r.json();
    applyControl(s);
  } catch(e){}
}

async function loadBoard(isFirst){
  try{
    const r = await fetch('/api/public/centers/' + encodeURIComponent(ENTITY_ID) + '/board', { cache: 'no-store' });
    if (!r.ok) throw new Error('failed');
    const d = await r.json();
    applyControl(d.control);

    const c = d.center || {};
    document.getElementById('centerName').textContent = c.name || '';
    document.getElementById('centerKind').textContent = c.kindLabel || '';
    document.getElementById('heroGreet').textContent = greetingText();

    const sAmb = document.getElementById('sAmb');
    const sFunds = document.getElementById('sFunds');
    const sTotal = document.getElementById('sTotal');
    if (isFirst){
      animateCount(sAmb,   Number(c.ambassadorsCount) || 0);
      animateCount(sFunds, Number(c.fundsCount) || 0);
      animateCount(sTotal, Number(c.totalDonations) || 0, { amount: true, duration: 1300 });
    } else {
      sAmb.textContent   = fmt(c.ambassadorsCount);
      sFunds.textContent = fmt(c.fundsCount);
      sTotal.textContent = fmtAmount(c.totalDonations);
    }

    const rk = d.rank || {};
    document.getElementById('rankKindLabel').textContent = rk.kindLabel || '—';
    document.getElementById('rankPos').textContent = rk.position ? fmt(rk.position) : '—';
    document.getElementById('rankTot').textContent = rk.total ? fmt(rk.total) : '—';

    const pct = rk.total ? Math.max(4, Math.round(((rk.total - rk.position + 1) / rk.total) * 100)) : 0;
    const pctSuper = rk.total && rk.position ? Math.round(((rk.total - rk.position) / rk.total) * 100) : 0;
    document.getElementById('rankPct').textContent = pctSuper + '%';
    document.getElementById('rankHint').textContent = rankHintText(rk.position, rk.total);

    const mileEl  = document.getElementById('rankMilestone');
    const mileTxt = document.getElementById('rankMilestoneText');
    if (rk.position && rk.total){
      mileTxt.textContent = nextMilestoneText(rk.position, rk.total);
      mileEl.style.display = '';
    } else {
      mileEl.style.display = 'none';
    }

    const rankCard = document.getElementById('rankCard');
    rankCard.classList.remove('is-champion');
    if (rk.position === 1) rankCard.classList.add('is-champion');

    setTimeout(() => setRingProgress(pct), 50);

    applyTier(tierFor(rk.position, rk.total));

    const impactEl = document.getElementById('heroImpact');
    const impactTextEl = document.getElementById('heroImpactText');
    const itext = impactText(c);
    if (itext){ impactTextEl.textContent = itext; impactEl.style.display = ''; }
    else { impactEl.style.display = 'none'; }

    renderAchievements(c, rk);

    document.getElementById('topCentersKind').textContent = rk.kindLabel || '';
    document.getElementById('topAmbsKind').textContent = 'ضمن ' + (rk.kindLabel || '');

    renderPodium('podiumCenters', d.topCenters || [], 'center');
    renderPodium('podiumAmbs', d.topAmbassadors || [], 'amb');
    renderAmbassadors(d.ambassadors || []);

    if (isFirst && rk.position && rk.position <= 3){
      setTimeout(fireConfetti, 700);
    }

    lastUpdatedAt = new Date();
    updateLastUpdatedLabel();

    if (isFirst) App.showContent();
  } catch (e){
    if (isFirst) App.showContent();
  }
}

document.getElementById('btnShare').addEventListener('click', shareBoard);
document.getElementById('btnPrint').addEventListener('click', () => window.print());

loadBoard(true).then(() => { startAutoRefresh(); });
rotateQuote();
setInterval(updateLastUpdatedLabel, 300 * 1000);
// فحص خفيف للتحكم كل 25 ثانية — يلتقط الاستئناف وإعادة التحميل حتى لو كان التحديث متوقفاً
setInterval(pollControlOnly, 600 * 1000);
</script>

