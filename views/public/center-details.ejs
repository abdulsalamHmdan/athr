<%- include('../partials/head') %>
<%- include('../partials/loader', { loaderType: 'table' }) %>

<div data-content style="display:none;">
  <div class="card">
    <a href="/centers" class="small" style="text-decoration:none;">← كل المجمعات</a>
    <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-top:6px;">
      <h2 style="margin:0;"><%= entityNameAr %></h2>
      <a href="/centers/<%= entityId %>/board" class="board-cta" title="عرض الصفحة التحفيزية على شاشة الجهة">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill="currentColor" d="M3 4h18a1 1 0 011 1v11a1 1 0 01-1 1h-7l1 3h2v2H7v-2h2l1-3H3a1 1 0 01-1-1V5a1 1 0 011-1zm1 2v9h16V6H4z"/>
        </svg>
        <span>عرض على الشاشة</span>
      </a>
    </div>
    <%- include('../partials/sync-status') %>
    <div class="stat-grid" style="margin-top:10px;">
      <div class="stat"><div class="v" id="s_amb">0</div><div class="l">عدد السفراء</div></div>
      <div class="stat"><div class="v" id="s_total">0</div><div class="l">مجموع المبالغ (ريال)</div></div>
      <div class="stat"><div class="v" id="s_funds">0</div><div class="l">عدد الصناديق</div></div>
      <div class="stat"><div class="v" id="s_completed">0</div><div class="l">الصناديق المكتملة</div></div>
    </div>
  </div>

  <style>
    .board-cta{
      display:inline-flex; align-items:center; gap:6px;
      background:#16a34a; color:#fff; text-decoration:none;
      padding:8px 14px; border-radius:10px;
      font-size:13px; font-weight:700;
      transition: filter .15s ease, transform .15s ease;
    }
    .board-cta:hover{ filter: brightness(.95); }
    .board-cta:active{ transform: translateY(1px); }
  </style>

  <div class="card">
    <h2>قائمة السفراء</h2>
    <p class="small">مرتّبة من الأعلى إلى الأقل حسب إجمالي التبرعات.</p>
    <div class="toolbar">
      <div class="search">
        <input type="search" id="q" placeholder="ابحث باسم السفير…" autocomplete="off">
      </div>
    </div>
    <div class="table-wrap has-cards">
      <table class="table-cards">
        <thead>
          <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>عدد الصناديق</th>
            <th>إجمالي التبرعات</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
const ENTITY_ID = <%- JSON.stringify(entityId) %>;
let ambassadors = [];
const esc = (v) => String(v == null ? '' : v)
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;');

function fmt(n){ return App.formatNumber(n || 0); }

function render(list){
  const tb = document.getElementById('tbody');
  if (!list.length){
    tb.innerHTML = '<tr><td colspan="5" class="table-empty">لا يوجد سفراء في هذا المجمع</td></tr>';
    return;
  }
  tb.innerHTML = list.map((a, i) => `
    <tr>
      <td data-label="التسلسل"><span class="table-value is-number">${i + 1}</span></td>
      <td data-label="الاسم"><span class="table-value is-ellipsis">${esc(a.name || '-')}</span></td>
      <td data-label="عدد الصناديق"><span class="table-value is-number">${fmt(a.fundsCount)}</span></td>
      <td data-label="إجمالي التبرعات"><span class="table-value is-number">***</span></td>
    </tr>
  `).join('');
}

document.getElementById('q').addEventListener('input', (e) => {
  const q = e.target.value.trim();
  if (!q) return render(ambassadors);
  render(ambassadors.filter(a => (a.name || '').includes(q)));
});

(async function(){
  const r = await fetch('/api/public/centers/' + encodeURIComponent(ENTITY_ID));
  const d = await r.json();
  const c = d.center || {};
  document.getElementById('s_amb').textContent = fmt(c.ambassadorsCount);
  document.getElementById('s_total').textContent = fmt(c.totalDonations);
  document.getElementById('s_funds').textContent = fmt(c.fundsCount);
  document.getElementById('s_completed').textContent = fmt(c.completedFunds);
  ambassadors = d.ambassadors || [];
  render(ambassadors);
  App.showContent();
})();
</script>

<%- include('../partials/foot') %>
