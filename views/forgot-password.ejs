<%- include('partials/head') %>

<div class="auth-shell">
  <aside class="auth-aside">
    <span class="page-kicker">استعادة الحساب</span>
    <h3>الدخول بدون كلمة مرور</h3>
    <p class="page-subtitle">أدخل رقم جوالك المسجّل لإرسال رمز التحقق عبر واتساب، وبعد التحقق سيتم إرسال رابط الدخول السريع.</p>
    <ul class="auth-list">
      <li>إدخال رقم الجوال المسجّل لدينا.</li>
      <li>استلام رمز تحقق مكوّن من 6 أرقام عبر واتساب.</li>
      <li>بعد التحقق، إرسال رابط دخول مباشر عبر واتساب.</li>
    </ul>
  </aside>

  <div class="card card-elevated auth-form-card">
    <h2>نسيت كلمة المرور؟</h2>

    <form id="phoneForm">
      <label>رقم الجوال</label>
      <input name="phone" type="tel" inputmode="numeric" required pattern="[1-9][0-9]{8}" maxlength="9" minlength="9" placeholder="5XXXXXXXX" title="9 أرقام فقط، بدون صفر في البداية وبدون رمز الدولة">
      <div class="small">9 أرقام فقط، بدون الصفر في البداية وبدون رمز الدولة</div>
      <button class="btn block lg" type="submit" style="margin-top:12px;">إرسال رمز التحقق</button>
    </form>

    <form id="otpForm" style="display:none;">
      <p class="small" id="otpHint" style="margin-bottom:8px;"></p>
      <label>رمز التحقق</label>
      <input name="otp" type="tel" inputmode="numeric" required pattern="[0-9]{6}" maxlength="6" minlength="6" placeholder="123456">
      <div class="small">الرمز صالح لمدة 10 دقائق.</div>
      <button class="btn block lg" type="submit" style="margin-top:12px;">تحقق</button>
      <button class="btn secondary block" type="button" id="backBtn" style="margin-top:8px;">رجوع لتغيير الرقم</button>
    </form>

    <div id="doneBox" style="display:none; text-align:center;">
      <h3 style="margin-top:8px;">تم بنجاح ✅</h3>
      <p id="doneMsg">تم إرسال رابط الدخول السريع إلى رقمك عبر واتساب.<br>افتح الرابط ليتم تسجيل الدخول تلقائياً.</p>
      <a id="quickLoginBtn" class="btn block lg" href="/login" style="margin-top:12px;">العودة لتسجيل الدخول</a>
    </div>

    <p class="small center" style="margin-top:12px;">عاد تذكّرت كلمة المرور؟ <a href="/login">تسجيل الدخول</a></p>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
  const phoneForm = document.getElementById('phoneForm');
  const otpForm = document.getElementById('otpForm');
  const doneBox = document.getElementById('doneBox');
  const otpHint = document.getElementById('otpHint');
  let currentPhone = '';

  phoneForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled = true; btn.textContent = 'جاري الإرسال...';
    const phone = phoneForm.phone.value.trim();
    if (!/^[1-9][0-9]{8}$/.test(phone)) {
      btn.disabled = false; btn.textContent = 'إرسال رمز التحقق';
      await App.notify({
        title: 'رقم الجوال غير صحيح',
        message: 'رقم الجوال يجب أن يكون 9 أرقام بدون صفر أو رمز الدولة',
        type: 'error',
        confirmText: 'حسناً',
      });
      return;
    }
    try {
      const r = await fetch('/auth/forgot-password', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone }),
      });
      const d = await r.json();
      btn.disabled = false; btn.textContent = 'إرسال رمز التحقق';
      if (!r.ok) {
        await App.notify({
          title: 'تعذّر الإرسال',
          message: d.error || 'حدث خطأ غير متوقع',
          type: 'error',
          confirmText: 'إغلاق',
        });
        return;
      }
      currentPhone = phone;
      otpHint.textContent = `تم إرسال الرمز إلى الرقم 0${phone} عبر واتساب.`;
      phoneForm.style.display = 'none';
      otpForm.style.display = 'block';
      otpForm.otp.focus();
    } catch (err) {
      btn.disabled = false; btn.textContent = 'إرسال رمز التحقق';
      await App.notify({
        title: 'خطأ بالشبكة',
        message: 'تعذّر الاتصال بالخادم، حاول لاحقاً',
        type: 'error',
        confirmText: 'إغلاق',
      });
    }
  });

  otpForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled = true; btn.textContent = 'جاري التحقق...';
    const otp = otpForm.otp.value.trim();
    if (!/^[0-9]{6}$/.test(otp)) {
      btn.disabled = false; btn.textContent = 'تحقق';
      await App.notify({
        title: 'رمز غير صحيح',
        message: 'الرمز يجب أن يكون 6 أرقام',
        type: 'error',
        confirmText: 'حسناً',
      });
      return;
    }
    try {
      const r = await fetch('/auth/verify-otp', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: currentPhone, otp }),
      });
      const d = await r.json();
      btn.disabled = false; btn.textContent = 'تحقق';
      if (!r.ok) {
        await App.notify({
          title: 'فشل التحقق',
          message: d.error || 'حدث خطأ غير متوقع',
          type: 'error',
          confirmText: 'إغلاق',
        });
        return;
      }
      otpForm.style.display = 'none';
      doneBox.style.display = 'block';
      if (d.loginLink) {
        const btnLink = document.getElementById('quickLoginBtn');
        btnLink.href = d.loginLink;
        btnLink.textContent = 'الدخول السريع الآن';
        if (d.whatsappSent === false) {
          document.getElementById('doneMsg').innerHTML =
            'تعذّر إرسال الرابط عبر واتساب، استخدم الزر التالي للدخول مباشرة.';
        }
      }
    } catch (err) {
      btn.disabled = false; btn.textContent = 'تحقق';
      await App.notify({
        title: 'خطأ بالشبكة',
        message: 'تعذّر الاتصال بالخادم، حاول لاحقاً',
        type: 'error',
        confirmText: 'إغلاق',
      });
    }
  });

  document.getElementById('backBtn').addEventListener('click', () => {
    otpForm.otp.value = '';
    otpForm.style.display = 'none';
    phoneForm.style.display = 'block';
    phoneForm.phone.focus();
  });
</script>

<%- include('partials/foot') %>
