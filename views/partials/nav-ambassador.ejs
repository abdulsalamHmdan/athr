<div class="amb-topbar">
  <div class="amb-topbar-profile" data-open-account role="button" tabindex="0" aria-label="الحساب الشخصي" title="الحساب الشخصي">
    <img src="/img/logo.png" alt="شعار المنصة">
    <div class="amb-topbar-meta">
      <span>لوحة السفير</span>
      <strong data-amb-name><%= ambassadorName || 'السفير' %></strong>
    </div>
    <svg class="amb-topbar-profile-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <path d="M12 20h9"></path>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
    </svg>
  </div>
  <div class="amb-topbar-actions">
    <button type="button" class="amb-topbar-home" data-top-home aria-label="الصفحة الرئيسية" title="الصفحة الرئيسية">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M3 10.5 12 3l9 7.5"></path>
        <path d="M5 9.5V21h14V9.5"></path>
      </svg>
    </button>
    <button type="button" class="amb-topbar-notify" data-push-subscribe data-push-icon aria-label="الإشعارات" title="الإشعارات">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9a6 6 0 1 0-12 0v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.08 5.454 1.31m5.715 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"></path>
      </svg>
    </button>
    <button type="button" class="amb-topbar-entry" data-open-entry-link aria-label="الرابط السري للدخول">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M15 7h3a5 5 0 0 1 0 10h-3"></path>
        <path d="M9 17H6a5 5 0 1 1 0-10h3"></path>
        <path d="M8 12h8"></path>
      </svg>
    </button>
    <a href="#" data-logout class="amb-topbar-logout" aria-label="تسجيل الخروج">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <path d="m16 17 5-5-5-5"></path>
        <path d="M21 12H9"></path>
      </svg>
    </a>
  </div>
</div>

<div class="entry-link-modal" id="entryLinkModal" hidden>
  <div class="entry-link-backdrop" data-close-entry-link></div>
  <div class="entry-link-card" role="dialog" aria-modal="true" aria-labelledby="entryLinkTitle">
    <button type="button" class="entry-link-close" data-close-entry-link aria-label="إغلاق">×</button>
    <h3 id="entryLinkTitle">الرابط السري لدخول صفحتك</h3>
    <p class="entry-link-subtitle">للدخول السريع بدون رمز مرور.</p>

    <ul class="entry-link-tips">
      <li>لا تشارك هذا الرابط مع أي شخص.</li>
      <li>احفظه في مكان آمن للوصول إلى صفحتك بأي وقت.</li>
      <li>الدخول عبره مباشر ولا يحتاج كتابة رمز.</li>
    </ul>

    <div class="entry-link-field">
      <input id="entryLinkValue" type="text" readonly value="جاري تجهيز الرابط...">
      <button type="button" class="btn sm" id="copyEntryLinkBtn">نسخ الرابط</button>
    </div>
    <p class="entry-link-note" id="entryLinkNote">احرص على حفظه في الملاحظات أو مدير كلمات المرور.</p>
  </div>
</div>

<div class="entry-link-modal account-modal" id="accountModal" hidden>
  <div class="entry-link-backdrop" data-close-account></div>
  <div class="entry-link-card account-card" role="dialog" aria-modal="true" aria-labelledby="accountTitle">
    <button type="button" class="entry-link-close" data-close-account aria-label="إغلاق">×</button>
    <h3 id="accountTitle">الحساب الشخصي</h3>
    <p class="entry-link-subtitle">عدّل اسمك أو جهتك إذا اخترت جهة خاطئة عند التسجيل.</p>

    <form id="accountForm" novalidate>
      <div class="account-field">
        <label for="accName">الاسم</label>
        <input id="accName" name="name" type="text" maxlength="100" required autocomplete="name">
      </div>

      <div class="account-field">
        <label for="accPhone">رقم الجوال</label>
        <input id="accPhone" type="tel" readonly disabled>
        <span class="account-hint">رقم الجوال مرتبط بحسابك ولا يمكن تعديله.</span>
      </div>

      <div class="account-field">
        <label for="accIsMember">هل أنت من منسوبي الجمعية؟</label>
        <select id="accIsMember" name="isMember">
          <option value="false">لا</option>
          <option value="true">نعم</option>
        </select>
      </div>

      <div class="account-field" id="accEntityWrap" hidden>
        <label for="accEntity">الجهة</label>
        <select id="accEntity" name="entity"></select>
      </div>

      <button type="submit" class="btn block ok" id="accSaveBtn" style="margin-top:6px;">حفظ التعديلات</button>
      <div class="msg" id="accMsg"></div>
    </form>
  </div>
</div>

<script src="/js/push.js"></script>
<script>
  document.body.classList.remove('has-bottom-nav');
  document.body.classList.remove('amb-bottom-nav-only');

  function trackAmbNavActivity(action, details = {}) {
    if (!action) return;
    fetch('/ambassador/activity', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action,
        details,
        path: location.pathname + location.search,
      }),
    }).catch(() => {});
  }

  const topHomeBtn = document.querySelector('[data-top-home]');
  if (topHomeBtn) {
    topHomeBtn.addEventListener('click', () => {
      trackAmbNavActivity('click_top_home');
      if (location.pathname !== '/ambassador/home') {
        location.href = '/ambassador/home';
        return;
      }
      window.dispatchEvent(new CustomEvent('amb-home-request'));
    });
  }

  (function initEntryLinkDialog() {
    const modal = document.getElementById('entryLinkModal');
    if (!modal) return;

    const valueInput = document.getElementById('entryLinkValue');
    const noteEl = document.getElementById('entryLinkNote');
    const copyBtn = document.getElementById('copyEntryLinkBtn');
    const openBtn = document.querySelector('[data-open-entry-link]');
    const closeEls = modal.querySelectorAll('[data-close-entry-link]');
    let cachedLink = '';

    function setLoading() {
      valueInput.value = 'جاري تجهيز الرابط...';
      copyBtn.disabled = true;
      noteEl.textContent = 'يتم تحميل الرابط السري الآن.';
    }

    function setLink(link) {
      cachedLink = link || '';
      valueInput.value = cachedLink || 'تعذر تحميل الرابط';
      copyBtn.disabled = !cachedLink;
      noteEl.textContent = cachedLink
        ? 'هذا الرابط يمنح دخولًا مباشرًا لصفحتك، احتفظ به بسرية تامة.'
        : 'تعذر تحميل الرابط الآن. حاول مرة أخرى.';
    }

    async function loadEntryLink() {
      if (cachedLink) return;
      setLoading();
      try {
        const res = await fetch('/ambassador/entry-link', { headers: { accept: 'application/json' } });
        const data = await res.json();
        if (!res.ok || !data || !data.entryLink) throw new Error('failed');
        setLink(data.entryLink);
      } catch (e) {
        setLink('');
      }
    }

    function openModal() {
      modal.hidden = false;
      document.body.classList.add('modal-open');
      trackAmbNavActivity('open_secret_link_modal');
      loadEntryLink();
    }

    function closeModal() {
      modal.hidden = true;
      document.body.classList.remove('modal-open');
    }

    if (openBtn) {
      openBtn.addEventListener('click', openModal);
    }

    closeEls.forEach((el) => el.addEventListener('click', closeModal));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    copyBtn.addEventListener('click', async () => {
      if (!cachedLink) return;
      try {
        await navigator.clipboard.writeText(cachedLink);
        trackAmbNavActivity('copy_secret_link', { link: cachedLink });
        const old = copyBtn.textContent;
        copyBtn.textContent = 'تم النسخ ✓';
        setTimeout(() => { copyBtn.textContent = old; }, 1400);
      } catch (e) {
        valueInput.select();
        document.execCommand('copy');
      }
    });
  })();

  const notifyToggleBtn = document.querySelector('[data-push-subscribe]');
  if (notifyToggleBtn) {
    notifyToggleBtn.addEventListener('click', () => {
      trackAmbNavActivity('click_notifications_toggle');
    });
  }

  (function initAccountDialog() {
    const modal = document.getElementById('accountModal');
    if (!modal) return;

    const openEls = document.querySelectorAll('[data-open-account]');
    const closeEls = modal.querySelectorAll('[data-close-account]');
    const form = document.getElementById('accountForm');
    const nameInput = document.getElementById('accName');
    const phoneInput = document.getElementById('accPhone');
    const memberSelect = document.getElementById('accIsMember');
    const entityWrap = document.getElementById('accEntityWrap');
    const entitySelect = document.getElementById('accEntity');
    const saveBtn = document.getElementById('accSaveBtn');
    const msgEl = document.getElementById('accMsg');
    let entitiesLoaded = false;

    function setMsg(text, type) {
      msgEl.textContent = text || '';
      msgEl.className = 'msg' + (type ? ' ' + type : '');
    }

    function syncEntityVisibility() {
      const isMember = memberSelect.value === 'true';
      entityWrap.hidden = !isMember;
      entitySelect.required = isMember;
    }

    function fillEntities(entities, selectedId) {
      entitySelect.innerHTML = '';
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = '— اختر الجهة —';
      entitySelect.appendChild(placeholder);
      (entities || []).forEach((e) => {
        const opt = document.createElement('option');
        opt.value = e.id;
        opt.textContent = e.name;
        entitySelect.appendChild(opt);
      });
      if (selectedId != null) entitySelect.value = String(selectedId);
    }

    async function loadProfile() {
      setMsg('جاري تحميل بياناتك...', '');
      saveBtn.disabled = true;
      try {
        const res = await fetch('/ambassador/profile', { headers: { accept: 'application/json' } });
        if (res.status === 401) { location.href = '/login'; return; }
        const data = await res.json();
        if (!res.ok || !data || !data.profile) throw new Error('failed');

        if (!entitiesLoaded) {
          fillEntities(data.entities, null);
          entitiesLoaded = true;
        }
        nameInput.value = data.profile.name || '';
        phoneInput.value = data.profile.phone ? '0' + data.profile.phone : '';
        memberSelect.value = data.profile.isMember ? 'true' : 'false';
        if (data.profile.isMember) entitySelect.value = String(data.profile.entity || '');
        syncEntityVisibility();
        setMsg('', '');
        saveBtn.disabled = false;
      } catch (e) {
        setMsg('تعذر تحميل بياناتك، حاول مرة أخرى.', 'err');
      }
    }

    function openModal() {
      modal.hidden = false;
      document.body.classList.add('modal-open');
      trackAmbNavActivity('open_account_modal');
      loadProfile();
    }

    function closeModal() {
      modal.hidden = true;
      document.body.classList.remove('modal-open');
    }

    openEls.forEach((el) => {
      el.addEventListener('click', openModal);
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal();
        }
      });
    });

    closeEls.forEach((el) => el.addEventListener('click', closeModal));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    memberSelect.addEventListener('change', syncEntityVisibility);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      const isMember = memberSelect.value === 'true';
      const entity = entitySelect.value;

      if (!name) { setMsg('الرجاء إدخال الاسم.', 'err'); return; }
      if (isMember && !entity) { setMsg('الرجاء اختيار الجهة.', 'err'); return; }

      saveBtn.disabled = true;
      const oldLabel = saveBtn.textContent;
      saveBtn.textContent = 'جاري الحفظ...';
      setMsg('', '');
      try {
        const res = await fetch('/ambassador/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, isMember, entity }),
        });
        if (res.status === 401) { location.href = '/login'; return; }
        const data = await res.json();
        if (!res.ok || !data || !data.ok) {
          setMsg((data && data.error) || 'تعذر حفظ التعديلات.', 'err');
          return;
        }

        document.querySelectorAll('[data-amb-name]').forEach((el) => {
          el.textContent = data.profile.name || 'السفير';
        });
        trackAmbNavActivity('update_profile', { isMember, entity });
        closeModal();
        if (window.App && typeof App.notify === 'function') {
          App.notify({ title: 'تم الحفظ', message: 'تم تحديث بيانات حسابك بنجاح.', type: 'success', confirmText: 'تمام' });
        }
      } catch (err) {
        setMsg('تعذر الاتصال بالخادم، حاول لاحقاً.', 'err');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = oldLabel;
      }
    });
  })();
</script>
