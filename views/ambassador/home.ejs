    document.getElementById('s_next_lbl').textContent = 'المتبقي';
    document.getElementById('remainingToNext').textContent = nf(remaining);
    const progressPct = smartProgress ? smartProgress.pct : Math.round(pct);
    document.getElementById('balanceTrend').textContent = '+' + progressPct + '%';
    document.getElementById('progressLbl').textContent = smartProgress?.completedAll
      ? 'أكملت جميع مستويات الجوائز — يمكنك طلب الصرف مباشرة.'
      : `${nf(stats.availableBalance || 0)} نقطة • ${progressPct}% نحو ${smartProgress?.nextName || next.name || 'الجائزة القادمة'} • المتبقي ${nf(smartProgress?.remaining || remaining)} نقطة`;
    document.getElementById('heroTargetNote').textContent =
      `رصيدك الحالي ${nf(stats.availableBalance || 0)} نقطة — الهدف القادم ${next.name || 'الجائزة القادمة'}.`;
    document.getElementById('insightProgress').textContent = `${progressPct}%`;
