<%- include('../partials/head') %>
<%- include('../partials/nav-ambassador') %>
<%- include('../partials/loader') %>
<div data-content style="display:none;">
  <div class="card">
    <h2 id="hello">أهلاً بك</h2>
    <p class="small">طريقة المنافسة: عن كل <b>3000 ريال</b> من التبرعات عبر رابطك الخاص، تحصل على جائزة قابلة للصرف من خلال صفحة "صرف الجوائز".</p>
    <div>
      <label>رابطك الخاص</label>
      <div class="link-box"><span id="link"></span><button class="btn" id="copyBtn" type="button">نسخ</button></div>
    </div>
    <div style="margin-top:14px;">
      <label>الإشعارات</label>
      <button class="btn block" type="button" data-push-subscribe>تفعيل الإشعارات</button>
      <p class="small" style="margin-top:8px;">فعّل الإشعارات لتصلك تنبيهات وتذكيرات من إدارة المنصة على متصفحك.</p>
    </div>
  </div>

  <div class="card">
    <h2>تقدمك</h2>
    <div class="progress"><div id="bar" style="width:0%"></div></div>
    <div class="small" id="progressLbl"></div>

    <div class="stat-grid" style="margin-top:16px;">
      <div class="stat"><div class="v" id="s_total">0</div><div class="l">مجموع التبرعات (ريال)</div></div>
      <div class="stat"><div class="v" id="s_paid">0</div><div class="l">صُرف كمكافأة (ريال)</div></div>
      <div class="stat"><div class="v" id="s_avail">0</div><div class="l">جوائز متاحة</div></div>
      <div class="stat"><div class="v" id="s_next">0</div><div class="l">الهدف القادم (ريال)</div></div>
    </div>
  </div>

  <div class="card" id="goalsCard" style="display:none;">
    <h2>الصناديق <span class="goals-count" id="goalsCount"></span></h2>
    <div id="goalsBody" class="goals-list"></div>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
(async function () {
  const r = await fetch('/ambassador/me');
  if (r.status === 401) { location.href = '/login'; return; }
  const d = await r.json();
  document.getElementById('hello').textContent = 'أهلاً ' + d.ambassador.name;
  document.getElementById('link').textContent = d.ambassador.referralLink;
  document.getElementById('copyBtn').onclick = () => {
    navigator.clipboard.writeText(d.ambassador.referralLink);
    document.getElementById('copyBtn').textContent = 'تم النسخ ✓';
  };
  const s = d.stats;
  document.getElementById('s_total').textContent = s.totalDonations.toLocaleString('ar-EG');
  document.getElementById('s_paid').textContent = s.paid.toLocaleString('ar-EG');
  document.getElementById('s_avail').textContent = s.availablePrizes;
  document.getElementById('s_next').textContent = s.nextMilestone.toLocaleString('ar-EG');
  const pct = Math.min(100, (s.totalDonations / s.nextMilestone) * 100);
  document.getElementById('bar').style.width = pct + '%';
  document.getElementById('progressLbl').textContent =
    `${s.totalDonations.toLocaleString('ar-EG')} من ${s.nextMilestone.toLocaleString('ar-EG')} ريال للجائزة القادمة`;

  if (Array.isArray(s.goals) && s.goals.length) {
    document.getElementById('goalsCount').textContent = s.goals.length.toLocaleString('ar-EG');
    const body = document.getElementById('goalsBody');
    const esc = (v) => String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

    const buildMsg = (g) => {
      const total = g.total || 0;
      const goal = g.goal || 0;
      return `صندوق : ${g.name || '-'}\n` +
             `نسبة الاكتمال : ${Math.ceil(total/goal*100)}%\n` +
             `رابط الصندوق:https://donate.utq.org.sa/goal_${g.pk}\n\n` +
             `ساهم في إكمال صندوق الوقف\nليكون لك أجرٌ جارٍ لا ينقطع،`;
    };

    body.innerHTML = s.goals.map((g, i) => {
      const total = g.total || 0;
      const goal = g.goal || 0;
      const pct = goal > 0 ? Math.min(100, (total / goal) * 100) : 0;
      const pctTxt = goal > 0 ? pct.toFixed(1) + '%' : '—';
      const canSend = !!(g.local && g.ownerPhone);
      const btnLabel = canSend ? 'إرسال' : 'نسخ الرسالة';
      return `
        <div class="goal-item">
          <div class="goal-head">
            <span class="goal-name">${esc(g.name || '-')}</span>
            <span class="goal-pct">${pctTxt}</span>
          </div>
          <div class="goal-nums">
            <span>المحقق: <b>${total.toLocaleString('ar-EG')}</b> ريال</span>
            <span>المستهدف: <b>${goal ? goal.toLocaleString('ar-EG') : '-'}</b> ${goal ? 'ريال' : ''}</span>
          </div>
          <div class="goal-bar"><div style="width:${pct}%"></div></div>
          <div class="goal-actions">
            <button class="btn secondary sm goal-btn" type="button" data-goal-idx="${i}" data-action="${canSend ? 'send' : 'copy'}">${btnLabel}</button>
          </div>
        </div>
      `;
    }).join('');

    body.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-goal-idx]');
      if (!btn) return;
      const idx = Number(btn.getAttribute('data-goal-idx'));
      const g = s.goals[idx];
      if (!g) return;
      const msg = buildMsg(g);
      if (btn.getAttribute('data-action') === 'send') {
        const phone = String(g.ownerPhone || '').replace(/[^\d]/g, '');
        const normalized = phone.startsWith('0') ? '966' + phone.slice(1) : phone;
        window.open(`https://wa.me/${normalized}?text=${encodeURIComponent(msg)}`, '_blank');
      } else {
        navigator.clipboard.writeText(msg).then(() => {
          const old = btn.textContent;
          btn.textContent = 'تم النسخ ✓';
          setTimeout(() => { btn.textContent = old; }, 1500);
        });
      }
    });

    document.getElementById('goalsCard').style.display = '';
  }

  App.showContent();
})();
</script>

<%- include('../partials/foot') %>
