<%- include('../partials/head') %>
<%- include('../partials/nav-ambassador') %>
<%- include('../partials/loader') %>

<div data-content style="display:none;">
  <div class="home-layout">
    <div class="portfolio-hero">
      <div class="portfolio-head">
        <div>
          <span class="portfolio-label">رصيدك المتاح</span>
          <div class="portfolio-value"><strong id="s_balance">0</strong><small>نقطة</small></div>
        </div>
        <span class="trend-chip" id="balanceTrend">+0%</span>
      </div>

      <div class="portfolio-meta-grid">
        <div class="portfolio-meta-item"><span>إجمالي التبرعات</span><b id="s_total">0</b></div>
        <div class="portfolio-meta-item"><span>المصروف كمكافآت</span><b id="s_paid">0</b></div>
        <div class="portfolio-meta-item"><span>الهدف القادم</span><b id="s_next">—</b></div>
        <div class="portfolio-meta-item"><span id="s_next_lbl">المتبقي</span><b id="remainingToNext">0</b></div>
      </div>

      <div class="smart-progress" id="smartProgress" aria-live="polite">
        <div class="smart-progress-head">
          <div class="smart-progress-level">
            <span class="smart-progress-badge" aria-hidden="true">◉</span>
            <b id="smartLevel">المستوى 1</b>
          </div>
          <span class="smart-progress-meta" id="smartProgressMeta">0%</span>
        </div>
        <div class="smart-stages" id="smartStages"></div>
      </div>
      <div class="small" id="progressLbl"></div>
    </div>

    <div class="card insight-card">
      <div class="insight-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M12 3a7 7 0 0 0-4 12.8V20a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-4.2A7 7 0 0 0 12 3z"></path>
          <path d="M9 17h6"></path>
        </svg>
      </div>
      <div class="insight-content">
        <div class="insight-title-row">
          <h2>تحليل الأداء</h2>
          <span class="chip new-chip">مباشر</span>
        </div>
        <p id="heroTargetNote">هدفك القادم سيظهر بعد تحميل بياناتك.</p>
        <div class="insight-metrics">
          <div class="insight-metric">
            <span>التقدم للهدف القادم</span>
            <b id="insightProgress">0%</b>
          </div>
          <div class="insight-metric">
            <span>عدد الطلبات</span>
            <b id="insightOrders">0</b>
          </div>
          <div class="insight-metric">
            <span>الصناديق النشطة</span>
            <b id="insightFunds">0</b>
          </div>
        </div>
      </div>
    </div>

    <div class="segment-control" id="homeSegments">
      <button class="segment-btn active" type="button" data-tab="overview">الملخص</button>
      <button class="segment-btn" type="button" data-tab="funds">الصناديق</button>
      <button class="segment-btn" type="button" data-tab="prizes">الجوائز</button>
    </div>

    <section class="tab-pane active" data-pane="overview">
      <div class="card summary-overview-card">
        <div class="section-head">
          <h2>ملخص سريع</h2>
          <p class="small">الملخص من بداية الحملة</p>
        </div>
        <div class="overview-stats-grid">
          <div class="overview-stat"><span>إجمالي الصناديق</span><b id="ovFundsTotal">0</b></div>
          <div class="overview-stat"><span>الصناديق النشطة</span><b id="ovFundsActive">0</b></div>
          <div class="overview-stat"><span>الصناديق المكتملة</span><b id="ovFundsDone">0</b></div>
          <div class="overview-stat"><span>عدد عمليات التبرع</span><b id="ovOrderCount">0</b></div>
          <div class="overview-stat"><span>طلبات قيد المراجعة</span><b id="ovPendingReq">0</b></div>
          <div class="overview-stat"><span>قيمة قيد المراجعة</span><b id="ovPendingAmount">0</b></div>
        </div>
      </div>

      <div class="card campaign-activity-card">
        <div class="section-head">
          <h2>النشاط من بداية الحملة</h2>
          <p class="small">إجمالي ما تم جمعه ومساهمة كل صندوق</p>
        </div>

        <div class="campaign-total">
          <span class="campaign-total-label">إجمالي المبلغ المُحصَّل</span>
          <div class="campaign-total-value">
            <strong id="campaignTotalAmount">0</strong>
            <small>ر.س</small>
          </div>
        </div>

        <div class="campaign-funds-head">
          <h3>الصناديق الفعالة</h3>
          <span class="campaign-funds-count" id="campaignFundsCount">0</span>
        </div>

        <div class="campaign-funds-list" id="campaignFundsList"></div>
      </div>

      <div class="card install-card" id="a2hsCard" hidden>
        <div data-a2hs-prompt>
          <div class="section-head">
            <h2>إضافة للصفحة الرئيسية</h2>
          </div>
          <p class="small" id="a2hsPromptText">ثبت المنصة على جهازك للوصول السريع بدون فتح المتصفح كل مرة.</p>
          <button class="btn block" id="a2hsInstallBtn" type="button">إضافة الآن</button>
        </div>

        <div data-a2hs-installed hidden>
          <div class="install-done-brand">
            <img src="/img/logo.png" alt="شعار نقاط الأثر">
            <div>
              <b>نقاط الأثر</b>
              <span>تمت إضافتها إلى الشاشة الرئيسية</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="tab-pane" data-pane="funds">
      <div class="card" id="goalsCard">
        <div class="section-head">
          <h2>الصناديق</h2>
          <span class="list-count-badge" id="goalsCount">0</span>
        </div>
        <div class="filters" id="fundStatusFilters">
          <a href="#" class="filter active" data-status="all">الكل</a>
          <a href="#" class="filter" data-status="active">غير مكتملة</a>
          <a href="#" class="filter" data-status="complete">مكتملة</a>
        </div>
        <div id="goalsBody" class="fund-jobs-grid"></div>
      </div>
    </section>

    <section class="tab-pane" data-pane="prizes">
      <div class="card">
        <div class="section-head">
          <h2>الرصيد والاستحقاق</h2>
          <a href="/ambassador/prizes-gallery" class="btn sm bordered">معرض الجوائز</a>
        </div>
        <div class="stat-grid">
          <div class="stat"><div class="v" id="p_balance">0</div><div class="l">رصيدك المتاح (نقاط)</div></div>
          <div class="stat"><div class="v" id="p_paid">0</div><div class="l">تم صرفها (نقاط)</div></div>
        </div>
        <div class="tier-grid" id="tierGridHome"></div>
        <div class="msg" id="prizeMsgHome"></div>
      </div>

      <div class="card">
        <div class="section-head">
          <h2>سجل طلباتي</h2>
          <p class="small">آخر حالة لكل طلب صرف</p>
        </div>
        <div class="table-wrap has-cards">
          <table class="table-cards">
            <thead><tr><th>التاريخ</th><th>الجائزة</th><th>النقاط</th><th>الحالة</th><th>ملاحظة</th></tr></thead>
            <tbody id="prizeTbodyHome"></tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="tab-pane" data-pane="create">
      <div class="card">
        <div class="section-head">
          <h2>إنشاء صندوق جديد</h2>
          <p class="small">بدون مغادرة الصفحة</p>
        </div>

        <form id="quickCreateFundForm" novalidate>
          <label for="cf_name">اسم الصندوق</label>
          <input id="cf_name" type="text" required placeholder="مثل: وقف عن فلان رحمه الله">

          <label for="cf_ownerPhone">رقم صاحب الصندوق <span class="small">(اختياري)</span></label>
          <input id="cf_ownerPhone" type="tel" placeholder="05XXXXXXXX">

          <label for="cf_waqfType">مجال التبرع</label>
          <select id="cf_waqfType" required>
            <option value="">— اختر مجال التبرع —</option>
            <option value="1">محطة جيل القران 2 (السفير)</option>
            <option value="2">كفالة حلقة</option>
            <option value="3">المحفظة الإستثمارية</option>
          </select>

          <label for="cf_targetAmount">القيمة المستهدفة للحملة</label>
          <select id="cf_targetAmount" required>
            <option value="">— اختر المجال أولاً —</option>
          </select>

          <label class="fund-option-label" style="margin-top:12px;">
            <input type="checkbox" id="cf_fundType">
            <span>نشره ضمن قائمة الصناديق الأكثر تفاعلاً</span>
          </label>

          <button class="btn block ok" id="cf_submit" type="submit" style="margin-top:14px;">إنشاء الصندوق</button>
        </form>

        <div class="msg" id="cf_msg"></div>

        <div class="link-box" id="cf_linkBox" style="display:none; margin-top:10px;">
          <span id="cf_createdLink"></span>
          <button class="btn sm bordered" type="button" id="cf_copyLink">نسخ الرابط</button>
          <button class="btn sm secondary" type="button" id="cf_shareLink">مشاركة</button>
          <a class="btn sm ok" id="cf_openLink" href="#" target="_blank" rel="noopener">فتح</a>
        </div>
      </div>
    </section>
  </div>

  <div class="prize-pick-modal" id="prizePickModal" hidden>
    <div class="prize-pick-backdrop" data-prize-close></div>
    <div class="prize-pick-card" role="dialog" aria-modal="true" aria-labelledby="prizePickTitle">
      <button type="button" class="prize-pick-close" data-prize-close aria-label="إغلاق">×</button>
      <h3 id="prizePickTitle">اختر الجائزة</h3>
      <p class="prize-pick-sub" id="prizePickSub">اختر إحدى الجوائز المتوفرة من فئتك ثم أرسل الطلب.</p>

      <div class="prize-pick-preview" id="prizePickPreview" hidden>
        <img id="prizePickImg" src="" alt="">
        <div class="prize-pick-info">
          <b id="prizePickName"></b>
          <span id="prizePickDesc" class="small"></span>
          <span class="prize-pick-stock" id="prizePickStock"></span>
        </div>
      </div>

      <label for="prizePickSelect" class="small">الجائزة</label>
      <select id="prizePickSelect"></select>

      <div class="prize-pick-actions">
        <button type="button" class="btn secondary" data-prize-close>إلغاء</button>
        <button type="button" class="btn ok" id="prizePickConfirm">إرسال الطلب</button>
      </div>
      <div class="msg" id="prizePickMsg"></div>
    </div>
  </div>

  <style>
    .prize-pick-modal {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9000;
      padding: 16px;
    }
    .prize-pick-modal[hidden] { display: none; }
    .prize-pick-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(2px);
    }
    .prize-pick-card {
      position: relative;
      background: #fff;
      border-radius: 18px;
      padding: 22px 18px 18px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .prize-pick-close {
      position: absolute;
      top: 8px;
      inset-inline-end: 10px;
      background: transparent;
      border: 0;
      font-size: 24px;
      cursor: pointer;
      color: #6b7280;
    }
    .prize-pick-card h3 { margin: 0; font-size: 18px; color: var(--navy-2, #1f2937); }
    .prize-pick-sub { margin: 0 0 6px; font-size: 13px; color: var(--muted, #6b7280); }
    .prize-pick-card select {
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid var(--border, #e5e7eb);
      background: #f9fafb;
      font-size: 14px;
      font-family: inherit;
    }
    .prize-pick-preview {
      display: flex;
      gap: 12px;
      padding: 10px;
      border-radius: 12px;
      background: #f8fafc;
      border: 1px solid var(--border, #e5e7eb);
      align-items: center;
    }
    .prize-pick-preview img {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 10px;
      background: #fff;
      flex-shrink: 0;
    }
    .prize-pick-info { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .prize-pick-info b { font-size: 14px; color: var(--navy-2, #1f2937); }
    .prize-pick-info .small { font-size: 12px; color: var(--muted, #6b7280); line-height: 1.45; }
    .prize-pick-stock {
      font-size: 12px;
      font-weight: 600;
      color: #16a34a;
      margin-top: 2px;
    }
    .prize-pick-stock.low { color: #f59e0b; }
    .prize-pick-actions {
      display: flex;
      gap: 8px;
      justify-content: flex-end;
      margin-top: 6px;
    }
  </style>

  <button type="button" id="createFundFab" class="create-fund-fab" aria-label="إنشاء صندوق وقفي" title="إنشاء صندوق وقفي">
    <span class="create-fund-fab-icon">+</span>
    <span class="create-fund-fab-text">أنشئ صندوق وقفي</span>
  </button>
</div>

<script src="/js/app.js"></script>
<script>
(async function () {
  const nf = App.formatNumber;
  const df = App.formatDate;
  const esc = (v) => String(v == null ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

  const statusMap = { pending: 'قيد المراجعة', approved: 'مقبولة', rejected: 'مرفوضة', paid: 'تم الصرف' };
  const tierNameByAmount = { 2000: 'برونزية', 5000: 'فضية', 10000: 'ذهبية' };

  let stats = null;
  let goalsList = [];
  let allFunds = [];
  let fundStatusFilter = 'all';
  let requestsList = [];

  function trackAmbActivity(action, details = {}) {
    if (!action) return;
    fetch('/ambassador/activity', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action,
        details,
        path: location.pathname + location.search,
      }),
    }).catch(() => {});
  }

  function setTabQuery(tab) {
    const url = new URL(location.href);
    if (tab === 'overview') url.searchParams.delete('tab');
    else url.searchParams.set('tab', tab);
    history.replaceState({}, '', url.pathname + (url.search ? url.search : ''));
  }

  function activateTab(tab) {
    document.querySelectorAll('#homeSegments .segment-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.tab === tab);
    });
    document.querySelectorAll('.tab-pane[data-pane]').forEach((pane) => {
      pane.classList.toggle('active', pane.dataset.pane === tab);
    });
    const topHomeBtn = document.querySelector('[data-top-home]');
    if (topHomeBtn) {
      topHomeBtn.classList.toggle('is-active', tab === 'overview');
    }
    const createFab = document.getElementById('createFundFab');
    if (createFab) {
      createFab.classList.toggle('is-active', tab === 'create');
    }
  }

  function initTabs() {
    const validTabs = new Set(['overview', 'funds', 'prizes', 'create']);
    const qpTab = new URLSearchParams(location.search).get('tab');
    const initialTab = validTabs.has(qpTab) ? qpTab : 'overview';
    activateTab(initialTab);

    document.getElementById('homeSegments').addEventListener('click', (e) => {
      const btn = e.target.closest('.segment-btn[data-tab]');
      if (!btn) return;
      const tab = btn.dataset.tab;
      activateTab(tab);
      setTabQuery(tab);
      trackAmbActivity('switch_home_tab', { tab });
    });

    window.addEventListener('amb-home-request', () => {
      activateTab('overview');
      setTabQuery('overview');
    });
  }

  function buildFundMsg(g) {
    const pct = Math.min(100, Math.round(Number(g.progress || 0)));
    return `صندوق : ${g.name || '-'}\n` +
           `نسبة الاكتمال : ${pct}%\n` +
           `رابط الصندوق: ${g.shareUrl}\n\n` +
           `ساهم في إكمال صندوق الوقف\nليكون لك أجرٌ جارٍ لا ينقطع،`;
  }

  function getFilteredFunds() {
    if (fundStatusFilter === 'active') return allFunds.filter((g) => !g.completed);
    if (fundStatusFilter === 'complete') return allFunds.filter((g) => !!g.completed);
    return allFunds;
  }

  function renderFundsTab() {
    const body = document.getElementById('goalsBody');
    const list = getFilteredFunds();
    document.getElementById('goalsCount').textContent = nf(list.length || 0);

    if (!list.length) {
      const emptyTxt = fundStatusFilter === 'active'
        ? 'لا توجد صناديق غير مكتملة'
        : fundStatusFilter === 'complete'
          ? 'لا توجد صناديق مكتملة'
          : 'لا توجد صناديق بعد';
      body.innerHTML = `<p class="small center">${emptyTxt}</p>`;
      return;
    }

    body.innerHTML = list.map((g) => {
      const pct = Math.min(100, Number(g.progress || 0));
      const pctTxt = (g.progress != null ? Number(g.progress).toFixed(1) : '0') + '%';
      const doneLabel = g.completed ? 'مكتمل' : 'غير مكتمل';
      const doneClass = g.completed ? 'saved' : 'active';
      const initial = (g.name || 'ص').trim().charAt(0);
      return `
        <article class="fund-job-card ${g.completed ? 'is-complete' : ''}">
          <div class="fund-job-head">
            <div class="fund-job-brand">
              <span class="fund-job-avatar">${esc(initial)}</span>
              <div class="fund-job-brand-meta">
                <b>${esc(g.name || '-')}</b>
                <small>نسبة الإنجاز ${pctTxt}</small>
              </div>
            </div>
            <span class="fund-job-save ${doneClass}">${doneLabel}</span>
          </div>

          <h3 class="fund-job-title">متابعة أداء الصندوق</h3>

          <div class="fund-job-tags">
            <span class="fund-job-tag">المستهدف ${nf(g.priceGoal || 0)} ر.س</span>
            <span class="fund-job-tag">المحقق ${nf(g.soldTotal || 0)} ر.س</span>
            <span class="fund-job-tag muted">التبرعات ${nf(g.soldCount || 0)}</span>
            <span class="fund-job-tag muted">الزيارات ${nf(g.visits || 0)}</span>
          </div>

          <div class="fund-job-progress"><div style="width:${pct}%"></div></div>
          <div class="fund-job-divider"></div>

          <div class="fund-job-footer">
            <div class="fund-job-amount">
              <strong>${nf(g.soldTotal || 0)} ر.س</strong>
              <small>من أصل ${nf(g.priceGoal || 0)} ر.س</small>
            </div>
            <div class="fund-job-actions">
              <button class="fund-job-copy" type="button" data-goal-id="${esc(g.id)}">نسخ</button>
              <a class="fund-job-cta" href="${esc(g.shareUrl)}" target="_blank" rel="noopener">فتح الصندوق</a>
            </div>
          </div>
        </article>
      `;
    }).join('');
  }

  function initFundsTabInteractions() {
    const filtersEl = document.getElementById('fundStatusFilters');
    const body = document.getElementById('goalsBody');
    if (!filtersEl || !body) return;

    filtersEl.addEventListener('click', (e) => {
      const filter = e.target.closest('.filter[data-status]');
      if (!filter) return;
      e.preventDefault();
      fundStatusFilter = filter.dataset.status;
      filtersEl.querySelectorAll('.filter').forEach((el) => {
        el.classList.toggle('active', el === filter);
      });
      renderFundsTab();
    });

    body.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-goal-id]');
      if (!btn) return;
      const id = btn.getAttribute('data-goal-id');
      const g = allFunds.find((item) => String(item.id) === String(id));
      if (!g) return;
      navigator.clipboard.writeText(buildFundMsg(g)).then(() => {
        const old = btn.textContent;
        btn.textContent = 'تم النسخ ✓';
        setTimeout(() => { btn.textContent = old; }, 1500);
      });
      trackAmbActivity('copy_fund_message', {
        fundId: g.id,
        fundName: g.name,
      });
    });
  }

  function renderPrizeTiers() {
    const grid = document.getElementById('tierGridHome');
    const tiers = Array.isArray(stats?.tiers) ? stats.tiers : [];
    grid.innerHTML = tiers.map((t) => `
      <div class="tier ${t.id} ${t.canClaim ? '' : 'locked'}">
        <div class="tier-name">${t.name}</div>
        <div class="tier-amount">${nf(t.amount)} <span>نقطة</span></div>
        <button class="btn block ok" data-tier="${t.id}" ${t.canClaim ? '' : 'disabled'}>
          ${t.canClaim ? 'طلب الصرف' : 'الرصيد غير كافٍ'}
        </button>
      </div>
    `).join('');
  }

  function renderPrizeHistory() {
    const tb = document.getElementById('prizeTbodyHome');
    tb.innerHTML = '';
    if (!requestsList.length) {
      tb.innerHTML = '<tr><td colspan="5" class="table-empty">لا توجد طلبات بعد</td></tr>';
      return;
    }
    for (const r of requestsList) {
      const tierName = tierNameByAmount[r.amount] || '-';
      const prizeLabel = r.prizeName ? `${r.prizeName} (${tierName})` : tierName;
      const note = r.note || '-';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td data-label="التاريخ"><span class="table-value is-number">${esc(df(r.createdAt))}</span></td>
        <td data-label="الجائزة"><span class="table-value is-ellipsis">${esc(prizeLabel)}</span></td>
        <td data-label="النقاط"><span class="table-value is-number">${nf(r.amount)} نقطة</span></td>
        <td data-label="الحالة"><span class="table-value is-badge"><span class="badge ${r.status}">${statusMap[r.status] || '-'}</span></span></td>
