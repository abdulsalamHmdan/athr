  function renderCampaignActivity() {
    const totalEl = document.getElementById('campaignTotalAmount');
    const listEl = document.getElementById('campaignFundsList');
    const countEl = document.getElementById('campaignFundsCount');
    if (!totalEl || !listEl || !countEl) return;

    const campaignTotal = allFunds.reduce(
      (sum, g) => sum + (Number(g.currentTotal) || 0),
      0
    );
    totalEl.textContent = nf(campaignTotal);

    const activeFunds = allFunds
      .filter((g) =>  (Number(g.currentTotal) || 0) > 0)
      .sort((a, b) => (Number(b.currentTotal) || 0) - (Number(a.currentTotal) || 0));

    countEl.textContent = nf(activeFunds.length);

    if (!activeFunds.length) {
      listEl.innerHTML = '<p class="small center campaign-empty">لا توجد صناديق نشطة بنشاط بعد</p>';
      return;
    }

    listEl.innerHTML = activeFunds.map((g) => {
      const amount = Number(g.currentTotal) || 0;
      const pct = campaignTotal > 0 ? (amount / campaignTotal) * 100 : 0;
      const pctTxt = pct.toFixed(1) + '%';
