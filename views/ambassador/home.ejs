  async function loadAndRenderMainData() {
    const [me, fundsRes] = await Promise.all([
      fetch('/ambassador/me'),
      fetch('/ambassador/funds-data').catch(() => null),
    ]);
    if (me.status === 401) { location.href = '/login'; return; }
    if (fundsRes && fundsRes.status === 401) { location.href = '/login'; return; }

    const d = await me.json();
    stats = d.stats || {};
    goalsList = Array.isArray(stats.goals) ? stats.goals : [];

    if (fundsRes && fundsRes.ok) {
      const fd = await fundsRes.json();
      allFunds = Array.isArray(fd.results) ? fd.results : [];
    } else {
      allFunds = [];
    }

    if (!allFunds.length && goalsList.length) {
      allFunds = goalsList.map((g, idx) => {
        const goal = Number(g.goal || 0);
        const total = Number(g.total || 0);
        const progress = goal > 0 ? Math.min(100, (total / goal) * 100) : 0;
        return {
          id: g.pk || `legacy-${idx}`,
          name: g.name || '',
          priceGoal: goal,
          soldTotal: total,
          soldCount: Number(g.count || 0),
          visits: Number(g.visits || 0),
          progress,
          completed: goal > 0 ? total >= goal : false,
          shareUrl: g.pk ? `https://donate.utq.org.sa/goal_${g.pk}` : '#',
        };
      });
    }

    await loadRequests();
    fillOverviewAndTop();
    renderFundsTab();
    renderPrizeTiers();
    renderPrizeHistory();
  }

