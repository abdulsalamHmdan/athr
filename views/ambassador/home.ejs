  function renderSmartProgress() {
    const levelEl = document.getElementById('smartLevel');
    const metaEl = document.getElementById('smartProgressMeta');
    const stagesEl = document.getElementById('smartStages');
    if (!levelEl || !metaEl || !stagesEl) return null;

    const balance = Number(stats?.availableBalance || 0);
    const tiers = Array.isArray(stats?.tiers)
      ? [...stats.tiers]
          .map((t) => ({ ...t, amount: Number(t.amount || 0) }))
          .filter((t) => Number.isFinite(t.amount) && t.amount > 0)
          .sort((a, b) => a.amount - b.amount)
      : [];

    if (!tiers.length) {
      levelEl.textContent = 'المستوى 1';
      metaEl.textContent = 'لا توجد مستويات حالياً';
      stagesEl.innerHTML = '';
      return { pct: 0, remaining: 0, nextName: '' };
    }

    const segmentsPerStage = 4;
    const stages = tiers.map((tier, idx) => {
      const start = idx === 0 ? 0 : Number(tiers[idx - 1].amount || 0);
      const end = Number(tier.amount || 0);
      const span = Math.max(1, end - start);
      let progress = 0;
      if (balance >= end) progress = 1;
      else if (balance > start) progress = (balance - start) / span;
      return {
        idx,
        name: tier.name || `المستوى ${idx + 1}`,
        start,
        end,
        progress: Math.max(0, Math.min(1, progress)),
      };
    });

    let currentStageIndex = stages.findIndex((s) => s.progress < 1);
    if (currentStageIndex < 0) currentStageIndex = stages.length - 1;
    const currentStage = stages[currentStageIndex];
    const completedAll = stages.every((s) => s.progress >= 1);
    const currentPct = Math.round((currentStage?.progress || 0) * 100);
    const remainingToCurrentEnd = Math.max(0, Number(currentStage?.end || 0) - balance);

    levelEl.textContent = completedAll
      ? `المستوى ${stages.length} مكتمل`
      : `المستوى ${currentStageIndex + 1}`;

    metaEl.textContent = completedAll
      ? 'أكملت كل مستويات الجوائز'
      : `${currentPct}% • المتبقي ${nf(remainingToCurrentEnd)} نقطة`;

    stagesEl.innerHTML = stages.map((stage, stageIndex) => {
      const segments = Array.from({ length: segmentsPerStage }).map((_, segIdx) => {
        const segStart = segIdx / segmentsPerStage;
        const segEnd = (segIdx + 1) / segmentsPerStage;
        let fill = 0;
        if (stage.progress >= segEnd) fill = 1;
        else if (stage.progress > segStart) fill = (stage.progress - segStart) / (segEnd - segStart);
        const cls = fill >= 1 ? 'is-full' : fill > 0 ? 'is-partial' : '';
        return `<span class="smart-seg ${cls}" style="--fill:${(fill * 100).toFixed(2)}%"></span>`;
      }).join('');

      const stageCls = [
        'smart-stage',
        stageIndex === currentStageIndex ? 'is-active' : '',
        stage.progress >= 1 ? 'is-done' : '',
      ].join(' ').trim();

      return `<div class="${stageCls}" title="${esc(stage.name)}">${segments}</div>`;
    }).join('');

    return {
      pct: currentPct,
      remaining: remainingToCurrentEnd,
      nextName: currentStage?.name || '',
      completedAll,
    };
  }

  function fillOverviewAndTop() {
    const next = stats.nextTier || { amount: 0, name: '' };
    const pct = next.amount > 0 ? Math.min(100, (stats.availableBalance / next.amount) * 100) : 100;
    const remaining = Math.max(0, (next.amount || 0) - (stats.availableBalance || 0));
    const smartProgress = renderSmartProgress();

    document.getElementById('s_total').textContent = nf(stats.totalDonations || 0);
    document.getElementById('s_paid').textContent = nf(stats.paid || 0);
