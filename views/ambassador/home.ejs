  async function requestPrize(tier, prize) {
    const body = { tier };
    if (prize) {
      body.prizeId = prize.id;
      body.prizeName = prize.name;
    }
    const r = await fetch('/ambassador/requests', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) {
      return { ok: false, error: d.error || 'تعذر إرسال الطلب.' };
    }
    return { ok: true };
  }

  function openPrizePicker(tier) {
    return new Promise(async (resolve) => {
      const modal = document.getElementById('prizePickModal');
      const select = document.getElementById('prizePickSelect');
      const titleEl = document.getElementById('prizePickTitle');
      const subEl = document.getElementById('prizePickSub');
      const msgEl = document.getElementById('prizePickMsg');
      const confirmBtn = document.getElementById('prizePickConfirm');
      const preview = document.getElementById('prizePickPreview');
      const imgEl = document.getElementById('prizePickImg');
      const nameEl = document.getElementById('prizePickName');
      const descEl = document.getElementById('prizePickDesc');
      const stockEl = document.getElementById('prizePickStock');

      await loadPrizeCatalog();
      const list = prizeCatalog.filter((p) => p.tier === tier && Number(p.stock || 0) > 0);

      titleEl.textContent = `اختر الجائزة ${tierLabel[tier] || ''}`;
      msgEl.textContent = '';

      if (!list.length) {
        await App.notify({
          title: 'لا توجد جوائز متاحة',
          message: `لا توجد جوائز ${tierLabel[tier] || ''} متاحة حالياً في المخزون.`,
          type: 'warning',
          confirmText: 'حسناً',
        });
        return resolve(null);
      }

      subEl.textContent = `الجوائز ${tierLabel[tier] || ''} المتوفرة (${list.length})`;
      select.innerHTML = list.map((p) => `
        <option value="${p.id}">${p.name} — المخزون ${p.stock}</option>
      `).join('');

      function refreshPreview() {
        const p = list.find((x) => x.id === select.value) || list[0];
        if (!p) {
          preview.hidden = true;
          return;
        }
        preview.hidden = false;
        imgEl.src = p.image || '';
        imgEl.alt = p.name || '';
        nameEl.textContent = p.name || '';
        descEl.textContent = p.description || '';
        const stock = Number(p.stock || 0);
        stockEl.textContent = `المخزون المتاح: ${stock}`;
        stockEl.classList.toggle('low', stock > 0 && stock <= 3);
      }

      select.value = list[0].id;
      refreshPreview();

      function close(result) {
        modal.hidden = true;
        document.body.classList.remove('modal-open');
        select.removeEventListener('change', refreshPreview);
        confirmBtn.removeEventListener('click', onConfirm);
        modal.querySelectorAll('[data-prize-close]').forEach((el) => el.removeEventListener('click', onClose));
        document.removeEventListener('keydown', onEsc);
        resolve(result);
      }
      function onClose() { close(null); }
      function onEsc(e) { if (e.key === 'Escape') close(null); }
      async function onConfirm() {
        const chosen = list.find((x) => x.id === select.value);
        if (!chosen) return;
        confirmBtn.disabled = true;
        const oldTxt = confirmBtn.textContent;
        confirmBtn.textContent = 'جارٍ الإرسال...';
        const result = await requestPrize(tier, chosen);
        confirmBtn.disabled = false;
        confirmBtn.textContent = oldTxt;
        if (result.ok) {
          close(chosen);
          await App.notify({
            title: 'تم الإرسال بنجاح',
            message: `تم إرسال طلبك للجائزة: ${chosen.name}`,
            type: 'success',
            confirmText: 'ممتاز',
          });
        } else {
          await App.notify({
            title: 'تعذر إرسال الطلب',
            message: result.error,
            type: 'error',
            confirmText: 'إغلاق',
          });
        }
      }

      select.addEventListener('change', refreshPreview);
      confirmBtn.addEventListener('click', onConfirm);
      modal.querySelectorAll('[data-prize-close]').forEach((el) => el.addEventListener('click', onClose));
      document.addEventListener('keydown', onEsc);

      modal.hidden = false;
      document.body.classList.add('modal-open');
    });
  }

