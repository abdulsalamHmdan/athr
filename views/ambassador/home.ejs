    }

    if (isStandalone || localStorage.getItem('athr_a2hs_installed') === '1') {
      showInstalled();
      return;
    }

    showPrompt();

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      showPrompt();
    });

    window.addEventListener('appinstalled', () => {
      deferredPrompt = null;
      showInstalled();
    });

    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) {
        showPrompt();
        promptText.textContent = 'في iPhone: افتح مشاركة المتصفح ثم اختر "إضافة إلى الشاشة الرئيسية".';
        return;
      }
      deferredPrompt.prompt();
      await deferredPrompt.userChoice;
      deferredPrompt = null;
    });
  }

  function initCreateFab() {
    const fab = document.getElementById('createFundFab');
    if (!fab) return;
    fab.addEventListener('click', () => {
      activateTab('create');
      setTabQuery('create');
      const createPane = document.querySelector('.tab-pane[data-pane="create"]');
      if (createPane) createPane.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  initTabs();
  initPrizeActions();
  initFundsTabInteractions();
  initQuickCreateFund();
  initA2HSCard();
  initCreateFab();
  await loadAndRenderMainData();

  App.showContent();
  if (window.PushNotify && typeof window.PushNotify.askFromEntry === 'function') {
    window.PushNotify.askFromEntry({
      confirmText: 'هل ترغب بتفعيل إشعارات منصة نقاط الأثر الآن؟'
    });
  }
})();
</script>

