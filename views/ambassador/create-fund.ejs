<%- include('../partials/head') %>
<%- include('../partials/nav-ambassador') %>
<%- include('../partials/loader') %>

<div data-content style="display: none">
  <div class="page-intro">
    <span class="page-kicker">إنشاء صندوق</span>
    <h3 class="page-title">أنشئ صندوقك بخطوات واضحة</h3>
    <p class="page-subtitle">حدّد المجال والقيمة المستهدفة ثم شارك الرابط مباشرة مع صاحب الصندوق أو جمهورك.</p>
  </div>

  <!-- حالة: لا يوجد حساب على المنصة -->
  <div class="card card-elevated" id="noAccountCard" style="display: none">
    <h2>تحتاج إلى حساب على المنصة</h2>
    <p class="small">
      لإنشاء صندوق جديد، يجب أن يكون لديك حساب على منصة ديسق. اضغط الزر أدناه
      للانتقال للمنصة وإنشاء حسابك.
    </p>
    <a
      id="platformLink"
      class="btn block ok"
      href="#"
      target="_blank"
      rel="noopener"
      >الذهاب إلى المنصة لإنشاء حساب</a
    >
  </div>

  <div class="panel-grid panel-grid-2">
    <!-- حالة: عنده حساب — يظهر النموذج -->
    <div class="card card-elevated" id="formCard" style="display: none">
      <div class="section-head">
        <h2>بيانات الصندوق</h2>
      </div>

      <form id="fundForm" novalidate>
        <div class="wizard">
          <ol class="wizard-steps" id="wizardSteps">
            <li class="wizard-step active" data-step="1"><b>الخطوة 1</b><small>البيانات الأساسية</small></li>
            <li class="wizard-step" data-step="2"><b>الخطوة 2</b><small>إعداد الحملة</small></li>
            <li class="wizard-step" data-step="3"><b>الخطوة 3</b><small>المراجعة والإنشاء</small></li>
          </ol>

          <section class="wizard-pane" data-step="1">
            <div class="form-section" style="margin-top:0;">
              <p class="form-section-title">المعلومات الأساسية</p>
              <label for="name">اسم الصندوق</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="مثل: صندوق عن فلان رحمه الله أو مبادرة فريق..."
              />

              <label for="ownerPhone">رقم صاحب الصندوق <span class="small">(اختياري)</span></label>
              <input
                type="tel"
                id="ownerPhone"
                name="ownerPhone"
                placeholder="مثل: 05XXXXXXXX"
              />
            </div>
            <div class="wizard-actions">
              <button type="button" class="btn lg" id="nextStep1">التالي</button>
            </div>
          </section>

          <section class="wizard-pane" data-step="2" hidden>
            <div class="form-section" style="margin-top:0;">
              <p class="form-section-title">تفاصيل الحملة</p>
              <div class="form-grid">
                <div>
                  <label for="waqfType">مجال التبرع</label>
                  <select id="waqfType" name="waqfType" required>
                    <option value="">— اختر مجال التبرع —</option>
                    <option value="1">محطة جيل القران 2 (السفير)</option>
                    <option value="2">كفالة حلقة</option>
                    <option value="3">المحفظة الإستثمارية</option>
                  </select>
                </div>
                <div>
                  <label for="targetAmount">القيمة المستهدفة للحملة</label>
                  <select id="targetAmount" name="targetAmount" required>
                    <option value="">— اختر المجال —</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="form-section">
              <p class="form-section-title">إعدادات النشر</p>
              <label for="fundType">نوع الصندوق</label>
              <label class="fund-option-label">
                <input type="checkbox" id="fundType" name="fundType" />
                <span>نشره ضمن قائمة الصناديق الأكثر تفاعلاً.</span>
              </label>
              <p class="small" style="margin-top: 8px">
                ملاحظة: سيتاح استقبال التبرعات حتى بعد الوصول للمستهدف.
              </p>
            </div>
            <div class="wizard-actions">
              <button type="button" class="btn bordered" id="prevStep2">السابق</button>
              <button type="button" class="btn lg" id="nextStep2">مراجعة البيانات</button>
            </div>
          </section>

          <section class="wizard-pane" data-step="3" hidden>
            <div class="form-section" style="margin-top:0;">
              <p class="form-section-title">مراجعة البيانات</p>
              <div class="wizard-review">
                <div class="wizard-review-row"><span>اسم الصندوق</span><b id="reviewName">-</b></div>
                <div class="wizard-review-row"><span>مجال التبرع</span><b id="reviewType">-</b></div>
                <div class="wizard-review-row"><span>القيمة المستهدفة</span><b id="reviewTarget">-</b></div>
                <div class="wizard-review-row"><span>رقم صاحب الصندوق</span><b id="reviewPhone">-</b></div>
                <div class="wizard-review-row"><span>ظهور الصندوق</span><b id="reviewVisibility">-</b></div>
              </div>
            </div>
            <div class="wizard-actions">
              <button type="button" class="btn bordered" id="prevStep3">تعديل البيانات</button>
              <button class="btn ok lg" id="submitBtn" type="submit">إنشاء الصندوق</button>
            </div>
          </section>
        </div>
        <div class="msg" id="msg"></div>
      </form>
    </div>

    <aside class="card" id="fundGuideCard" style="display: none">
      <div class="section-head">
        <h2>إرشادات سريعة</h2>
      </div>
      <ul class="feature-bullets">
        <li>اختر اسمًا واضحًا يساعد المتبرع على فهم الهدف بسرعة.</li>
        <li>حدّد المجال أولًا لتظهر القيم المناسبة تلقائيًا.</li>
        <li>بعد الإنشاء انسخ الرابط أو أرسله عبر واتساب مباشرة.</li>
      </ul>
      <div class="card-note small">
        كل صندوق تنشئه يظهر لاحقًا في صفحة "قائمة الصناديق" مع مؤشرات التقدم والزيارات.
      </div>
    </aside>
  </div>
</div>

<!-- POP UP: تم إنشاء الصندوق -->
<div id="fundSuccessOverlay" class="fund-success-overlay">
  <div id="fundSuccessModal" class="fund-success-modal">
    <button type="button" id="fundSuccessClose" aria-label="إغلاق" class="fund-close-btn">
      ×
    </button>

    <div class="fund-success-head">
      <div class="fund-success-check">
        ✓
      </div>
      <h3>تم إنشاء الصندوق بنجاح</h3>
      <p>
        شارك الصندوق مع صاحبه ليبدأ الحملة
      </p>
    </div>

    <div class="fund-info-block">
      <div class="fund-info-label">
        اسم الصندوق
      </div>
      <div id="fsName" class="fund-info-value"></div>

      <div class="fund-info-label">
        رابط الصندوق
      </div>
      <div class="fund-link-row">
        <input id="fsLink" type="text" readonly class="fund-link-input" />
        <button type="button" id="fsCopyBtn" class="fund-copy-btn">
          نسخ
        </button>
      </div>
    </div>

    <div class="fund-qr-wrap">
      <img id="fsQr" alt="QR" class="fund-qr-image" />
      <div class="fund-qr-hint">
        امسح الباركود لفتح رابط الصندوق
      </div>
    </div>

    <a id="fsWaBtn" href="#" target="_blank" rel="noopener" class="fund-wa-btn">
      <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
        <path
          fill="#fff"
          d="M16.003 3C9.374 3 4 8.373 4 15c0 2.121.554 4.115 1.527 5.85L4 28l7.348-1.501A11.95 11.95 0 0016.003 27C22.632 27 28 21.627 28 15S22.632 3 16.003 3zm5.563 14.428c-.305-.153-1.804-.89-2.084-.99-.28-.103-.484-.153-.687.152-.203.305-.787.99-.965 1.193-.178.204-.355.229-.66.077-.305-.153-1.288-.475-2.453-1.514-.907-.808-1.52-1.806-1.698-2.111-.178-.305-.019-.47.134-.622.137-.137.305-.355.458-.533.152-.178.203-.305.305-.508.102-.204.05-.382-.025-.534-.077-.153-.687-1.654-.94-2.265-.247-.595-.498-.514-.687-.523l-.585-.011a1.124 1.124 0 00-.814.382c-.28.305-1.067 1.043-1.067 2.544s1.092 2.95 1.244 3.153c.152.203 2.149 3.282 5.207 4.602.728.314 1.296.501 1.74.642.731.232 1.396.2 1.922.121.587-.087 1.804-.737 2.06-1.45.255-.712.255-1.322.178-1.45-.076-.127-.28-.204-.585-.357z"
        />
      </svg>
      <span id="fsWaLabel">مشاركة الصندوق</span>
    </a>
    <a id="fsOpenBtn" href="#" target="_blank" rel="noopener" class="btn block" style="margin-top:8px;">فتح الصندوق</a>
    <p id="fsWaHint" class="fund-wa-hint"></p>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
  (async function () {
    document.getElementById("formCard").style.display = "";
    document.getElementById("fundGuideCard").style.display = "";

    const form = document.getElementById("fundForm");
    const btn = document.getElementById("submitBtn");
    const waqfTypeEl = document.getElementById("waqfType");
    const targetSelect = document.getElementById("targetAmount");
    const wizardPanes = Array.from(document.querySelectorAll(".wizard-pane"));
    const wizardSteps = Array.from(document.querySelectorAll(".wizard-step"));
    let currentStep = 1;

    const targetOptions = {
      "3": {
        placeholder: "— اختر عدد الأسهم —",
        items: [
          { value: "800", label: "سهم واحد — 800 ريال" },
          { value: "1600", label: "سهمان — 1,600 ريال" },
          { value: "4000", label: "5 أسهم — 4,000 ريال" },
          { value: "8000", label: "10 أسهم — 8,000 ريال" },
        ],
      },
      "2": {
        placeholder: "— اختر عدد الأشهر —",
        items: [
          { value: "800", label: "شهر — 800 ريال" },
          { value: "1600", label: "شهرين — 1,600 ريال" },
          { value: "2400", label: "3 أشهر — 2,400 ريال" },
          { value: "5000", label: "فصل دراسي — 5,000 ريال" },
          { value: "10000", label: "سنة كاملة — 10,000 ريال" },
        ],
      },
      "1": {
        placeholder: "— اختر عدد الأمتار —",
        items: [
          { value: "1465", label: "متر — 1,465 ريال" },
          { value: "2930", label: "مترين — 2,930 ريال" },
          { value: "4395", label: "3 أمتار — 4,395 ريال" },
          { value: "7325", label: "5 أمتار — 7,325 ريال" },
          { value: "14650", label: "10 أمتار — 14,650 ريال" },
        ],
      },
    };

    function showMessage(type, text) {
      App.notify({
        title: type === "err" ? "تنبيه" : "تمت العملية",
        message: text,
        type: type === "err" ? "error" : "success",
        confirmText: "حسناً",
      });
    }

    function clearMessage() {
      return;
    }

    function renderTargetsByType(type) {
      const data = targetOptions[type];
      targetSelect.innerHTML = "";
      const first = document.createElement("option");
      first.value = "";
      first.textContent = data ? data.placeholder : "— اختر المجال أولاً —";
      targetSelect.appendChild(first);
      if (!data) return;
      data.items.forEach((item) => {
        const option = document.createElement("option");
        option.value = item.value;
        option.textContent = item.label;
        targetSelect.appendChild(option);
      });
    }

    function setStep(step) {
      currentStep = step;
      wizardPanes.forEach((pane) => {
        pane.hidden = Number(pane.dataset.step) !== step;
      });
      wizardSteps.forEach((item) => {
        const n = Number(item.dataset.step);
        item.classList.toggle("active", n === step);
        item.classList.toggle("done", n < step);
      });
      clearMessage();
    }

    function validOwnerPhone(raw) {
      if (!raw) return true;
      const cleaned = String(raw).replace(/\D/g, "");
      return /^(05\d{8}|5\d{8}|9665\d{8})$/.test(cleaned);
    }

    function validateStep(step) {
      const name = document.getElementById("name").value.trim();
      const ownerPhone = document.getElementById("ownerPhone").value.trim();
      const waqfType = waqfTypeEl.value;
      const targetAmount = targetSelect.value;

      if (step === 1) {
        if (!name) {
          showMessage("err", "الرجاء إدخال اسم الصندوق.");
          return false;
        }
        if (!validOwnerPhone(ownerPhone)) {
          showMessage("err", "رقم صاحب الصندوق غير صحيح. استخدم 05XXXXXXXX أو 5XXXXXXXX.");
          return false;
        }
      }

      if (step === 2) {
        if (!waqfType) {
          showMessage("err", "اختر مجال التبرع أولاً.");
          return false;
        }
        if (!targetAmount) {
          showMessage("err", "اختر القيمة المستهدفة للحملة.");
          return false;
        }
      }
      return true;
    }

    function updateReview() {
      const name = document.getElementById("name").value.trim();
      const ownerPhone = document.getElementById("ownerPhone").value.trim();
      const targetLabel = targetSelect.options[targetSelect.selectedIndex]?.textContent || "-";
      const typeLabel = waqfTypeEl.options[waqfTypeEl.selectedIndex]?.textContent || "-";
      document.getElementById("reviewName").textContent = name || "-";
      document.getElementById("reviewType").textContent = typeLabel || "-";
      document.getElementById("reviewTarget").textContent = targetLabel || "-";
      document.getElementById("reviewPhone").textContent = ownerPhone || "غير مضاف";
      document.getElementById("reviewVisibility").textContent =
        document.getElementById("fundType").checked ? "يظهر ضمن الأكثر تفاعلاً" : "ظهور عادي";
    }

    waqfTypeEl.addEventListener("change", () => {
      renderTargetsByType(waqfTypeEl.value);
    });

    document.getElementById("nextStep1").addEventListener("click", () => {
      if (!validateStep(1)) return;
      setStep(2);
    });
    document.getElementById("prevStep2").addEventListener("click", () => setStep(1));
    document.getElementById("nextStep2").addEventListener("click", () => {
      if (!validateStep(2)) return;
      updateReview();
      setStep(3);
    });
    document.getElementById("prevStep3").addEventListener("click", () => setStep(2));

    form.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      if (e.target.tagName === "TEXTAREA") return;
      if (currentStep === 1) {
        e.preventDefault();
        document.getElementById("nextStep1").click();
      } else if (currentStep === 2) {
        e.preventDefault();
        document.getElementById("nextStep2").click();
      }
    });

    renderTargetsByType("");
    setStep(1);

    form.onsubmit = async (e) => {
      e.preventDefault();
      if (!validateStep(1) || !validateStep(2)) return;
      clearMessage();
      btn.disabled = true;
      btn.textContent = "جاري الإرسال...";
      const waqfType = waqfTypeEl.value;
      const body = {
        name: document.getElementById("name").value.trim(),
        targetAmount: targetSelect.value,
        waqfType: waqfType == "1" ? "45" : waqfType == "2" ? "3" : "22",
        acceptAfterTarget: document.getElementById("fundType").checked,
        ownerPhone: document.getElementById("ownerPhone").value.trim(),
      };

      const r = await fetch("/api/platform/create-fund", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const rd = await r.json();
      btn.disabled = false;
      btn.textContent = "إنشاء الصندوق";
      // console.log("Create fund response:", rd);

      if (!r.ok) {
        showMessage("err", rd.error || "حدث خطأ، حاول مرة أخرى");
        return;
      }
      showMessage("ok", "تم إنشاء الصندوق بنجاح ✓");
      showFundSuccess(rd.fund, body.ownerPhone);
      form.reset();
      renderTargetsByType("");
      setStep(1);
    };

    // ===== POP UP: عرض معلومات الصندوق بعد الإنشاء =====
    const overlay = document.getElementById("fundSuccessOverlay");
    document.getElementById("fundSuccessClose").onclick = () =>
      overlay.classList.remove("show");
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) overlay.classList.remove("show");
    });
    function normalizeSaPhone(p) {
      const digits = String(p || "").replace(/\D/g, "");
      if (!digits) return "";
      if (digits.startsWith("966")) return digits;
      if (digits.startsWith("05")) return "966" + digits.slice(1);
      if (digits.startsWith("5") && digits.length === 9) return "966" + digits;
      return digits;
    }

    function showFundSuccess(fund, ownerPhoneRaw) {
      const link =
        fund.shareUrl ||
        location.origin + "/fund/" + (fund.externalId || fund.id);
      document.getElementById("fsName").textContent = fund.name || "";
      document.getElementById("fsLink").value = link;
      document.getElementById("fsQr").src =
        "https://api.qrserver.com/v1/create-qr-code/?size=240x240&margin=4&data=" +
        encodeURIComponent(link);
      const text =
        `صندوق : ${fund.name || "-"}\n` +
        `نسبة الاكتمال : ${0}%\n` +
        `رابط الصندوق: https://donate.utq.org.sa/goal_${fund.externalId || fund.id}\n\n` +
        `ساهم في إكمال صندوق الوقف\nليكون لك أجرٌ جارٍ لا ينقطع،`;

      const waBtn = document.getElementById("fsWaBtn");
      const openBtn = document.getElementById("fsOpenBtn");
      const waLabel = document.getElementById("fsWaLabel");
      const waHint = document.getElementById("fsWaHint");
      openBtn.href = link;
      const owner = normalizeSaPhone(ownerPhoneRaw);
      if (owner) {
        waBtn.href =
          "https://wa.me/" + owner + "?text=" + encodeURIComponent(text);
        waLabel.textContent = "مشاركة الصندوق";
        waHint.textContent = "سيُفتح واتساب على رقم صاحب الصندوق";
      } else {
        waBtn.href = "https://wa.me/?text=" + encodeURIComponent(text);
        waLabel.textContent = "مشاركة عبر واتساب";
        waHint.textContent =
          "لم يتم إدخال رقم صاحب الصندوق — اختر جهة الإرسال من واتساب";
      }

      document.getElementById("fsCopyBtn").onclick = async () => {
        try {
          await navigator.clipboard.writeText(link);
          const b = document.getElementById("fsCopyBtn");
          const old = b.textContent;
          b.textContent = "تم النسخ ✓";
          setTimeout(() => (b.textContent = old), 1500);
        } catch {
          document.getElementById("fsLink").select();
        }
      };

      overlay.classList.add("show");
    }

    App.showContent();
  })();
</script>

<%- include('../partials/foot') %>
