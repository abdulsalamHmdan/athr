<%- include('../partials/head') %>
<%- include('../partials/nav-ambassador') %>

<%- include('../partials/loader', { loaderType: 'table' }) %>

<div data-content style="display:none;">
  <div class="page-intro">
    <span class="page-kicker">صرف الجوائز</span>
    <h3 class="page-title">اختر الفئة المناسبة لرصيدك</h3>
    <p class="page-subtitle">عند إرسال الطلب يتم خصم قيمة الجائزة من الرصيد المتاح، وتظهر حالة الطلب حتى الاعتماد.</p>
  </div>

  <div class="card">
    <div class="section-head">
      <h2>الرصيد والاستحقاق</h2>
    </div>
    <div class="stat-grid">
      <div class="stat"><div class="v" id="s_balance">0</div><div class="l">رصيدك المتاح (نقاط)</div></div>
      <div class="stat"><div class="v" id="s_paid">0</div><div class="l">تم صرفها (نقاط)</div></div>
    </div>

    <div class="tier-grid" id="tierGrid"></div>
    <div class="msg" id="msg"></div>
  </div>

  <div class="card">
    <div class="section-head">
      <h2>سجل طلباتي</h2>
      <p class="small">آخر حالة لكل طلب صرف</p>
    </div>
    <div class="table-wrap has-cards">
      <table class="table-cards">
        <thead><tr><th>التاريخ</th><th>الجائزة</th><th>النقاط</th><th>الحالة</th><th>ملاحظة</th></tr></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
const statusMap = { pending: 'قيد المراجعة', approved: 'مقبولة', rejected: 'مرفوضة', paid: 'تم الصرف' };
const tierNameByAmount = { 2000: 'برونزية', 5000: 'فضية', 10000: 'ذهبية' };
const esc = (v) => String(v == null ? '' : v)
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;');

function renderTiers(tiers) {
  const grid = document.getElementById('tierGrid');
  const nf = App.formatNumber;
  grid.innerHTML = tiers.map((t) => `
    <div class="tier ${t.id} ${t.canClaim ? '' : 'locked'}">
      <div class="tier-name">${t.name}</div>
      <div class="tier-amount">${nf(t.amount)} <span>نقطة</span></div>
      <button class="btn block ok" data-tier="${t.id}" ${t.canClaim ? '' : 'disabled'}>
        ${t.canClaim ? 'طلب الصرف' : 'الرصيد غير كافٍ'}
      </button>
    </div>
  `).join('');
}

async function load() {
  const nf = App.formatNumber;
  const df = App.formatDate;
  const me = await fetch('/ambassador/me');
  if (me.status === 401) { location.href = '/login'; return; }
  const d = await me.json();
  document.getElementById('s_balance').textContent = nf(d.stats.availableBalance);
  document.getElementById('s_paid').textContent = nf(d.stats.paid);
  renderTiers(d.stats.tiers || []);

  const rr = await fetch('/ambassador/requests');
  const rd = await rr.json();
  const tb = document.getElementById('tbody');
  tb.innerHTML = '';
  if (!rd.requests.length) {
    tb.innerHTML = '<tr><td colspan="5" class="table-empty">لا توجد طلبات بعد</td></tr>';
  } else {
    for (const r of rd.requests) {
      const tierName = tierNameByAmount[r.amount] || '-';
      const note = r.note || '-';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td data-label="التاريخ"><span class="table-value is-number">${esc(df(r.createdAt))}</span></td>
        <td data-label="الجائزة"><span class="table-value is-ellipsis">${esc(tierName)}</span></td>
        <td data-label="النقاط"><span class="table-value is-number">${nf(r.amount)} نقطة</span></td>
        <td data-label="الحالة"><span class="table-value is-badge"><span class="badge ${r.status}">${statusMap[r.status]}</span></span></td>
        <td data-label="ملاحظة"><span class="table-value">${esc(note)}</span></td>`;
      tb.appendChild(tr);
    }
  }
  App.showContent();
}

document.getElementById('tierGrid').addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-tier]');
  if (!btn || btn.disabled) return;
  const tier = btn.dataset.tier;
  const original = btn.textContent;
  btn.disabled = true; btn.textContent = 'جاري الإرسال...';
  const r = await fetch('/ambassador/requests', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ tier }),
  });
  const d = await r.json();
  btn.disabled = false; btn.textContent = original;
  if (!r.ok) {
    await App.notify({
      title: 'تعذر إرسال الطلب',
      message: d.error || 'تعذر إرسال الطلب.',
      type: 'error',
      confirmText: 'إغلاق',
    });
    return;
  }
  await App.notify({
    title: 'تم الإرسال',
    message: 'تم إرسال طلب الصرف بنجاح',
    type: 'success',
    confirmText: 'ممتاز',
  });
  load();
});

load();
</script>

<%- include('../partials/foot') %>
