<%- include('../partials/head') %>
<%- include('../partials/nav-admin') %>

<div class="page-intro">
  <span class="page-kicker">متجر الجوائز</span>
  <h3 class="page-title">إدارة جوائز المتجر</h3>
  <p class="page-subtitle">الكتالوج محفوظ في قاعدة البيانات — أضف جوائز جديدة، عدّل المخزون، أو أخفِ جائزة مؤقتاً، وتظهر التغييرات فوراً في الموقع والتطبيق.</p>
</div>

<div class="card">
  <div class="section-head">
    <h2>قائمة الجوائز</h2>
    <button class="btn ok sm" id="addPrizeBtn" type="button">+ إضافة جائزة</button>
  </div>

  <div class="stat-grid" style="margin-bottom:10px;">
    <div class="stat"><div class="v" id="s_total">0</div><div class="l">إجمالي الجوائز</div></div>
    <div class="stat"><div class="v" id="s_active">0</div><div class="l">ظاهرة في المتجر</div></div>
    <div class="stat"><div class="v" id="s_out">0</div><div class="l">نفد مخزونها</div></div>
    <div class="stat"><div class="v" id="s_distributed">0</div><div class="l">طلبات موزّعة</div></div>
  </div>

  <div class="toolbar">
    <div class="search">
      <input type="search" id="prize_search" placeholder="ابحث باسم الجائزة أو المعرف…" autocomplete="off">
    </div>
    <div class="filters" id="tierFilters">
      <a href="#" class="filter active" data-tier="all">الكل</a>
      <a href="#" class="filter" data-tier="bronze">برونزية</a>
      <a href="#" class="filter" data-tier="silver">فضية</a>
      <a href="#" class="filter" data-tier="gold">ذهبية</a>
      <a href="#" class="filter" data-tier="diamond">ماسية</a>
    </div>
  </div>

  <%- include('../partials/loader', { loaderType: 'table' }) %>

  <div class="table-wrap has-cards" data-content style="display:none;">
    <table class="table-cards">
      <thead><tr>
        <th>الجائزة</th>
        <th>المعرف</th>
        <th>التصنيف</th>
        <th>المخزون</th>
        <th>موزّع</th>
        <th>متبقٍ</th>
        <th>الحالة</th>
        <th>إجراءات</th>
      </tr></thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>
</div>

<!-- Modal: إضافة / تعديل جائزة -->
<div class="bp-modal" id="prizeModal" hidden>
  <div class="bp-modal-backdrop" data-bp-close></div>
  <div class="bp-modal-card bp-modal-card-lg" role="dialog" aria-modal="true" aria-labelledby="prizeModalTitle">
    <button type="button" class="bp-modal-close" data-bp-close aria-label="إغلاق">×</button>
    <h3 id="prizeModalTitle">إضافة جائزة</h3>

    <label for="pz_name" class="small">اسم الجائزة <span style="color:#dc2626">*</span></label>
    <input id="pz_name" type="text" placeholder="مثال: سماعات لاسلكية" maxlength="200">

    <label for="pz_desc" class="small">الوصف</label>
    <textarea id="pz_desc" rows="3" placeholder="وصف مختصر يظهر للسفير في المتجر" maxlength="1000"></textarea>

    <div class="pz-grid">
      <div>
        <label for="pz_tier" class="small">التصنيف <span style="color:#dc2626">*</span></label>
        <select id="pz_tier">
          <option value="bronze">برونزية — 1,000</option>
          <option value="silver">فضية — 3,000</option>
          <option value="gold">ذهبية — 5,000</option>
          <option value="diamond">ماسية — 10,000</option>
        </select>
      </div>
      <div>
        <label for="pz_stock" class="small">المخزون</label>
        <input id="pz_stock" type="number" min="0" step="1" value="10">
      </div>
    </div>

    <label for="pz_image" class="small">رابط الصورة</label>
    <input id="pz_image" type="text" placeholder="مثال: /img/prizes/b1.png أو رابط خارجي" maxlength="500">
    <p class="small" style="margin:2px 0 0;color:#9ca3af;">ارفع الصورة إلى مجلد <bdo dir="ltr">public/img/prizes</bdo> ثم اكتب مسارها هنا، أو ضع رابطاً خارجياً مباشراً.</p>

    <label class="pz-check">
      <input id="pz_active" type="checkbox" checked>
      <span>ظاهرة في المتجر</span>
    </label>

    <div class="bp-modal-actions">
      <button type="button" class="btn secondary" data-bp-close>إلغاء</button>
      <button type="button" class="btn ok" id="pz_save_btn">حفظ</button>
    </div>
    <div class="msg" id="pz_msg"></div>
  </div>
</div>

<style>
  .bp-modal {
    position: fixed; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 9000; padding: 16px;
  }
  .bp-modal[hidden] { display: none; }
  .bp-modal-backdrop {
    position: absolute; inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(2px);
  }
  .bp-modal-card {
    position: relative;
    background: #fff;
    border-radius: 18px;
    padding: 22px 18px 18px;
    width: 100%;
    max-width: 460px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 90vh;
    overflow-y: auto;
  }
  .bp-modal-card-lg { max-width: 560px; }
  .bp-modal-close {
    position: absolute; top: 8px; inset-inline-end: 10px;
    background: transparent; border: 0;
    font-size: 24px; cursor: pointer; color: #6b7280;
  }
  .bp-modal-card h3 { margin: 0; font-size: 18px; color: #1f2937; }
  .bp-modal-card input, .bp-modal-card textarea, .bp-modal-card select {
    width: 100%; padding: 10px 12px;
    border-radius: 10px; border: 1px solid #e5e7eb;
    background: #f9fafb; font-size: 14px; font-family: inherit;
    box-sizing: border-box;
  }
  .bp-modal-card textarea { resize: vertical; }
  .bp-modal-actions {
    display: flex; gap: 8px;
    justify-content: flex-end; margin-top: 6px;
  }
  .pz-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pz-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: #374151; }
  .pz-check input { width: auto; }
  .pz-thumb {
    width: 44px; height: 44px; border-radius: 10px;
    object-fit: cover; background: #f1f5f9;
    border: 1px solid #e5e7eb; flex-shrink: 0;
  }
  .pz-thumb-fallback {
    width: 44px; height: 44px; border-radius: 10px;
    background: #f1f5f9; border: 1px solid #e5e7eb;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
  }
  .pz-name-cell { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .pz-name-cell .nm { font-weight: 700; font-size: 13.5px; color: #1f2937; }
  .pz-tier-badge {
    display: inline-block; padding: 2px 10px; border-radius: 999px;
    font-size: 11.5px; font-weight: 700; color: #fff;
  }
  .pz-tier-badge.bronze { background: linear-gradient(135deg, #e09a5b, #b87333); }
  .pz-tier-badge.silver { background: linear-gradient(135deg, #d6dadd, #9aa1a8); color: #3a3f45; }
  .pz-tier-badge.gold { background: linear-gradient(135deg, #f5d166, #d4a017); color: #5a4400; }
  .pz-tier-badge.diamond { background: linear-gradient(135deg, #7cc3e8, #3e96c8); }
  .pz-state-badge {
    display: inline-block; padding: 2px 10px; border-radius: 999px;
    font-size: 11.5px; font-weight: 700;
  }
  .pz-state-badge.on { background: #dcfce7; color: #166534; }
  .pz-state-badge.off { background: #f1f5f9; color: #64748b; }
  .pz-remaining.zero { color: #dc2626; font-weight: 700; }
</style>

<script src="/js/app.js"></script>
<script>
let prizes = [];
let currentTier = 'all';
let editingId = null; // null = إضافة جديدة

const esc = (v) => String(v == null ? '' : v)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

const TIER_LABEL = { bronze: 'برونزية', silver: 'فضية', gold: 'ذهبية', diamond: 'ماسية' };
const TIER_ORDER = { bronze: 0, silver: 1, gold: 2, diamond: 3 };

function filteredPrizes() {
  const q = document.getElementById('prize_search').value.trim().toLowerCase();
  return prizes.filter((p) => {
    if (currentTier !== 'all' && p.tier !== currentTier) return false;
    if (!q) return true;
    return (p.name || '').toLowerCase().includes(q) || (p.key || '').toLowerCase().includes(q);
  });
}

function renderSummary() {
  const nf = App.formatNumber;
  let active = 0, out = 0, dist = 0;
  for (const p of prizes) {
    if (p.active) active++;
    if (Math.max(0, (p.stock || 0) - (p.distributed || 0)) === 0) out++;
    dist += p.distributed || 0;
  }
  document.getElementById('s_total').textContent = nf(prizes.length);
  document.getElementById('s_active').textContent = nf(active);
  document.getElementById('s_out').textContent = nf(out);
  document.getElementById('s_distributed').textContent = nf(dist);
}

function renderList() {
  const nf = App.formatNumber;
  const tb = document.getElementById('tbody');
  const list = filteredPrizes();
  tb.innerHTML = '';
  if (!list.length) {
    tb.innerHTML = '<tr><td colspan="8" class="table-empty">لا توجد جوائز ضمن هذا التصنيف</td></tr>';
    return;
  }
  for (const p of list) {
    const remaining = Math.max(0, (p.stock || 0) - (p.distributed || 0));
    const img = p.image
      ? `<img class="pz-thumb" src="${esc(p.image)}" alt="" loading="lazy" onerror="this.outerHTML='<span class=&quot;pz-thumb-fallback&quot;>🎁</span>'">`
      : '<span class="pz-thumb-fallback">🎁</span>';
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td data-label="الجائزة">
        <div class="pz-name-cell">${img}<span class="nm">${esc(p.name)}</span></div>
      </td>
      <td data-label="المعرف"><span class="table-value is-number">${esc(p.key)}</span></td>
      <td data-label="التصنيف"><span class="pz-tier-badge ${esc(p.tier)}">${TIER_LABEL[p.tier] || esc(p.tier)}</span></td>
      <td data-label="المخزون"><span class="table-value is-number">${nf(p.stock || 0)}</span></td>
      <td data-label="موزّع"><span class="table-value is-number">${nf(p.distributed || 0)}</span></td>
      <td data-label="متبقٍ"><span class="table-value is-number pz-remaining ${remaining === 0 ? 'zero' : ''}">${nf(remaining)}</span></td>
      <td data-label="الحالة"><span class="pz-state-badge ${p.active ? 'on' : 'off'}">${p.active ? 'ظاهرة' : 'مخفية'}</span></td>
      <td data-label="إجراءات">
        <div class="row-actions" style="display:flex;gap:6px;flex-wrap:wrap;">
          <button class="btn sm bordered" type="button" data-act="edit" data-id="${esc(p._id)}">تعديل</button>
          <button class="btn sm ${p.active ? 'secondary' : 'ok'}" type="button" data-act="toggle" data-id="${esc(p._id)}">${p.active ? 'إخفاء' : 'إظهار'}</button>
          <button class="btn sm err" type="button" data-act="delete" data-id="${esc(p._id)}">حذف</button>
        </div>
      </td>`;
    tb.appendChild(tr);
  }
}

async function load() {
  App.showLoader();
  const r = await fetch('/admin/prizes/list');
  if (r.status === 401) { location.href = '/admin/login'; return; }
  const d = await r.json();
  prizes = (d.prizes || []).sort(
    (a, b) => (TIER_ORDER[a.tier] ?? 9) - (TIER_ORDER[b.tier] ?? 9) || (a.order || 0) - (b.order || 0)
  );
  renderSummary();
  renderList();
  App.showContent();
}

// ===== النافذة =====
const modal = document.getElementById('prizeModal');

function openModal(prize) {
  editingId = prize ? prize._id : null;
  document.getElementById('prizeModalTitle').textContent = prize ? `تعديل: ${prize.name}` : 'إضافة جائزة';
  document.getElementById('pz_name').value = prize ? prize.name : '';
  document.getElementById('pz_desc').value = prize ? prize.description : '';
  document.getElementById('pz_tier').value = prize ? prize.tier : 'bronze';
  document.getElementById('pz_stock').value = prize ? prize.stock : 10;
  document.getElementById('pz_image').value = prize ? prize.image : '';
  document.getElementById('pz_active').checked = prize ? !!prize.active : true;
  document.getElementById('pz_msg').textContent = '';
  modal.hidden = false;
  document.getElementById('pz_name').focus();
}

function closeModal() { modal.hidden = true; editingId = null; }

modal.addEventListener('click', (e) => {
  if (e.target.closest('[data-bp-close]')) closeModal();
});

document.getElementById('addPrizeBtn').addEventListener('click', () => openModal(null));

document.getElementById('pz_save_btn').addEventListener('click', async () => {
  const msg = document.getElementById('pz_msg');
  const body = {
    name: document.getElementById('pz_name').value.trim(),
    description: document.getElementById('pz_desc').value.trim(),
    tier: document.getElementById('pz_tier').value,
    stock: Number(document.getElementById('pz_stock').value) || 0,
    image: document.getElementById('pz_image').value.trim(),
    active: document.getElementById('pz_active').checked,
  };
  if (!body.name) { msg.textContent = 'اسم الجائزة مطلوب'; return; }
  msg.textContent = 'جارٍ الحفظ…';
  try {
    const url = editingId ? `/admin/prizes/${editingId}` : '/admin/prizes';
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const d = await r.json();
    if (!r.ok) { msg.textContent = d.error || 'تعذر الحفظ'; return; }
    closeModal();
    await load();
  } catch {
    msg.textContent = 'تعذر الاتصال بالخادم';
  }
});

// ===== إجراءات الصفوف =====
document.getElementById('tbody').addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-act]');
  if (!btn) return;
  const prize = prizes.find((p) => p._id === btn.dataset.id);
  if (!prize) return;

  if (btn.dataset.act === 'edit') {
    openModal(prize);
    return;
  }

  if (btn.dataset.act === 'toggle') {
    btn.disabled = true;
    await fetch(`/admin/prizes/${prize._id}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...prize, active: !prize.active }),
    }).catch(() => {});
    await load();
    return;
  }

  if (btn.dataset.act === 'delete') {
    const sure = confirm(`حذف جائزة «${prize.name}» نهائياً؟\nالطلبات السابقة عليها لن تتأثر.`);
    if (!sure) return;
    btn.disabled = true;
    const r = await fetch(`/admin/prizes/${prize._id}`, { method: 'DELETE' }).catch(() => null);
    if (r && !r.ok) {
      const d = await r.json().catch(() => ({}));
      alert(d.error || 'تعذر الحذف');
    }
    await load();
  }
});

// ===== الفلاتر والبحث =====
document.getElementById('tierFilters').addEventListener('click', (e) => {
  const link = e.target.closest('.filter[data-tier]');
  if (!link) return;
  e.preventDefault();
  document.querySelectorAll('#tierFilters .filter').forEach((f) => f.classList.remove('active'));
  link.classList.add('active');
  currentTier = link.dataset.tier;
  renderList();
});

document.getElementById('prize_search').addEventListener('input', renderList);

load().catch(() => {
  App.showContent();
  document.getElementById('tbody').innerHTML =
    '<tr><td colspan="8" class="table-empty">تعذر تحميل الجوائز</td></tr>';
});
</script>

<%- include('../partials/foot') %>
