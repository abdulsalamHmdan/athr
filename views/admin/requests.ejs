<%- include('../partials/head') %>
<%- include('../partials/nav-admin') %>

<div class="card">
  <div class="page-intro" style="margin-bottom:12px;">
    <span class="page-kicker">طلبات الجوائز</span>
    <h3 class="page-title">إدارة حالات الصرف ومتابعة التنفيذ</h3>
    <p class="page-subtitle">فلتر الطلبات حسب الحالة، وراجع إجراءات القبول/الرفض أو تأكيد الصرف.</p>
  </div>

  <div class="section-head">
    <h2>طلبات صرف الجوائز</h2>
    <span class="list-count-badge" id="req_count">0</span>
  </div>

  <div class="stat-grid" style="margin-bottom:10px;">
    <div class="stat"><div class="v" id="c_all">0</div><div class="l">الإجمالي</div></div>
    <div class="stat"><div class="v" id="c_pending">0</div><div class="l">قيد المراجعة</div></div>
    <div class="stat"><div class="v" id="c_approved">0</div><div class="l">مقبولة</div></div>
    <div class="stat"><div class="v" id="c_paid">0</div><div class="l">تم الصرف</div></div>
    <div class="stat"><div class="v" id="c_rejected">0</div><div class="l">مرفوضة</div></div>
  </div>

  <div class="filters">
    <a href="#" data-f="" class="filter active">الكل</a>
    <a href="#" data-f="pending" class="filter">قيد المراجعة</a>
    <a href="#" data-f="approved" class="filter">المقبولة</a>
    <a href="#" data-f="paid" class="filter">تم الصرف</a>
    <a href="#" data-f="rejected" class="filter">المرفوضة</a>
  </div>

  <div class="toolbar">
    <div class="search">
      <input type="search" id="req_search" placeholder="ابحث باسم السفير…" autocomplete="off">
    </div>
    <button class="btn export" id="req_export" type="button">تصدير Excel</button>
  </div>

  <%- include('../partials/loader') %>

  <div class="table-wrap has-cards" data-content style="display:none;">
    <table class="table-cards">
      <thead><tr>
        <th>التاريخ</th><th>السفير</th><th>الجوال</th><th>المبلغ</th><th>الحالة</th><th>إجراء</th>
      </tr></thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>
</div>

<script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
<script src="/js/app.js"></script>
<script>
const statusMap = {
  pending: 'قيد المراجعة',
  approved: 'مقبولة',
  rejected: 'مرفوضة',
  paid: 'تم الصرف',
};
let currentFilter = '';
let allRequests = [];
let approvedByAmb = {};

function buildWhatsappLink(phone, name, count) {
  const cleanPhone = String(phone || '').replace(/\D/g, '');
  const intl = cleanPhone.startsWith('966') ? cleanPhone : '966' + cleanPhone;
  const text = `مرحبا ${name}، لديك ${count} ${count === 1 ? 'جائزة' : count === 2 ? 'جائزتان' : 'جوائز'} بانتظار الشحن، يُرجى إرسال موقع الشحن.`;
  return `https://wa.me/${intl}?text=${encodeURIComponent(text)}`;
}

function filterRequests() {
  const q = document.getElementById('req_search').value.trim().toLowerCase();
  const byStatus = currentFilter ? allRequests.filter(r => r.status === currentFilter) : allRequests;
  if (!q) return byStatus;
  return byStatus.filter(r => (r.ambassador?.name || '').toLowerCase().includes(q));
}

function renderCounters() {
  const nf = App.formatNumber;
  const counts = { all: allRequests.length, pending: 0, approved: 0, paid: 0, rejected: 0 };
  allRequests.forEach((r) => {
    if (counts[r.status] != null) counts[r.status] += 1;
  });
  document.getElementById('c_all').textContent = nf(counts.all);
  document.getElementById('c_pending').textContent = nf(counts.pending);
  document.getElementById('c_approved').textContent = nf(counts.approved);
  document.getElementById('c_paid').textContent = nf(counts.paid);
  document.getElementById('c_rejected').textContent = nf(counts.rejected);
}

function renderRequests(list) {
  const nf = App.formatNumber;
  const df = App.formatDate;
  const tb = document.getElementById('tbody');
  tb.innerHTML = '';
  if (!list.length) {
    tb.innerHTML = '<tr><td colspan="6" class="center small">لا يوجد طلبات</td></tr>';
    return;
  }
  for (const r of list) {
    const tr = document.createElement('tr');
    let actions = '-';
    if (r.status === 'pending') {
      actions = `<div class="row-actions">
        <button class="btn ok sm" data-id="${r._id}" data-a="approve">قبول</button>
        <button class="btn err sm" data-id="${r._id}" data-a="reject">رفض</button>
      </div>`;
    } else if (r.status === 'approved') {
      const ambId = r.ambassador?._id;
      const waitingCount = ambId ? (approvedByAmb[ambId] || 1) : 1;
      const waLink = buildWhatsappLink(r.ambassador?.phone, r.ambassador?.name || 'السفير', waitingCount);
      actions = `<div class="row-actions">
        <button class="btn ok sm" data-id="${r._id}" data-a="paid">تأكيد الصرف</button>
        <a class="btn secondary sm" href="${waLink}" target="_blank" rel="noopener">
          <span>واتساب</span>
        </a>
      </div>`;
    }
    tr.innerHTML = `
      <td data-label="التاريخ">${df(r.createdAt)}</td>
      <td data-label="السفير">${r.ambassador?.name || '-'}</td>
      <td data-label="الجوال">${r.ambassador?.phone || '-'}</td>
      <td data-label="المبلغ">${nf(r.amount)} ريال</td>
      <td data-label="الحالة"><span class="badge ${r.status}">${statusMap[r.status]}</span></td>
      <td data-label="إجراء">${actions}</td>`;
    tb.appendChild(tr);
  }
}

async function load() {
  App.showLoader();
  const r = await fetch('/admin/requests-api');
  if (r.status === 401) { location.href = '/admin/login'; return; }
  const d = await r.json();

  approvedByAmb = {};
  allRequests = d.requests || [];
  for (const req of allRequests) {
    if (req.status !== 'approved') continue;
    const id = req.ambassador?._id;
    if (!id) continue;
    approvedByAmb[id] = (approvedByAmb[id] || 0) + 1;
  }

  renderCounters();
  document.getElementById('req_count').textContent = App.formatNumber(filterRequests().length);
  renderRequests(filterRequests());
  App.showContent();
}

function exportRequests() {
  const df = App.formatDate;
  const list = filterRequests();
  if (!list.length) { alert('لا توجد بيانات للتصدير'); return; }
  const rows = list.map((r) => ({
    'التاريخ': df(r.createdAt),
    'السفير': r.ambassador?.name || '-',
    'الجوال': r.ambassador?.phone || '-',
    'المبلغ (ريال)': r.amount,
    'الحالة': statusMap[r.status] || r.status,
    'ملاحظة': r.note || '',
  }));
  const ws = XLSX.utils.json_to_sheet(rows);
  if (!ws['!views']) ws['!views'] = [{}];
  ws['!views'][0].RTL = true;
  const wb = XLSX.utils.book_new();
  const sheetName = currentFilter ? (statusMap[currentFilter] || 'الطلبات') : 'الطلبات';
  XLSX.utils.book_append_sheet(wb, ws, sheetName);
  const today = new Date().toISOString().slice(0, 10);
  XLSX.writeFile(wb, `prize-requests-${currentFilter || 'all'}-${today}.xlsx`);
}

document.addEventListener('click', async (e) => {
  const f = e.target.closest('.filter');
  if (f) {
    e.preventDefault();
    document.querySelectorAll('.filter').forEach(x => x.classList.remove('active'));
    f.classList.add('active');
    currentFilter = f.dataset.f;
    document.getElementById('req_count').textContent = App.formatNumber(filterRequests().length);
    renderRequests(filterRequests());
    return;
  }
  const btn = e.target.closest('button[data-a]');
  if (btn) {
    const action = btn.dataset.a;
    const confirmMsg = action === 'paid' ? 'تأكيد أن الجائزة تم صرفها؟' : null;
    if (confirmMsg && !confirm(confirmMsg)) return;
    const note = action === 'paid' ? '' : (prompt('ملاحظة (اختياري)') || '');
    btn.disabled = true;
    await fetch(`/admin/requests/${btn.dataset.id}/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ note }),
    });
    load();
  }
});

document.getElementById('req_search').addEventListener('input', () => {
  document.getElementById('req_count').textContent = App.formatNumber(filterRequests().length);
  renderRequests(filterRequests());
});
document.getElementById('req_export').addEventListener('click', exportRequests);

load();
</script>

<%- include('../partials/foot') %>
