<%- include('../partials/head') %>
<%- include('../partials/nav-admin', { active: 'athar' }) %>
<link rel="stylesheet" href="/css/athar-admin.css">
<main id="athar-admin" data-csrf="<%= csrf %>">
  <header class="athar-heading"><div><p class="eyebrow">نقاط الأثر / تشغيل التطبيق</p><h1>إدارة تطبيق أثر</h1><p>حساب واحد ورصيد موحّد، من المشاركة إلى المكافأة.</p></div><span id="app-state" class="athar-badge">جارٍ التحميل</span></header>
  <div id="athar-message" role="status" aria-live="polite"></div>
  <nav class="athar-tabs" aria-label="أقسام إدارة أثر">
    <button data-tab="overview" class="selected">نظرة عامة</button><button data-tab="settings">الإعدادات</button><button data-tab="products">المتجر</button><button data-tab="orders">الطلبات</button><button data-tab="competitions">المسابقات</button><button data-tab="missions">المهام</button><button data-tab="boxes">الصناديق</button><button data-tab="audit">سجل الإدارة</button>
  </nav>
  <section id="panel-overview" class="athar-panel"><div id="overview-stats" class="athar-stats"></div><article class="athar-card"><h2>التجهيز قبل الإطلاق</h2><p>اضبط الخصوصية والشروط وروابط المشاركة، ثم فعّل الأقسام المطلوبة. المنتجات والأرصدة والطلبات مشتركة مع منصة نقاط الأثر.</p><ol><li>راجع المنتجات، تكلفتها بالنقاط وإجمالي المخزون.</li><li>أضف مسابقة وأسئلتها، واعتمد المحتوى قبل الجدولة.</li><li>استقبل طلبات الصناديق، وأنشئها في منصة التبرع ثم اربطها بعد المزامنة.</li><li>فعّل التطبيق بعد تجربة حساب سفير واستبدال منتج.</li></ol><p class="muted">يبدأ التطبيق بالإعدادات المعطّلة حتى اكتمال التجهيز. </p></article></section>
  <section id="panel-settings" class="athar-panel" hidden><form id="settings-form" class="athar-card"><h2>إعدادات التشغيل</h2><div class="athar-toggles" id="feature-toggles"></div><div class="athar-grid">
    <label>رسالة التوقف المؤقت<input name="maintenanceMessage" required maxlength="500"></label>
    <label>رابط التبرع العام<input name="generalShareURL" type="url" dir="ltr" required><small>رابط عام آمن، وليس رابط الدخول الخاص بالسفير.</small></label>
    <label>رابط الدعم<input name="supportURL" type="url" dir="ltr" required></label><label>سياسة الخصوصية<input name="privacyURL" type="url" dir="ltr"></label><label>الشروط والأحكام<input name="termsURL" type="url" dir="ltr"></label>
    <label>هدف الأثر الجماعي<input name="seasonTarget" type="number" min="1" required></label><label>حد إنشاء الصناديق خلال 24 ساعة<input name="maxBoxesPerDay" type="number" min="1" max="20" required></label>
  </div><button type="submit" class="primary">حفظ الإعدادات</button></form></section>
  <section id="panel-products" class="athar-panel" hidden><div class="athar-split"><form id="product-form" class="athar-card"><h2>إضافة أو تعديل منتج</h2><label>المعرف<input name="key" required pattern="[A-Za-z0-9_-]+" dir="ltr"></label><label>اسم المنتج<input name="name" required></label><label>الوصف<textarea name="description"></textarea></label><div class="athar-grid"><label>الفئة<select name="tier"><option value="bronze">برونزية</option><option value="silver">فضية</option><option value="gold">ذهبية</option><option value="diamond">ماسية</option></select></label><label>التكلفة بالنقاط<input name="pointCost" type="number" min="1" value="1000" required></label><label>إجمالي المخزون<input name="stock" type="number" min="0" value="0" required><small>يشمل المحجوز والمسلّم؛ المتاح يُحسب تلقائيًا.</small></label></div><label class="check"><input name="active" type="checkbox" checked>ظاهر في المتجر</label><label class="check"><input name="requiresShipping" type="checkbox" checked>يتطلب عنوان توصيل</label><button type="submit" class="primary">حفظ المنتج</button><button type="reset">منتج جديد</button></form><div id="product-list" class="athar-list"></div></div></section>
  <section id="panel-orders" class="athar-panel" hidden><article class="athar-card"><h2>طلبات الاستبدال</h2><p class="muted">النقاط والمخزون محجوزان من لحظة الطلب. الرفض يعيدهما تلقائيًا. لا يعاد فتح طلب مرفوض أو مسلّم.</p><div id="order-list"></div></article></section>
  <section id="panel-competitions" class="athar-panel" hidden><div class="athar-split"><form id="competition-form" class="athar-card"><h2>تجهيز مسابقة</h2><input type="hidden" name="id"><label>عنوان المسابقة<input name="title" required></label><label>الموعد بتوقيت جهازك<input name="scheduledAt" type="datetime-local" dir="ltr" required></label><div class="athar-grid"><label>حوض النقاط<input name="rewardPool" type="number" min="0" max="100000000" value="50000" required></label><label>ثواني السؤال<input name="durationSeconds" type="number" min="5" max="120" value="12" required></label><label>ثواني الشرح<input name="revealSeconds" type="number" min="3" max="60" value="5" required></label><label>حد المشاركة للأهلية %<input name="eligibilityPercent" type="number" min="1" max="100" value="70" required></label></div><h3>بنك أسئلة المسابقة</h3><p class="muted">لا تُجدول المسابقة قبل مراجعة واعتماد جميع الأسئلة. بعد الجدولة تثبت الأسئلة والشروط.</p><div id="question-editor"></div><button type="button" id="add-question">+ إضافة سؤال</button><div class="athar-actions"><button type="submit" class="primary">حفظ المسودة</button><button type="button" id="new-competition">مسابقة جديدة</button></div></form><div><div id="competition-list" class="athar-list"></div><article id="result-preview" class="athar-card" hidden></article></div></div></section>
  <section id="panel-missions" class="athar-panel" hidden><div class="athar-split"><form id="mission-form" class="athar-card"><h2>مهمة جديدة</h2><label>العنوان<input name="title" required></label><label>وصف الشروط<textarea name="detail" required></textarea></label><label>نوع المهمة<select name="kind"><option value="shareGeneralLink">مشاركة الرابط العام</option><option value="createMemorialBox">صناديق معتمدة</option><option value="firstBoxDonation">صناديق وصلها تبرع موثوق</option><option value="weeklyImpact">مبالغ الصناديق المنشأة خلال الفترة</option><option value="playPuzzle">مراحل التدريب المكتملة إجمالًا</option></select></label><div class="athar-grid"><label>الهدف<input name="target" type="number" min="1" value="1" required></label><label>نقاط التدريب<input name="seedReward" type="number" min="0" value="20" required></label><label>نقاط المتجر<input name="rewardPointBonus" type="number" min="0" value="0" required></label><label>البداية<input name="startsAt" type="datetime-local" dir="ltr" required></label><label>النهاية<input name="endsAt" type="datetime-local" dir="ltr" required></label></div><label class="check"><input type="checkbox" name="active" checked>تفعيل المهمة</label><p class="muted">المشاركة والتدريب لا يمنحان نقاط متجر. كل مهمة تُستلم مرة واحدة؛ أنشئ مهمة جديدة لكل فترة.</p><button class="primary" type="submit">حفظ المهمة</button></form><div id="mission-list" class="athar-list"></div></div></section>
  <section id="panel-boxes" class="athar-panel" hidden><article class="athar-card"><h2>طلبات الصناديق التذكارية</h2><p class="muted">أنشئ الصندوق في منصة التبرع باسم السفير، ثم أدخل رقمه بعد مزامنة المنصة. لا يُنشر رابط قبل التحقق من ملكيته واعتماده.</p><div id="box-list"></div></article></section>
  <section id="panel-audit" class="athar-panel" hidden><article class="athar-card"><div class="athar-heading"><h2>آخر إجراءات الإدارة</h2><a href="/admin/athar/audit.csv">تصدير السجل CSV</a></div><div id="audit-list"></div></article></section>
</main>
<script src="/js/athar-admin.js" defer></script>
<%- include('../partials/foot') %>
