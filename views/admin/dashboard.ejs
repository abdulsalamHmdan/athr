async function handleDeleteAmbassador(id, name) {
  const ok = await App.confirm({
    title: 'حذف نهائي',
    message: `سيتم حذف السفير "${name}" وجميع بياناته (الصناديق، الطلبات، النشاط، الإشعارات) نهائياً ولا يمكن التراجع. هل تريد المتابعة؟`,
    type: 'warning',
    confirmText: 'حذف',
    cancelText: 'إلغاء',
  });
  if (!ok) return;
  try {
    const r = await fetch(`/admin/ambassadors/${id}`, { method: 'DELETE' });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) {
      App.notify({
        title: 'تعذّر الحذف',
        message: d.error || 'حدث خطأ أثناء الحذف',
        type: 'error',
        confirmText: 'حسناً',
      });
      return;
    }
    ambassadors = ambassadors.filter((a) => String(a._id) !== String(id));
    document.getElementById('amb_count').textContent = App.formatNumber(ambassadors.length);
    document.getElementById('s_amb').textContent = App.formatNumber(ambassadors.length);
    renderAmbassadors(filterAmbassadors());
    App.notify({
      title: 'تم الحذف',
      message: `تم حذف السفير "${name}" وجميع بياناته.`,
      type: 'success',
      confirmText: 'حسناً',
    });
  } catch (e) {
    App.notify({
      title: 'خطأ في الشبكة',
      message: 'تعذّر الاتصال بالخادم',
      type: 'error',
      confirmText: 'حسناً',
    });
  }
}

function filterAmbassadors() {
  const q = document.getElementById('amb_search').value.trim().toLowerCase();
  if (!q) return ambassadors;
  return ambassadors.filter(a => (a.name || '').toLowerCase().includes(q));
}

function exportAmbassadors() {
  const list = filterAmbassadors();
  if (!list.length) {
    App.notify({
      title: 'لا توجد بيانات',
      message: 'لا توجد بيانات للتصدير',
      type: 'warning',
      confirmText: 'حسناً',
    });
    return;
  }
  const rows = list.map((a, i) => ({
    '#': i + 1,
    'الاسم': a.name,
    'الجوال': a.phone,
    'منسوب': a.isMember ? 'نعم' : 'لا',
    'الجهة': a.entity || '-',
    'الرمز': a.referralCode,
  }));
  const ws = XLSX.utils.json_to_sheet(rows);
  if (!ws['!views']) ws['!views'] = [{}];
  ws['!views'][0].RTL = true;
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'السفراء');
  const today = new Date().toISOString().slice(0, 10);
  XLSX.writeFile(wb, `ambassadors-${today}.xlsx`);
}

function destroyCharts() {
  charts.forEach((c) => c && c.destroy && c.destroy());
  charts.length = 0;
}

function createCharts(data) {
  if (typeof Chart === 'undefined') return;
  destroyCharts();

  const styles = getComputedStyle(document.documentElement);
  const primary = styles.getPropertyValue('--primary').trim();
  const accent = styles.getPropertyValue('--accent').trim();
  const secondary = styles.getPropertyValue('--secondary').trim() || '#6366f1';
  const success = styles.getPropertyValue('--success').trim();
  const text = styles.getPropertyValue('--text').trim();
  const grid = styles.getPropertyValue('--border').trim();

  const commonOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { labels: { color: text, font: { family: 'IBM Plex Sans Arabic', size: 12 } } },
      tooltip: { bodyFont: { family: 'IBM Plex Sans Arabic' }, titleFont: { family: 'IBM Plex Sans Arabic' } },
    },
    scales: {
      x: { ticks: { color: text }, grid: { color: grid } },
      y: { ticks: { color: text }, grid: { color: grid } },
    },
  };

  const donations = Number(data.totalDonations || 0);
  const prizes = Number(data.totalPrizes || 0);
  const remaining = Math.max(0, donations - prizes);
  charts.push(
    new Chart(document.getElementById('kpiChart'), {
      type: 'bar',
      data: {
        labels: ['التبرعات', 'الجوائز', 'الصافي'],
        datasets: [
          {
            data: [donations, prizes, remaining],
            backgroundColor: [primary, accent, success],
            borderRadius: 8,
            maxBarThickness: 48,
          },
        ],
      },
      options: {
        ...commonOptions,
        plugins: { ...commonOptions.plugins, legend: { display: false } },
      },
    })
  );

  charts.push(
    new Chart(document.getElementById('membersChart'), {
      type: 'doughnut',
      data: {
        labels: ['منسوبو الجمعية', 'من خارج الجمعية'],
        datasets: [
          {
            data: [Number(data.members || 0), Number(data.nonMembers || 0)],
            backgroundColor: [secondary, primary],
            borderWidth: 0,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: commonOptions.plugins,
      },
    })
  );

  const entityCounts = {};
  (data.ambassadors || []).forEach((a) => {
    const key = (a.entity || 'غير محدد').trim() || 'غير محدد';
    entityCounts[key] = (entityCounts[key] || 0) + 1;
  });
  const ranked = Object.entries(entityCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 8);
  const entityLabels = ranked.map(([name]) => name);
  const entityValues = ranked.map(([, count]) => count);
  charts.push(
    new Chart(document.getElementById('entitiesChart'), {
      type: 'bar',
      data: {
        labels: entityLabels.length ? entityLabels : ['لا بيانات'],
        datasets: [
          {
            data: entityValues.length ? entityValues : [0],
            backgroundColor: primary,
            borderRadius: 8,
            maxBarThickness: 42,
          },
        ],
      },
      options: {
        ...commonOptions,
        indexAxis: 'y',
        plugins: { ...commonOptions.plugins, legend: { display: false } },
      },
    })
  );
}

function toArabicActionLabel(item) {
  const action = String(item?.action || '');
  const details = item?.details || {};
  if (action === 'create_fund' || action === 'create_fund_success') {
    return `أنشأ صندوقًا جديدًا${details.fundName ? `: ${details.fundName}` : ''}`;
  }
  if (action === 'switch_home_tab') return `انتقل إلى تبويب "${details.tab || '-'}"`;
  if (action === 'request_prize') return `طلب صرف جائزة${details.tier ? ` (${details.tier})` : ''}`;
  if (action === 'copy_fund_link' || action === 'copy_created_fund_link') return 'نسخ رابط صندوق';
  if (action === 'share_fund_link' || action === 'share_created_fund_link') return 'شارك رابط صندوق';
  if (action === 'open_fund_link') return 'فتح رابط صندوق';
  if (action === 'copy_fund_message') return 'نسخ رسالة نشر الصندوق';
  if (action === 'click_top_home') return 'ضغط زر الصفحة الرئيسية';
  if (action === 'open_secret_link_modal') return 'فتح نافذة الرابط السري';
  if (action === 'copy_secret_link') return 'نسخ الرابط السري';
  if (action === 'click_notifications_toggle') return 'ضغط زر الإشعارات';
  return action || 'نشاط غير معروف';
}

async function loadRecentActivities() {
  if (activityLoading) return;
  activityLoading = true;
  const body = document.getElementById('activityFeedBody');
  body.innerHTML = 'جارٍ تحميل النشاط...';
  try {
    const nf = App.formatNumber;
    const dtf = App.formatDateTime;
    const r = await fetch('/admin/activities?limit=10');
    if (r.status === 401) { location.href = '/admin/login'; return; }
    const d = await r.json();
    const list = Array.isArray(d.activities) ? d.activities : [];
    if (!list.length) {
      body.innerHTML = '<div class="small">لا يوجد نشاط مسجل حتى الآن.</div>';
      return;
    }
    body.innerHTML = list.map((item) => {
      const name = item?.ambassador?.name || 'سفير غير معروف';
      const phone = item?.ambassador?.phone || '-';
      const when = dtf(item.createdAt);
      const actionLabel = toArabicActionLabel(item);
      return `<div class="hist-row">
        <div class="hist-title">${esc(name)} <span class="small">(${esc(phone)})</span></div>
        <div class="hist-meta">${esc(when)}</div>
        <div class="hist-body">${esc(actionLabel)}</div>
        <div class="hist-meta">المصدر: ${esc(item.source || 'client')}</div>
      </div>`;
    }).join('');
    const btn = document.getElementById('activityLoadBtn');
    if (btn) btn.textContent = `تحديث (${nf(list.length)})`;
  } catch (e) {
    body.innerHTML = '<div class="small">تعذر تحميل سجل النشاط الآن.</div>';
  } finally {
    activityLoading = false;
  }
}

(async function () {
  const nf = App.formatNumber;
  const r = await fetch('/admin/stats');
  if (r.status === 401) { location.href = '/admin/login'; return; }
  const d = await r.json();
  dashboardPayload = d;
  document.getElementById('s_total').textContent = nf(d.totalDonations);
  document.getElementById('s_prizes').textContent = nf(d.totalPrizes);
  document.getElementById('s_amb').textContent = nf(d.ambassadorsCount);
  document.getElementById('s_mem').textContent = nf(d.members);
  document.getElementById('s_non').textContent = nf(d.nonMembers);
  ambassadors = d.ambassadors || [];
  document.getElementById('amb_count').textContent = nf(ambassadors.length);
  renderAmbassadors(ambassadors);
  App.showContent();
})();

document.getElementById('amb_search').addEventListener('input', () => {
  renderAmbassadors(filterAmbassadors());
});
document.getElementById('amb_export').addEventListener('click', exportAmbassadors);
document.getElementById('activityLoadBtn').addEventListener('click', loadRecentActivities);

document.getElementById('tbody').addEventListener('click', (e) => {
  const btn = e.target.closest('button[data-action]');
  if (!btn) return;
  const id = btn.dataset.id;
  const name = btn.dataset.name;
  const phone = btn.dataset.phone;
  console.log(`Button clicked: action=${btn.dataset.action}, id=${id}, name=${name}, phone=${phone}`);
  if (!id) return;
  if (btn.dataset.action === 'send-link') return handleSendLink(id, name,phone);
  if (btn.dataset.action === 'delete-amb') return handleDeleteAmbassador(id, phone);
});

document.getElementById('adminDashSegments').addEventListener('click', (e) => {
  const btn = e.target.closest('.segment-btn[data-tab]');
  if (!btn) return;
  const tab = btn.dataset.tab;
  document.querySelectorAll('#adminDashSegments .segment-btn').forEach((x) => {
    x.classList.toggle('active', x === btn);
  });
  document.querySelectorAll('.tab-pane[data-pane]').forEach((pane) => {
    pane.classList.toggle('active', pane.dataset.pane === tab);
  });
  if (tab === 'charts') {
    if (!chartsReady && dashboardPayload) {
      createCharts(dashboardPayload);
      chartsReady = true;
    }
    setTimeout(() => charts.forEach((c) => c && c.resize && c.resize()), 40);
  }
});
</script>

