// ===== التحكم بلوحة الشرف =====
(function setupBoardCtrl(){
  const statusEl = document.getElementById('bcStatus');
  const toggleBtn = document.getElementById('bcTogglePause');
  const toggleLbl = document.getElementById('bcToggleLabel');
  const reloadBtn = document.getElementById('bcForceReload');
  const metaEl = document.getElementById('bcMeta');
  if (!statusEl || !toggleBtn || !reloadBtn) return;

  function fmtDate(iso){
    if (!iso) return '—';
    try {
      const d = new Date(iso);
      return d.toLocaleString('ar', { hour12: false });
    } catch(e){ return iso; }
  }

  function applyState(s){
    if (!s || typeof s !== 'object') return;
    if (s.paused){
      statusEl.textContent = 'متوقف';
      statusEl.classList.add('is-paused');
      statusEl.classList.remove('is-live');
      toggleBtn.classList.add('is-paused');
      toggleLbl.textContent = 'استئناف التحديث التلقائي';
    } else {
      statusEl.textContent = 'يعمل';
      statusEl.classList.add('is-live');
      statusEl.classList.remove('is-paused');
      toggleBtn.classList.remove('is-paused');
      toggleLbl.textContent = 'إيقاف التحديث التلقائي';
    }
    const parts = [];
    parts.push('النسخة #' + (s.version != null ? s.version : '—'));
    if (s.versionAt)  parts.push('آخر دفع تحديث: ' + fmtDate(s.versionAt));
    if (s.paused && s.pausedAt) parts.push('تم الإيقاف في: ' + fmtDate(s.pausedAt));
    metaEl.textContent = parts.join(' • ');
  }

  function setBusy(on){
    toggleBtn.disabled = on;
    reloadBtn.disabled = on;
  }

  async function fetchState(){
    try {
      const r = await fetch('/admin/board-control', { cache: 'no-store' });
      if (!r.ok) throw new Error('failed');
      const s = await r.json();
      applyState(s);
    } catch(e){
      statusEl.textContent = 'تعذّر القراءة';
      statusEl.classList.remove('is-live', 'is-paused');
    }
  }

  async function doToggle(){
    setBusy(true);
    try {
      const r = await fetch('/admin/board-control/toggle', { method: 'POST' });
      const s = await r.json();
      applyState(s);
    } catch(e){
      alert('تعذّر تنفيذ الطلب');
    } finally {
      setBusy(false);
    }
  }

  async function doForceReload(){
    if (!confirm('فرض إعادة تحميل جميع صفحات لوحة الشرف المفتوحة الآن؟')) return;
    setBusy(true);
    try {
      const r = await fetch('/admin/board-control/force-reload', { method: 'POST' });
      const s = await r.json();
      applyState(s);
      // مؤشر بصري بسيط
      reloadBtn.textContent = '✓ تم — سيتم تحديث الصفحات خلال دقيقة';
      setTimeout(() => { reloadBtn.textContent = 'فرض إعادة تحميل جميع الصفحات المفتوحة'; }, 3000);
    } catch(e){
      alert('تعذّر تنفيذ الطلب');
    } finally {
      setBusy(false);
    }
  }

  toggleBtn.addEventListener('click', doToggle);
  reloadBtn.addEventListener('click', doForceReload);
  fetchState();
})();

