  tb.innerHTML = '';
  if (!list.length) {
    tb.innerHTML = '<tr><td colspan="7" class="table-empty">لا يوجد سفراء</td></tr>';
    return;
  }
  list.forEach((a, i) => {
    const name = a.name || '-';
    const phone = a.phone || '-';
    const entity = a.entity || '-';
    const code = a.referralCode || '-';
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td data-label="التسلسل"><span class="table-value is-number">${i + 1}</span></td>
      <td data-label="الاسم"><span class="table-value is-ellipsis">${esc(name)}</span></td>
      <td data-label="الجوال"><span class="table-value is-number">${esc(phone)}</span></td>
      <td data-label="منسوب"><span class="table-value">${a.isMember ? 'نعم' : 'لا'}</span></td>
      <td data-label="الجهة"><span class="table-value is-ellipsis">${esc(entity)}</span></td>
      <td data-label="الرمز"><span class="table-value is-number">${esc(code)}</span></td>
      <td data-label="إجراءات">
        <div class="row-actions" style="display:flex;gap:6px;flex-wrap:wrap;">
          <button class="btn sm bordered" type="button" data-action="send-link" data-id="${esc(code)}" data-name="${esc(name)}"  data-phone="${esc(phone)}">إرسال الرابط</button>
          <button class="btn err sm" type="button" data-action="delete-amb" data-id="${esc(a._id)}" data-name="${esc(name)}">حذف نهائي</button>
        </div>
      </td>`;
    tb.appendChild(tr);
  });
}

