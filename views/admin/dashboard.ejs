<%- include('../partials/head') %>
<%- include('../partials/nav-admin') %>

<%- include('../partials/loader') %>

<div data-content style="display:none;">
  <div class="page-intro">
    <span class="page-kicker">لوحة الإدارة</span>
    <h3 class="page-title">متابعة الأداء العام للسفراء</h3>
    <p class="page-subtitle">راقب المؤشرات الكلية، ثم ابحث في قائمة السفراء أو صدّر البيانات مباشرة.</p>
  </div>

  <div class="card">
    <div class="section-head">
      <h2>ملخص عام</h2>
    </div>
    <div class="stat-grid">
      <div class="stat"><div class="v" id="s_total">0</div><div class="l">مجموع التبرعات (ريال)</div></div>
      <div class="stat"><div class="v" id="s_prizes">0</div><div class="l">مجموع الجوائز المصروفة (ريال)</div></div>
      <div class="stat"><div class="v" id="s_amb">0</div><div class="l">عدد السفراء</div></div>
      <div class="stat"><div class="v" id="s_mem">0</div><div class="l">من منسوبي الجمعية</div></div>
      <div class="stat"><div class="v" id="s_non">0</div><div class="l">من خارج الجمعية</div></div>
    </div>
  </div>

  <div class="card">
    <div class="section-head">
      <h2>قائمة السفراء</h2>
      <span class="list-count-badge" id="amb_count">0</span>
    </div>
    <div class="toolbar">
      <div class="search">
        <input type="search" id="amb_search" placeholder="ابحث باسم السفير…" autocomplete="off">
      </div>
      <button class="btn export" id="amb_export" type="button">تصدير Excel</button>
    </div>
    <div class="table-wrap has-cards">
      <table class="table-cards">
        <thead><tr><th>#</th><th>الاسم</th><th>الجوال</th><th>منسوب</th><th>الجهة</th><th>الرمز</th></tr></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
<script src="/js/app.js"></script>
<script>
let ambassadors = [];

function renderAmbassadors(list) {
  const tb = document.getElementById('tbody');
  tb.innerHTML = '';
  if (!list.length) {
    tb.innerHTML = '<tr><td colspan="6" class="center small">لا يوجد سفراء</td></tr>';
    return;
  }
  list.forEach((a, i) => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td data-label="#">${i+1}</td>
      <td data-label="الاسم">${a.name}</td>
      <td data-label="الجوال">${a.phone}</td>
      <td data-label="منسوب">${a.isMember ? 'نعم' : 'لا'}</td>
      <td data-label="الجهة">${a.entity || '-'}</td>
      <td data-label="الرمز">${a.referralCode}</td>`;
    tb.appendChild(tr);
  });
}

function filterAmbassadors() {
  const q = document.getElementById('amb_search').value.trim().toLowerCase();
  if (!q) return ambassadors;
  return ambassadors.filter(a => (a.name || '').toLowerCase().includes(q));
}

function exportAmbassadors() {
  const list = filterAmbassadors();
  if (!list.length) { alert('لا توجد بيانات للتصدير'); return; }
  const rows = list.map((a, i) => ({
    '#': i + 1,
    'الاسم': a.name,
    'الجوال': a.phone,
    'منسوب': a.isMember ? 'نعم' : 'لا',
    'الجهة': a.entity || '-',
    'الرمز': a.referralCode,
  }));
  const ws = XLSX.utils.json_to_sheet(rows);
  if (!ws['!views']) ws['!views'] = [{}];
  ws['!views'][0].RTL = true;
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'السفراء');
  const today = new Date().toISOString().slice(0, 10);
  XLSX.writeFile(wb, `ambassadors-${today}.xlsx`);
}

(async function () {
  const nf = App.formatNumber;
  const r = await fetch('/admin/stats');
  if (r.status === 401) { location.href = '/admin/login'; return; }
  const d = await r.json();
  document.getElementById('s_total').textContent = nf(d.totalDonations);
  document.getElementById('s_prizes').textContent = nf(d.totalPrizes);
  document.getElementById('s_amb').textContent = nf(d.ambassadorsCount);
  document.getElementById('s_mem').textContent = nf(d.members);
  document.getElementById('s_non').textContent = nf(d.nonMembers);
  ambassadors = d.ambassadors || [];
  document.getElementById('amb_count').textContent = nf(ambassadors.length);
  renderAmbassadors(ambassadors);
  App.showContent();
})();

document.getElementById('amb_search').addEventListener('input', () => {
  renderAmbassadors(filterAmbassadors());
});
document.getElementById('amb_export').addEventListener('click', exportAmbassadors);
</script>

<%- include('../partials/foot') %>
