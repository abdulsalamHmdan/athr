<%- include('partials/head') %>

<div class="auth-shell" id="formCard">
  <aside class="auth-aside">
    <span class="page-kicker">الانضمام كسفير</span>
    <h3>ابدأ من هنا</h3>
    <p class="page-subtitle">املأ البيانات الأساسية مرة واحدة ثم تحصل على رابطك الخاص وتبدأ المشاركة مباشرة.</p>
    <ul class="auth-list">
      <li>ربط مباشر مع لوحة السفير بعد التسجيل.</li>
      <li>متابعة الجوائز والتقدم عبر واجهة مبسطة.</li>
      <li>نشر الصناديق برسائل جاهزة ومشاركة أسرع.</li>
    </ul>
  </aside>

  <div class="card card-elevated auth-form-card">
    <h2>تسجيل سفير جديد</h2>
    <form id="form">
      <div class="form-section">
        <p class="form-section-title">البيانات الأساسية</p>
        <div class="form-grid">
          <div>
            <label>الاسم</label>
            <input name="name" required />
          </div>
          <div>
            <label>رقم الجوال</label>
            <input
              name="phone"
              type="tel"
              inputmode="numeric"
              required
              pattern="[1-9][0-9]{8}"
              maxlength="9"
              minlength="9"
              placeholder="5XXXXXXXX"
              title="9 أرقام فقط، بدون صفر في البداية وبدون رمز الدولة"
            />
          </div>
        </div>
        <div class="small">
          أدخل 9 أرقام فقط، بدون الصفر في البداية وبدون رمز الدولة (مثال: 5XXXXXXXX)
        </div>
        <label>كلمة السر</label>
        <input name="password" type="password" required minlength="4" />
      </div>

      <div class="form-section">
        <p class="form-section-title">الانتماء</p>
        <label>هل أنت من منسوبي الجمعية؟</label>
        <select name="isMember" id="isMember">
          <option value="false">لا</option>
          <option value="true">نعم</option>
        </select>
        <div id="entityWrap" style="display: none">
          <label>الجهة</label>
          <select name="entity">
            <option value="330">الإدارة</option>
            <option value="227">الروضات</option>
            <option value="48">البديعة الصباحية</option>
            <option value="70">التلقين المسائية</option>
            <option value="72">جامع التميمي</option>
            <option value="71">حصة بنت عبدالله البسام</option>
            <option value="60">دار ابن عيد المسائية</option>
            <option value="57">دار البديعة المسائية</option>
            <option value="59">دار البويطن</option>
            <option value="46">دار الحركان الصباحية</option>
            <option value="51">دار الحركان المسائية</option>
            <option value="61">دار الحميضي المسائية</option>
            <option value="47">دار العضيب الصباحية</option>
            <option value="52">دار العضيب المسائية</option>
            <option value="64">دار الفهد الصباحية</option>
            <option value="67">دار الفهد المسائية</option>
            <option value="55">دار الفيحاء المسائية</option>
            <option value="68">دار حصة السليم</option>
            <option value="63">دار المقرأة الالكترونية</option>
            <option value="50">دار الملك خالد الصباحية</option>
            <option value="58">دار الملك خالد المسائية</option>
            <option value="56">دار الودي المسائية</option>
            <option value="49">دار تراتيل الصباحية</option>
            <option value="53">دار تراتيل المسائية</option>
            <option value="69">دار غراس المسائية</option>
            <option value="54">دار مشرفة المسائية</option>
            <option value="62">دار موضي الخنيني المسائية</option>
            <option value="65">دار نورة الشبل الصباحية</option>
            <option value="66">دار نورة الشبل المسائية</option>
            <option value="40">مجمع الحلق الاجتماعية</option>
            <option value="38">مجمع الحلقات الإلكترونية</option>
            <option value="36">مجمع الحلقات المنفردة</option>
            <option value="32">مجمع الزبير بن العوام</option>
            <option value="24">مجمع أبي بن كعب</option>
            <option value="23">مجمع أسامة بن زيد</option>
            <option value="28">مجمع جامع المصيريعي</option>
            <option value="35">مجمع زيد بن ثابت</option>
            <option value="31">مجمع سعد بن معاذ</option>
            <option value="26">مجمع سعيد بن زيد</option>
            <option value="34">مجمع عبدالله بن عباس</option>
            <option value="37">مجمع عبدالله بن مسعود</option>
            <option value="30">مجمع عتبة بن غزوان</option>
            <option value="33">مجمع عثمان بن عفان</option>
            <option value="27">مجمع عمر بن الخطاب</option>
            <option value="29">مجمع مصعب بن عمير</option>
          </select>
        </div>
      </div>
      <button class="btn block lg" type="submit" style="margin-top: 12px">
        إنشاء الحساب
      </button>
      <div class="msg err" id="msg"></div>
    </form>
    <p class="small center" style="margin-top: 12px">
      لديك حساب؟ <a href="/login">تسجيل الدخول</a>
    </p>
  </div>
</div>

<div class="card card-elevated" id="otpCard" style="display: none">
  <h2>تحقق من رقم الجوال</h2>
  <p class="small" id="otpHint" style="margin-bottom: 8px"></p>
  <form id="otpForm">
    <label>رمز التحقق</label>
    <input
      name="otp"
      type="tel"
      inputmode="numeric"
      required
      pattern="[0-9]{6}"
      maxlength="6"
      minlength="6"
      placeholder="123456"
    />
    <div class="small">الرمز صالح لمدة 10 دقائق.</div>
    <button class="btn block lg" type="submit" style="margin-top: 12px">
      تحقق وإنشاء الحساب
    </button>
    <button class="btn secondary block" type="button" id="resendBtn" style="margin-top: 8px">
      إعادة إرسال الرمز
    </button>
  </form>
</div>

<div class="card card-elevated" id="doneCard" style="display: none">
  <h2>تم التسجيل بنجاح</h2>
  <p id="doneMsg">هذا هو رابط تسجيل الدخول السريع، لا تشاركه مع أحد:</p>
  <div class="link-box">
    <span id="link"></span
    ><button class="btn" id="copyBtn" type="button">نسخ</button>
  </div>
  <div class="row stack" style="margin-top: 16px">
    <a class="btn block" href="/ambassador/home">الانتقال لصفحتي</a>
    <!-- <a class="btn secondary block" href="/login">تسجيل الدخول</a> -->
  </div>
</div>

<script src="/js/app.js"></script>
<script>
  const isMember = document.getElementById("isMember");
  const entityWrap = document.getElementById("entityWrap");
  isMember.addEventListener("change", () => {
    entityWrap.style.display = isMember.value === "true" ? "block" : "none";
  });

  const formCard = document.getElementById("formCard");
  const otpCard = document.getElementById("otpCard");
  const doneCard = document.getElementById("doneCard");
  const otpHint = document.getElementById("otpHint");
  const otpForm = document.getElementById("otpForm");
  const resendBtn = document.getElementById("resendBtn");

  function showDone(data) {
    formCard.style.display = "none";
    otpCard.style.display = "none";
    doneCard.style.display = "block";
    if (data.verified === false) {
      document.getElementById("doneMsg").textContent =
        (data.notice || "تم إنشاء الحساب بدون تحقق واتساب، حسابك مفعّل لكن غير متحقق منه.") +
        " هذا هو رابط تسجيل الدخول السريع، لا تشاركه مع أحد:";
    }
    document.getElementById("link").textContent = data.referralLink;
    document.getElementById("copyBtn").onclick = () => {
      navigator.clipboard.writeText(data.referralLink);
      document.getElementById("copyBtn").textContent = "تم النسخ ✓";
    };
  }

  document.getElementById("form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector("button[type=submit]");
    btn.disabled = true;
    btn.textContent = "جاري الإرسال...";
    const body = Object.fromEntries(new FormData(e.target).entries());
    body.isMember = body.isMember === "true";
    if (!/^[1-9][0-9]{8}$/.test(body.phone)) {
      btn.disabled = false;
      btn.textContent = "إنشاء الحساب";
      await App.notify({
        title: "رقم الجوال غير صحيح",
        message: "رقم الجوال يجب أن يكون 9 أرقام بدون صفر أو رمز الدولة",
        type: "error",
        confirmText: "حسناً",
      });
      return;
    }
    body.entity = body.isMember ? body.entity : "550";
    const r = await fetch("/auth/signup", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });
    const data = await r.json();
    btn.disabled = false;
    btn.textContent = "إنشاء الحساب";
    if (!r.ok) {
      await App.notify({
        title: "تعذر إنشاء الحساب",
        message: data.error || "حدث خطأ غير متوقع",
        type: "error",
        confirmText: "إغلاق",
      });
      return;
    }

    if (data.requiresOtp) {
      formCard.style.display = "none";
      otpCard.style.display = "block";
      otpHint.textContent = `تم إرسال رمز التحقق إلى الرقم 0${data.phone} عبر واتساب.`;
      otpForm.otp.focus();
      return;
    }

    showDone(data);
  });

  otpForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector("button[type=submit]");
    btn.disabled = true;
    btn.textContent = "جاري التحقق...";
    const otp = otpForm.otp.value.trim();
    if (!/^[0-9]{6}$/.test(otp)) {
      btn.disabled = false;
      btn.textContent = "تحقق وإنشاء الحساب";
      await App.notify({
        title: "رمز غير صحيح",
        message: "الرمز يجب أن يكون 6 أرقام",
        type: "error",
        confirmText: "حسناً",
      });
      return;
    }
    const r = await fetch("/auth/signup/verify-otp", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ otp }),
    });
    const data = await r.json();
    btn.disabled = false;
    btn.textContent = "تحقق وإنشاء الحساب";
    if (!r.ok) {
      await App.notify({
        title: "فشل التحقق",
        message: data.error || "حدث خطأ غير متوقع",
        type: "error",
        confirmText: "إغلاق",
      });
      return;
    }
    showDone(data);
  });

  resendBtn.addEventListener("click", async () => {
    resendBtn.disabled = true;
    resendBtn.textContent = "جاري إعادة الإرسال...";
    const r = await fetch("/auth/signup/resend-otp", { method: "POST" });
    const data = await r.json();
    resendBtn.disabled = false;
    resendBtn.textContent = "إعادة إرسال الرمز";
    if (!r.ok) {
      await App.notify({
        title: "تعذر إعادة الإرسال",
        message: data.error || "حدث خطأ غير متوقع",
        type: "error",
        confirmText: "إغلاق",
      });
      return;
    }
    if (data.fallback) {
      showDone(data);
      return;
    }
    await App.notify({
      title: "تم إعادة الإرسال",
      message: "تم إرسال رمز جديد عبر واتساب.",
      type: "success",
      confirmText: "حسناً",
    });
  });
</script>

<%- include('partials/foot') %>
