<%- include('partials/head') %>

<div class="card" id="formCard">
  <h2>تسجيل سفير جديد</h2>
  <form id="form">
    <label>الاسم</label>
    <input name="name" required>
    <label>رقم الجوال</label>
    <input name="phone" type="tel" inputmode="numeric" required pattern="[1-9][0-9]{8}" maxlength="9" minlength="9" placeholder="5XXXXXXXX" title="9 أرقام فقط، بدون صفر في البداية وبدون رمز الدولة">
    <div class="small">أدخل 9 أرقام فقط، بدون الصفر في البداية وبدون رمز الدولة (مثال: 5XXXXXXXX)</div>
    <label>كلمة السر</label>
    <input name="password" type="password" required minlength="4">
    <label>هل أنت من منسوبي الجمعية؟</label>
    <select name="isMember" id="isMember">
      <option value="false">لا</option>
      <option value="true">نعم</option>
    </select>
    <div id="entityWrap" style="display:none;">
      <label>الجهة</label>
      <select name="entity">
        <option>الإدارة العامة</option>
        <option>الحلقات النسائية</option>
        <option>الحلقات الرجالية</option>
        <option>القسم التعليمي</option>
        <option>القسم الإعلامي</option>
        <option>قسم التطوير</option>
      </select>
    </div>
    <button class="btn block" type="submit" style="margin-top:16px;">إنشاء الحساب</button>
    <div class="msg err" id="msg"></div>
  </form>
  <p class="small center" style="margin-top:14px;">لديك حساب؟ <a href="/login">تسجيل الدخول</a></p>
</div>

<div class="card" id="doneCard" style="display:none;">
  <h2>تم التسجيل بنجاح 🎉</h2>
  <p>هذا هو رابطك الخاص، شاركه لجمع التبرعات:</p>
  <div class="link-box"><span id="link"></span><button class="btn" id="copyBtn" type="button">نسخ</button></div>
  <div class="row stack" style="margin-top:16px;">
    <a class="btn block" href="/ambassador/home">الانتقال لصفحتي</a>
    <a class="btn secondary block" href="/login">تسجيل الدخول</a>
  </div>
</div>

<script>
const isMember = document.getElementById('isMember');
const entityWrap = document.getElementById('entityWrap');
isMember.addEventListener('change', () => {
  entityWrap.style.display = isMember.value === 'true' ? 'block' : 'none';
});

document.getElementById('form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = 'جاري الإرسال...';
  const body = Object.fromEntries(new FormData(e.target).entries());
  body.isMember = body.isMember === 'true';
  if (!/^[1-9][0-9]{8}$/.test(body.phone)) {
    document.getElementById('msg').textContent = 'رقم الجوال يجب أن يكون 9 أرقام بدون صفر أو رمز الدولة';
    btn.disabled = false; btn.textContent = 'إنشاء الحساب';
    return;
  }
  const r = await fetch('/auth/signup', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await r.json();
  btn.disabled = false; btn.textContent = 'إنشاء الحساب';
  if (!r.ok) { document.getElementById('msg').textContent = data.error || 'خطأ'; return; }
  document.getElementById('formCard').style.display = 'none';
  document.getElementById('doneCard').style.display = 'block';
  document.getElementById('link').textContent = data.referralLink;
  document.getElementById('copyBtn').onclick = () => {
    navigator.clipboard.writeText(data.referralLink);
    document.getElementById('copyBtn').textContent = 'تم النسخ ✓';
  };
});
</script>

<%- include('partials/foot') %>
